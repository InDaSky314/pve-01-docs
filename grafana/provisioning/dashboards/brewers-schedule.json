              "text": "Home",
              "type": "string"
            },
            {
              "selector": "status.detailedState",
              "text": "Status",
              "type": "string"
            },
            {
              "selector": "broadcasts.0.name",
              "text": "Broadcast",
              "type": "string"
            }
          ]
        }
