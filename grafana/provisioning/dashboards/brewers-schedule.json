            "uid": "mlb-statsapi"
          },
          "type": "json",
          "source": "url",
          "format": "table",
          "parser": "backend",
          "url": "https://statsapi.mlb.com/api/v1/schedule?sportId=1&teamId=158&startDate=${__from:date:YYYY-MM-DD}&endDate=${__to:date:YYYY-MM-DD}&hydrate=team,broadcasts(all)",
          "url_options": {
            "method": "GET"
          },
          "root_selector": "dates.games",
          "columns": [
            {
              "selector": "gameDate",
              "text": "First pitch",
