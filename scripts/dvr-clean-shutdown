#!/usr/bin/env python3
"""Shut the host down cleanly before the mains timer cuts power -- unless a
recording needs it to stay up.

The timer restores power at ~05:05 every day. It cuts power at ~22:25 on
Sun/Mon/Tue/Wed/Thu nights, but stays on later -- until ~01:00 the following
calendar day -- on Fri and Sat nights (confirmed against the physical timer
2026-08-08). This script itself only cares about the power-on side (for
recording-risk assessment below); the day-of-week-aware cutoff timing lives
in dvr-clean-shutdown.timer's two OnCalendar lines, not in this file.

Being cut while running is an unclean poweroff every day, so we power down
cleanly a little ahead of it. BIOS is set to "Power On" (verified 2026-07-31
by a clean shutdown followed by an unattended boot), so the box still comes
back when power returns.

On nights the timer is overridden for a game, a recording will be in progress
or due before the next power-on. In that case we do nothing and let the box
run -- the point is that overriding the mains timer should be the only action
needed, with nothing here to remember to cancel.

Every recorder in STACKS is checked, not just production. See the comment there
before adding a stack.

  --dry-run   report the decision, never power off

Docs: /root/pve-01-docs/docs/livetv-custom-build-and-updates-20260726.md
"""
from __future__ import annotations

import hashlib
import html
import json
import subprocess
import sys
from datetime import datetime, time as dtime, timedelta, timezone
from pathlib import Path
from zoneinfo import ZoneInfo

# Written by the dashboard's "keep awake" button.
OVERRIDE = Path("/var/lib/dvr-dashboard/override-until")
MCT_BOOKINGS = Path("/var/lib/dvr-dashboard/mct-bookings.json")

LOCAL = ZoneInfo("Europe/Berlin")
POWER_ON = dtime(5, 5)           # mains restores; recordings before this are at risk

# Every stack that can hold a recording. This was CT 105 alone until
# 2026-08-02; CT 112 had been the only stack to record successfully for a day
# and was invisible here, so a recording scheduled on it would not have stopped
# the nightly shutdown. Adding a recorder means adding it to this list.
#
# nextpvr is queried from inside the container, so :8866 means that stack's own
# NextPVR, not production's. jellyfin_timers absent on disk means that stack has
# no Jellyfin-side DVR timers -- normal, and skipped quietly. CT 110 records via
# Threadfin through Jellyfin's own DVR, so it gets a timers path that does not
# exist yet and will start being checked the moment it does.
#
# CT 105's own NextPVR container was removed 2026-08-08: confirmed via live
# API not registered as a Jellyfin LiveTv service, 0 real channels, 0
# recordings ever, empty recordings dir since creation -- CT 105 records
# through Jellyfin+Threadfin directly (see the jellyfin_timers path below),
# same as CT 110. The real, in-use NextPVR is CT 112's "nextpvr-live".
STACKS = (
    {"ct": "105", "label": "media-core",
     "nextpvr": False,
     "jellyfin_timers": "/srv/media-core/jellyfin/config/data/livetv/timers.json"},
    {"ct": "110", "label": "jellyfin-live",
     "nextpvr": False,
     "jellyfin_timers": "/srv/jellyfin-live/jellyfin/config/data/livetv/timers.json"},
    {"ct": "112", "label": "jellyfin-npvr",
     "nextpvr": True,
     "jellyfin_timers": "/srv/jellyfin-npvr/jellyfin/config/data/livetv/timers.json"},
)

NEXTPVR = "http://localhost:8866/service"
JF_DONE = {"Completed", "Cancelled", "Error"}
MAILTO = "nathan.karras@gmail.com"


def pct(ct: str, *args: str, timeout: int = 30) -> str:
    return subprocess.run(["/usr/sbin/pct", "exec", ct, "--", *args],
                          capture_output=True, text=True,
                          timeout=timeout, check=True).stdout


def ct_running(ct: str) -> bool:
    """A stopped container cannot be recording, and is not a failed measurement.

    Distinguishing this from "running but unreachable" is the whole point: the
    second case must keep the host up, the first must not, or a deliberately
    stopped stack would block every shutdown forever.
    """
    try:
        out = subprocess.run(["/usr/sbin/pct", "status", ct],
                             capture_output=True, text=True, timeout=15, check=True).stdout
        return "running" in out
    except Exception:                                     # noqa: BLE001
        return False


def npvr_start(tag) -> datetime:
    """NextPVR start time as a real local datetime.

    <start_time> is local wall time ("07/31/2026 22:00:00"). <start_time_ticks>
    looks like an epoch but is that same wall time encoded as if it were UTC,
    so reading it with fromtimestamp(tz=LOCAL) lands 2 h out in CEST. Parse the
    string; fall back to relabelling the ticks rather than trusting them.
    """
    raw = tag("start_time")
    if raw:
        return datetime.strptime(raw.strip(), "%m/%d/%Y %H:%M:%S").replace(tzinfo=LOCAL)
    naive = datetime.fromtimestamp(int(tag("start_time_ticks")), tz=timezone.utc)
    return naive.replace(tzinfo=LOCAL)

def next_power_on(now: datetime) -> datetime:
    today = now.replace(hour=POWER_ON.hour, minute=POWER_ON.minute,
                        second=0, microsecond=0)
    return today if today > now else today + timedelta(days=1)


def nextpvr_blockers(stack: dict, now: datetime, until: datetime) -> tuple[list[str], list[str]]:
    """(reasons to stay up, problems). A problem is itself a reason to stay up."""
    ct, label = stack["ct"], stack["label"]
    try:
        init = pct(ct, "curl", "-s", "--max-time", "10",
                   f"{NEXTPVR}?method=session.initiate&ver=1.0&device=shutdownguard")
        sid = init.split("<sid>")[1].split("</sid>")[0]
        salt = init.split("<salt>")[1].split("</salt>")[0]
        h = hashlib.md5(f":{hashlib.md5(b'0000').hexdigest()}:{salt}".encode()).hexdigest()
        pct(ct, "curl", "-s", "--max-time", "10",
            f"{NEXTPVR}?method=session.login&md5={h}&sid={sid}")
    except Exception as exc:                              # noqa: BLE001
        return [], [f"NextPVR/{label}: could not authenticate ({exc})"]

    reasons: list[str] = []
    try:
        if pct(ct, "curl", "-s", "--max-time", "10",
               f"{NEXTPVR}?method=recording.list&filter=inprogress&sid={sid}"
               ).count("<recording>"):
            # filter=inprogress also returns status "Pending", verified
            # 2026-08-02 -- so this fires for armed recordings too. Wording says
            # so rather than the logic changing; erring toward staying up is
            # correct and this branch is not worth re-litigating.
            reasons.append(f"NextPVR/{label}: a recording is in progress or armed")

        pending = pct(ct, "curl", "-s", "--max-time", "10",
                      f"{NEXTPVR}?method=recording.list&filter=pending&sid={sid}")
    except Exception as exc:                              # noqa: BLE001
        return reasons, [f"NextPVR/{label}: could not list recordings ({exc})"]

    for chunk in pending.split("<recording>")[1:]:
        def tag(t: str) -> str:
            return chunk.split(f"<{t}>")[1].split(f"</{t}>")[0] if f"<{t}>" in chunk else ""
        # Epoch/second variants, not the formatted <start_time>/<duration>:
        # parsing those threw and skipped every recording, so this guard could
        # have shut the host down mid-recording.
        try:
            start = npvr_start(tag)
            end = start + timedelta(seconds=int(tag("duration_seconds") or 0))
        except (ValueError, IndexError):
            continue
        if start <= now <= end:
            reasons.append(f"NextPVR/{label}: '{html.unescape(tag('name'))}' is recording now")
        elif now < start < until:
            reasons.append(f"NextPVR/{label}: '{html.unescape(tag('name'))}' starts {start:%H:%M}")
    return reasons, []


def jellyfin_blockers(stack: dict, now: datetime, until: datetime) -> tuple[list[str], list[str]]:
    ct, label, path = stack["ct"], stack["label"], stack["jellyfin_timers"]

    # No timers file means this stack has never scheduled a Jellyfin recording.
    # That is an answer, not a failed measurement, so it must not keep the host
    # up -- only a file we expected to read and could not does that.
    try:
        pct(ct, "test", "-f", path, timeout=20)
    except subprocess.CalledProcessError:
        return [], []
    except Exception as exc:                              # noqa: BLE001
        return [], [f"Jellyfin/{label}: could not check for timers ({exc})"]

    try:
        timers = json.loads(pct(ct, "cat", path))
    except Exception as exc:                              # noqa: BLE001
        return [], [f"Jellyfin/{label}: could not read timers ({exc})"]

    reasons: list[str] = []
    for t in timers:
        if t.get("Status") in JF_DONE:
            continue
        try:
            start = datetime.fromisoformat(
                t["StartDate"].replace("Z", "+00:00")).astimezone(LOCAL)
            end = datetime.fromisoformat(
                t["EndDate"].replace("Z", "+00:00")).astimezone(LOCAL)
        except (KeyError, ValueError):
            continue
        start -= timedelta(seconds=t.get("PrePaddingSeconds") or 0)
        end += timedelta(seconds=t.get("PostPaddingSeconds") or 0)
        name = t.get("Name", "recording")
        if start <= now <= end:
            reasons.append(f"Jellyfin/{label}: '{name}' is recording now")
        elif now < start < until:
            reasons.append(f"Jellyfin/{label}: '{name}' starts {start:%H:%M}")
    return reasons, []


def mct_blockers(now: datetime, until: datetime) -> tuple[list[str], list[str]]:
    """Check /var/lib/dvr-dashboard/mct-bookings.json for active or upcoming MCT captures."""
    if not MCT_BOOKINGS.exists():
        return [], []
    try:
        data = json.loads(MCT_BOOKINGS.read_text())
        if not isinstance(data, list):
            return [], [f"MCT: {MCT_BOOKINGS} is not a JSON list"]
    except Exception as exc:
        return [], [f"MCT: could not read bookings ({exc})"]

    reasons: list[str] = []
    for b in data:
        status = b.get("status", "booked")
        if status in ("cancelled", "done", "failed"):
            continue
        try:
            start = datetime.fromisoformat(b["start"]).astimezone(LOCAL)
            duration_sec = int(b.get("duration_sec", 0))
            end = start + timedelta(seconds=duration_sec)
        except (KeyError, ValueError, TypeError):
            continue

        # Treat an upcoming or running MCT booking exactly like a Jellyfin timer, with the same padding:
        # 5m pre-padding, 15m post-padding
        start -= timedelta(minutes=5)
        end += timedelta(minutes=15)
        name = b.get("title") or b.get("name", "recording")

        is_live = False
        if status == "running":
            unit = b.get("unit")
            pid = b.get("pid")
            if unit:
                act = subprocess.run(["systemctl", "is-active", unit],
                                     capture_output=True, text=True).stdout.strip()
                if act in ("active", "activating", "deactivating"):
                    is_live = True
            elif pid:
                try:
                    os.kill(pid, 0)
                    is_live = True
                except (ProcessLookupError, OSError):
                    is_live = False
            else:
                if start <= now <= end:
                    is_live = True
        elif start <= now <= end:
            is_live = True

        if is_live:
            reasons.append(f"MCT: '{name}' is recording now")
        elif now < start < until:
            reasons.append(f"MCT: '{name}' starts {start:%H:%M}")
    return reasons, []


def notify(subject: str, body: list[str]) -> None:
    subprocess.run(["mail", "-s", subject, MAILTO],
                   input="\n".join(body), text=True, check=False)


def main() -> int:
    dry = "--dry-run" in sys.argv
    now = datetime.now(LOCAL)
    until = next_power_on(now)

    # Manual override from the dashboard wins over everything below.
    #
    # Bug found + fixed 2026-08-11: this used to unconditionally reassign
    # `until` to the override file's value, even when that value was already
    # in the past (an expired override, e.g. left over from a prior night).
    # An expired-but-still-present override therefore silently poisoned the
    # `until` cutoff used below for "does anything start before the next
    # power-on" -- once `until` is in the past, `now < start < until` can
    # never be true again, for any future recording, on any future night,
    # until someone happens to set a fresh override. This ran undetected
    # since the override set 2026-08-09 22:25 expired: real impact caught
    # 2026-08-11 when a same-night Brewers game (starting well after the
    # shutdown check) would have gone completely unprotected. Fix: only let
    # the override override `until` while it's still actually active; an
    # expired one is simply ignored, same as no override existing at all.
    try:
        ov = datetime.fromisoformat(OVERRIDE.read_text().strip())
        if ov > now:
            print(f"override active until {ov:%a %H:%M} -- staying up")
            return 0
    except (OSError, ValueError):
        pass

    reasons, problems = [], []

    # Check host-level MCT bookings
    mct_r, mct_p = mct_blockers(now, until)
    reasons += mct_r
    problems += mct_p

    for stack in STACKS:
        # A stopped container holds no recordings and cannot be asked. Treating
        # that as unmeasurable would wedge the shutdown permanently.
        if not ct_running(stack["ct"]):
            print(f"CT {stack['ct']} ({stack['label']}) is not running -- skipped")
            continue
        checks = [jellyfin_blockers]
        if stack["nextpvr"]:
            checks.insert(0, nextpvr_blockers)
        for fn in checks:
            r, p = fn(stack, now, until)
            reasons += r
            problems += p

    # Failing safe means staying up: a box left running costs one unclean cut,
    # a box shut down over a recording we could not see costs the recording.
    if problems:
        reasons += [f"could not verify -- {p}" for p in problems]

    if reasons:
        print(f"staying up: {len(reasons)} reason(s)")
        for r in reasons:
            print(f"  {r}")
        if not dry:
            notify("DVR: clean shutdown skipped, recording due", [
                f"Host stayed up at {now:%H:%M} instead of shutting down.", "",
                *[f"  {r}" for r in reasons], "",
                "IMPORTANT: this does not hold the mains timer open.",
                "If the timer is still armed it cuts power at ~22:24 and the",
                "recording dies with it. Switch the timer off to record.", ""])
        return 0

    print(f"nothing scheduled before {until:%a %H:%M} -- shutting down cleanly")
    if dry:
        print("(dry run, not shutting down)")
        return 0
    subprocess.run(["/usr/sbin/shutdown", "-h", "+2",
                    "Clean shutdown ahead of the mains timer"], check=False)
    return 0


if __name__ == "__main__":
    sys.exit(main())
