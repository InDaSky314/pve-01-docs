#!/usr/bin/env python3
"""Email a reminder when something worth recording falls outside the power window.

The host is on a mains timer (on ~04:57, off ~22:24 local). US sport in
CET lands mostly overnight, so anything worth recording needs the timer
overridden by hand. This looks ahead a few days at the followed teams plus
any recording NextPVR already has scheduled, and mails only when action is
actually needed -- a reminder that fires every day gets ignored.

Data source is ESPN's public site API (no key). Failures are non-fatal and
reported in the mail rather than silently dropping a game.

Docs: /root/pve-01-docs/docs/livetv-custom-build-and-updates-20260726.md
"""
from __future__ import annotations

import json
import subprocess
import sys
import urllib.request
from datetime import datetime, timedelta, time as dtime
from zoneinfo import ZoneInfo

LOCAL = ZoneInfo("Europe/Berlin")

# Mains timer window, local time. End is deliberately a few minutes early:
# the cut is at ~22:24 and NextPVR adds 2 min post-padding.
POWER_ON = dtime(4, 57)
POWER_OFF = dtime(22, 20)

LOOKAHEAD_DAYS = 2
MAILTO = "nathan.karras@gmail.com"

# Which DVR is in use is still undecided, so check both. Jellyfin timers are
# read straight off disk inside CT 105 -- no API key to store or rotate.
JELLYFIN_TIMERS = "/srv/media-core/jellyfin/config/data/livetv/timers.json"
CT = "105"
# Terminal states. Anything else with a future start date is treated as
# upcoming, so an unexpected status string errs toward reminding.
JF_DONE = {"Completed", "Cancelled", "Error"}

# Rough broadcast durations incl. padding. Better to over-estimate: a false
# reminder costs nothing, a missed one costs the recording.
DURATION = {"football": timedelta(hours=3, minutes=45),
            "basketball": timedelta(hours=2, minutes=45)}

TEAMS = [
    ("Packers",          "football/nfl",                        "gb"),
    ("Badgers football", "football/college-football",           "275"),
    ("Badgers basket",   "basketball/mens-college-basketball",  "275"),
    ("Bucks",            "basketball/nba",                      "mil"),
]

API = "https://site.api.espn.com/apis/site/v2/sports/{sport}/teams/{team}/schedule"


def fetch(sport: str, team: str) -> dict:
    req = urllib.request.Request(
        API.format(sport=sport, team=team),
        headers={"User-Agent": "dvr-power-reminder/1.0"},
    )
    with urllib.request.urlopen(req, timeout=25) as r:
        return json.load(r)


def outside_window(start: datetime, end: datetime) -> bool:
    """True if any part of [start, end] falls while the mains timer is off."""
    cur = start
    while cur <= end:
        if not (POWER_ON <= cur.time() <= POWER_OFF):
            return True
        cur += timedelta(minutes=15)
    return not (POWER_ON <= end.time() <= POWER_OFF)


def games_needing_power(now: datetime) -> tuple[list[str], list[str]]:
    horizon = now + timedelta(days=LOOKAHEAD_DAYS)
    hits: list[str] = []
    problems: list[str] = []

    for label, sport, team in TEAMS:
        try:
            data = fetch(sport, team)
        except Exception as exc:                      # noqa: BLE001
            problems.append(f"{label}: could not fetch schedule ({exc})")
            continue

        kind = "football" if "football" in sport else "basketball"
        for ev in data.get("events", []):
            raw = ev.get("date")
            if not raw:
                continue
            try:
                start = datetime.fromisoformat(raw.replace("Z", "+00:00")).astimezone(LOCAL)
            except ValueError:
                continue
            if not (now <= start <= horizon):
                continue
            end = start + DURATION[kind]
            if outside_window(start, end):
                name = ev.get("shortName") or ev.get("name") or "game"
                hits.append(
                    f"  {start:%a %d %b  %H:%M}-{end:%H:%M}  {label}: {name}"
                )
    return sorted(hits), problems


def nextpvr_pending(now: datetime) -> tuple[list[str], list[str]]:
    """Recordings NextPVR already has scheduled that fall outside the window."""
    import hashlib

    base = "http://192.168.9.50:8866/service"
    problems: list[str] = []
    try:
        out = subprocess.run(
            ["curl", "-s", "--max-time", "15",
             f"{base}?method=session.initiate&ver=1.0&device=reminder"],
            capture_output=True, text=True, check=True).stdout
        sid = out.split("<sid>")[1].split("</sid>")[0]
        salt = out.split("<salt>")[1].split("</salt>")[0]
        pin = hashlib.md5(b"0000").hexdigest()
        h = hashlib.md5(f":{pin}:{salt}".encode()).hexdigest()
        subprocess.run(["curl", "-s", "--max-time", "15",
                        f"{base}?method=session.login&md5={h}&sid={sid}"],
                       capture_output=True, text=True, check=True)
        xml = subprocess.run(
            ["curl", "-s", "--max-time", "15",
             f"{base}?method=recording.list&filter=pending&sid={sid}"],
            capture_output=True, text=True, check=True).stdout
    except Exception as exc:                          # noqa: BLE001
        return [], [f"NextPVR: could not read pending recordings ({exc})"]

    hits: list[str] = []
    for chunk in xml.split("<recording>")[1:]:
        def tag(t: str) -> str:
            return chunk.split(f"<{t}>")[1].split(f"</{t}>")[0] if f"<{t}>" in chunk else ""
        try:
            start = datetime.fromtimestamp(int(tag("start_time")), tz=LOCAL)
            end = start + timedelta(seconds=int(tag("duration") or 0))
        except (ValueError, IndexError):
            continue
        if start < now:
            continue
        if outside_window(start, end):
            hits.append(f"  {start:%a %d %b  %H:%M}-{end:%H:%M}  scheduled: {tag('name')}")
    return sorted(hits), problems


def jellyfin_pending(now: datetime) -> tuple[list[str], list[str]]:
    """Upcoming Jellyfin DVR timers that fall outside the window."""
    horizon = now + timedelta(days=LOOKAHEAD_DAYS)
    try:
        raw = subprocess.run(
            ["/usr/sbin/pct", "exec", CT, "--", "cat", JELLYFIN_TIMERS],
            capture_output=True, text=True, timeout=30, check=True).stdout
        timers = json.loads(raw)
    except Exception as exc:                          # noqa: BLE001
        return [], [f"Jellyfin: could not read timers ({exc})"]

    hits: list[str] = []
    for t in timers:
        if t.get("Status") in JF_DONE:
            continue
        try:
            start = datetime.fromisoformat(
                t["StartDate"].replace("Z", "+00:00")).astimezone(LOCAL)
            end = datetime.fromisoformat(
                t["EndDate"].replace("Z", "+00:00")).astimezone(LOCAL)
        except (KeyError, ValueError):
            continue
        start -= timedelta(seconds=t.get("PrePaddingSeconds") or 0)
        end += timedelta(seconds=t.get("PostPaddingSeconds") or 0)
        if not (now <= start <= horizon):
            continue
        if outside_window(start, end):
            hits.append(f"  {start:%a %d %b  %H:%M}-{end:%H:%M}  "
                        f"Jellyfin: {t.get('Name', 'recording')}")
    return sorted(hits), []


def main() -> int:
    now = datetime.now(LOCAL)
    games, gp = games_needing_power(now)
    recs, rp = nextpvr_pending(now)
    jf, jp = jellyfin_pending(now)
    problems = gp + rp + jp

    if not games and not recs and not jf and not problems:
        return 0                                      # nothing to say; stay quiet

    lines = [
        f"Power timer is off {POWER_OFF:%H:%M}-{POWER_ON:%H:%M} local.",
        f"These fall wholly or partly inside that gap (next {LOOKAHEAD_DAYS} days):",
        "",
    ]
    if games:
        lines += ["Games:", *games, ""]
    if recs:
        lines += ["Scheduled in NextPVR:", *recs, ""]
    if jf:
        lines += ["Scheduled in Jellyfin DVR:", *jf, ""]
    if problems:
        lines += ["Could not check:", *[f"  {p}" for p in problems], ""]
    lines += ["Leave the mains timer ON overnight to catch these.", ""]

    count = len(games) + len(recs) + len(jf)
    subject = (f"DVR: {count} item(s) need the power timer left on"
               if count else "DVR: reminder check had problems")
    subprocess.run(["mail", "-s", subject, MAILTO],
                   input="\n".join(lines), text=True, check=False)
    return 0


if __name__ == "__main__":
    sys.exit(main())
