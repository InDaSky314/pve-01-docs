#!/usr/bin/env python3
"""Email a reminder when something worth recording falls outside the power window.

The host is on a mains timer (on ~04:57, off ~22:24 local). US sport in
CET lands mostly overnight, so anything worth recording needs the timer
overridden by hand. This looks ahead a few days at the followed teams plus
any recording NextPVR already has scheduled, and mails only when action is
actually needed -- a reminder that fires every day gets ignored.

Data source is ESPN's public site API (no key). Failures are non-fatal and
reported in the mail rather than silently dropping a game.

Docs: /root/pve-01-docs/docs/livetv-custom-build-and-updates-20260726.md
"""
from __future__ import annotations

import html
import json
import subprocess
import sys
import urllib.request
from datetime import datetime, timedelta, timezone, time as dtime
from zoneinfo import ZoneInfo

LOCAL = ZoneInfo("Europe/Berlin")

# Mains timer window, local time. End is deliberately a few minutes early:
# the cut is at ~22:24 and NextPVR adds 2 min post-padding.
POWER_ON = dtime(4, 57)
POWER_OFF = dtime(22, 20)

LOOKAHEAD_DAYS = 2
MAILTO = "nathan.karras@gmail.com"

# Which DVR is in use is still undecided, so check every stack that can hold a
# recording. This was CT 105 alone until 2026-08-02, which meant a game
# recorded on CT 112 -- the only stack that had actually recorded successfully
# -- produced no reminder to leave the mains timer on, and would have been cut
# off at 22:24. Jellyfin timers are read straight off disk inside each
# container: no API key to store or rotate.
#
# A missing timers.json means that stack has never scheduled a Jellyfin
# recording. It is skipped silently rather than reported as a problem -- a
# reminder that carries the same complaint every morning stops being read.
STACKS = (
    {"ct": "105", "label": "media-core",
     "nextpvr": "http://192.168.9.50:8866/service",
     "jellyfin_timers": "/srv/media-core/jellyfin/config/data/livetv/timers.json"},
    {"ct": "110", "label": "jellyfin-live",
     "nextpvr": None,
     "jellyfin_timers": "/srv/jellyfin-live/jellyfin/config/data/livetv/timers.json"},
    {"ct": "112", "label": "jellyfin-npvr",
     "nextpvr": "http://192.168.9.219:8866/service",
     "jellyfin_timers": "/srv/jellyfin-npvr/jellyfin/config/data/livetv/timers.json"},
)
# Terminal states. Anything else with a future start date is treated as
# upcoming, so an unexpected status string errs toward reminding.
JF_DONE = {"Completed", "Cancelled", "Error"}

# Rough broadcast durations incl. padding. Better to over-estimate: a false
# reminder costs nothing, a missed one costs the recording.
DURATION = {"football": timedelta(hours=3, minutes=45),
            "basketball": timedelta(hours=2, minutes=45)}

TEAMS = [
    ("Packers",          "football/nfl",                        "gb"),
    ("Badgers football", "football/college-football",           "275"),
    ("Badgers basket",   "basketball/mens-college-basketball",  "275"),
    ("Bucks",            "basketball/nba",                      "mil"),
    # The Brewers are deliberately NOT here, though they ARE on the dashboard.
    # 36 of 50 upcoming games start inside the 22:24-04:57 mains-off window,
    # so including them would fire a reminder most nights of the season --
    # and an alert that fires nightly for an expected event gets muted along
    # with the real ones. The owner watches selectively and uses the
    # dashboard's keep-awake button for the games they want.
]

API = ("https://site.api.espn.com/apis/site/v2/sports/{sport}"
       "/teams/{team}/schedule?seasontype={stype}")

# The default response is the regular season only. Preseason games are watched
# too and start weeks earlier, and for some teams the default returns nothing
# at all -- so always ask for each season type explicitly.
SEASON_TYPES = (1, 2, 3)


def fetch(sport: str, team: str) -> list[dict]:
    """All events across season types, de-duplicated by event id."""
    events, seen = [], set()
    for stype in SEASON_TYPES:
        req = urllib.request.Request(
            API.format(sport=sport, team=team, stype=stype),
            # No custom User-Agent. ESPN's edge 403s "dvr-power-reminder/1.0"
            # and any Mozilla string, but serves curl/* and Python's default
            # urllib UA. This silently emptied every reminder: the fetch
            # failed, the exception was swallowed, and the job reported
            # "nothing outside the window" every night. Same bug was in
            # dvr-dashboard. Do not add a polite identifying UA back.
        )
        try:
            with urllib.request.urlopen(req, timeout=25) as r:
                data = json.load(r)
        except Exception:                                 # noqa: BLE001
            continue
        for ev in data.get("events", []):
            key = ev.get("id") or ev.get("date")
            if key in seen:
                continue
            seen.add(key)
            events.append(ev)
    return events


def npvr_start(tag) -> datetime:
    """NextPVR start time as a real local datetime.

    <start_time> is local wall time ("07/31/2026 22:00:00"). <start_time_ticks>
    looks like an epoch but is that same wall time encoded as if it were UTC,
    so reading it with fromtimestamp(tz=LOCAL) lands 2 h out in CEST. Parse the
    string; fall back to relabelling the ticks rather than trusting them.
    """
    raw = tag("start_time")
    if raw:
        return datetime.strptime(raw.strip(), "%m/%d/%Y %H:%M:%S").replace(tzinfo=LOCAL)
    naive = datetime.fromtimestamp(int(tag("start_time_ticks")), tz=timezone.utc)
    return naive.replace(tzinfo=LOCAL)

def outside_window(start: datetime, end: datetime) -> bool:
    """True if any part of [start, end] falls while the mains timer is off."""
    cur = start
    while cur <= end:
        if not (POWER_ON <= cur.time() <= POWER_OFF):
            return True
        cur += timedelta(minutes=15)
    return not (POWER_ON <= end.time() <= POWER_OFF)


def games_needing_power(now: datetime) -> tuple[list[str], list[str]]:
    horizon = now + timedelta(days=LOOKAHEAD_DAYS)
    hits: list[str] = []
    problems: list[str] = []

    for label, sport, team in TEAMS:
        try:
            events = fetch(sport, team)
        except Exception as exc:                      # noqa: BLE001
            problems.append(f"{label}: could not fetch schedule ({exc})")
            continue
        # An empty schedule is normal out of season and indistinguishable from
        # one, so it is not reported -- a daily "no events" mail would be noise.

        kind = "football" if "football" in sport else "basketball"
        for ev in events:
            raw = ev.get("date")
            if not raw:
                continue
            try:
                start = datetime.fromisoformat(raw.replace("Z", "+00:00")).astimezone(LOCAL)
            except ValueError:
                continue
            if not (now <= start <= horizon):
                continue
            end = start + DURATION[kind]
            if outside_window(start, end):
                name = ev.get("shortName") or ev.get("name") or "game"
                hits.append(
                    f"  {start:%a %d %b  %H:%M}-{end:%H:%M}  {label}: {name}"
                )
    return sorted(hits), problems


def nextpvr_pending(stack: dict, now: datetime) -> tuple[list[str], list[str]]:
    """Recordings NextPVR already has scheduled that fall outside the window."""
    import hashlib

    base, label = stack["nextpvr"], stack["label"]
    problems: list[str] = []
    try:
        out = subprocess.run(
            ["curl", "-s", "--max-time", "15",
             f"{base}?method=session.initiate&ver=1.0&device=reminder"],
            capture_output=True, text=True, check=True).stdout
        sid = out.split("<sid>")[1].split("</sid>")[0]
        salt = out.split("<salt>")[1].split("</salt>")[0]
        pin = hashlib.md5(b"0000").hexdigest()
        h = hashlib.md5(f":{pin}:{salt}".encode()).hexdigest()
        subprocess.run(["curl", "-s", "--max-time", "15",
                        f"{base}?method=session.login&md5={h}&sid={sid}"],
                       capture_output=True, text=True, check=True)
        xml = subprocess.run(
            ["curl", "-s", "--max-time", "15",
             f"{base}?method=recording.list&filter=pending&sid={sid}"],
            capture_output=True, text=True, check=True).stdout
    except Exception as exc:                          # noqa: BLE001
        return [], [f"NextPVR/{label}: could not read pending recordings ({exc})"]

    hits: list[str] = []
    for chunk in xml.split("<recording>")[1:]:
        def tag(t: str) -> str:
            return chunk.split(f"<{t}>")[1].split(f"</{t}>")[0] if f"<{t}>" in chunk else ""
        # NextPVR exposes both formatted and epoch/second variants; the
        # formatted ones ('07/31/2026 22:00:00', '00:30') do not parse as ints
        # and silently skipped every recording.
        try:
            start = npvr_start(tag)
            end = start + timedelta(seconds=int(tag("duration_seconds") or 0))
        except (ValueError, IndexError):
            continue
        if start < now:
            continue
        if outside_window(start, end):
            ch = tag("channel")
            hits.append(f"  {start:%a %d %b  %H:%M}-{end:%H:%M}  "
                        # tag() splits raw XML, so entities arrive undecoded and
                        # "Men's Health" mails as "Men&apos;s Health".
                        f"{html.unescape(tag('name'))}  ({label})"
                        + (f"  [{html.unescape(ch)}]" if ch else ""))
    return sorted(hits), problems


def jellyfin_pending(stack: dict, now: datetime) -> tuple[list[str], list[str]]:
    """Upcoming Jellyfin DVR timers that fall outside the window."""
    ct, label, path = stack["ct"], stack["label"], stack["jellyfin_timers"]
    horizon = now + timedelta(days=LOOKAHEAD_DAYS)

    try:
        subprocess.run(["/usr/sbin/pct", "exec", ct, "--", "test", "-f", path],
                       capture_output=True, text=True, timeout=20, check=True)
    except subprocess.CalledProcessError:
        return [], []                                 # no timers here yet
    except Exception as exc:                          # noqa: BLE001
        return [], [f"Jellyfin/{label}: could not check for timers ({exc})"]

    try:
        raw = subprocess.run(
            ["/usr/sbin/pct", "exec", ct, "--", "cat", path],
            capture_output=True, text=True, timeout=30, check=True).stdout
        timers = json.loads(raw)
    except Exception as exc:                          # noqa: BLE001
        return [], [f"Jellyfin/{label}: could not read timers ({exc})"]

    hits: list[str] = []
    for t in timers:
        if t.get("Status") in JF_DONE:
            continue
        try:
            start = datetime.fromisoformat(
                t["StartDate"].replace("Z", "+00:00")).astimezone(LOCAL)
            end = datetime.fromisoformat(
                t["EndDate"].replace("Z", "+00:00")).astimezone(LOCAL)
        except (KeyError, ValueError):
            continue
        start -= timedelta(seconds=t.get("PrePaddingSeconds") or 0)
        end += timedelta(seconds=t.get("PostPaddingSeconds") or 0)
        if not (now <= start <= horizon):
            continue
        if outside_window(start, end):
            hits.append(f"  {start:%a %d %b  %H:%M}-{end:%H:%M}  "
                        f"Jellyfin: {t.get('Name', 'recording')}  ({label})")
    return sorted(hits), []


def main() -> int:
    now = datetime.now(LOCAL)
    games, gp = games_needing_power(now)

    recs: list[str] = []
    jf: list[str] = []
    problems: list[str] = list(gp)
    for stack in STACKS:
        if stack["nextpvr"]:
            r, p = nextpvr_pending(stack, now)
            recs += r
            problems += p
        j, p = jellyfin_pending(stack, now)
        jf += j
        problems += p
    recs.sort()
    jf.sort()

    if not games and not recs and not jf and not problems:
        return 0                                      # nothing to say; stay quiet

    lines = [
        f"Power timer is off {POWER_OFF:%H:%M}-{POWER_ON:%H:%M} local.",
        f"These fall wholly or partly inside that gap (next {LOOKAHEAD_DAYS} days):",
        "",
    ]
    if games:
        lines += ["Games:", *games, ""]
    if recs:
        lines += ["Scheduled in NextPVR:", *recs, ""]
    if jf:
        lines += ["Scheduled in Jellyfin DVR:", *jf, ""]
    if problems:
        lines += ["Could not check:", *[f"  {p}" for p in problems], ""]
    lines += ["Leave the mains timer ON overnight to catch these.", ""]

    count = len(games) + len(recs) + len(jf)
    subject = (f"DVR: {count} item(s) need the power timer left on"
               if count else "DVR: reminder check had problems")
    subprocess.run(["mail", "-s", subject, MAILTO],
                   input="\n".join(lines), text=True, check=False)
    return 0


if __name__ == "__main__":
    sys.exit(main())
