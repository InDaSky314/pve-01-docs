#!/usr/bin/env python3
"""Manual Capture Tool (MCT) — robust direct TS capture with in-file reconnect.

Captures a stream inside CT 105 (Swiss egress) using proven ffmpeg resilience
flags, performs pre-remux to eliminate DTS irregularities, populates rich EPG
metadata and poster artwork for Jellyfin, and enqueues the output for comskip.

Features:
1. Live-aware auto-extension via ESPN schedule polling with clean stdin 'q' termination.
2. Hard-cap timer protection: clamps extension window against upcoming Jellyfin timers
   and MCT bookings to prevent single-tuner collisions.
3. Fallback to fixed padding when no ESPN fixture exists (e.g. Bundesliga).
4. Real EPG metadata extraction (title, plot/overview, genres) and poster artwork
   download (program image fallback to channel logo).
5. Safe lockdata handling: only locks metadata once plot, genres, and poster are populated.
"""
from __future__ import annotations

import argparse
import html
import importlib.machinery
import importlib.util
import json
import os
import re
import signal
import subprocess
import sys
import time
import urllib.error
import urllib.parse
import urllib.request
from datetime import datetime, timedelta, timezone
from pathlib import Path
from typing import Any
from zoneinfo import ZoneInfo

LOCAL_TZ = ZoneInfo("Europe/Berlin")
LOKI_URL = "http://192.168.9.164:3100/loki/api/v1/push"
JF_BASE_URL = "http://192.168.9.50:8096"
JF_KEY_FILE = Path("/srv/media-core/.jellyfin_api_key")
CT_ID = "105"
MCT_BOOKINGS_FILE = Path("/var/lib/dvr-dashboard/mct-bookings.json")
SPORTS_DVR_AUTO_SCRIPT = Path("/usr/local/bin/sports-dvr-auto")
# A delayed fixture shifts its content later, so the window that was correct at
# launch is no longer correct. Bounded so a long rain delay cannot record forever,
# and only ever applied when the hard cap was NOT already clamped by the next
# reservation - the single tuner outranks a delayed game.
MAX_DELAY_EXTENSION_SEC = 7200  # 2h
MAX_RESTARTS = None  # None = unbounded by count; bounded only by the capture window / hard cap
MIN_RESTART_REMAINING_SEC = 60
RESTART_BACKOFF_BASE_SEC = 5.0
INITIAL_DEAD_BACKOFF_SEC = 30.0
MAX_BACKOFF_SEC = 300.0  # 5 minutes cap
_SPORTS_DVR_AUTO_MOD: Any = None


def get_adaptive_backoff(
    consecutive_dead: int,
    base_backoff: float = RESTART_BACKOFF_BASE_SEC,
    initial_dead: float = INITIAL_DEAD_BACKOFF_SEC,
    max_backoff: float = MAX_BACKOFF_SEC,
) -> float:
    """Calculate adaptive restart backoff.
    - If previous segment yielded content (consecutive_dead == 0): return base_backoff (5s).
    - If previous segment was a dead stub (consecutive_dead > 0): progressive backoff
      30s, 60s, 120s, 240s, capped at max_backoff (300s / 5m).
    """
    if consecutive_dead <= 0:
        return base_backoff
    backoff = initial_dead * (2 ** (consecutive_dead - 1))
    return min(max_backoff, backoff)


def evaluate_capture_success(
    captured_sec: float,
    requested_sec: int,
    stopped_cleanly: bool,
    interrupted: bool,
) -> tuple[bool, str]:
    """Evaluate whether capture met requirements.
    Rules:
    1. stopped_cleanly (e.g. ESPN final) is a success at ANY duration.
    2. interrupted (SIGTERM/SIGINT) is deliberate user cancel -> not successful capture.
    3. Otherwise, success requires capturing requested window (>=90% or within 30s tolerance).
       A capture well short of its window without a deliberate stop reports failure.
    """
    if stopped_cleanly:
        return True, f"ESPN final clean stop ({captured_sec:.0f}s captured)"
    if interrupted:
        return False, f"interrupted by signal ({captured_sec:.0f}s captured)"

    tolerance_sec = min(30.0, requested_sec * 0.10)
    min_required_sec = max(1.0, requested_sec - tolerance_sec)
    pct = (captured_sec / requested_sec * 100) if requested_sec > 0 else 0

    if captured_sec >= min_required_sec or (requested_sec > 0 and (captured_sec / requested_sec) >= 0.90):
        return True, f"captured full requested window ({captured_sec:.0f}s / {requested_sec}s, {pct:.1f}%)"

    return False, f"capture duration ({captured_sec:.0f}s / {requested_sec}s, {pct:.1f}%) well short of requested window without deliberate stop"



def _redact_url(text: str) -> str:
    """Never log provider credentials. They live in the URL path
    (/live/<user>/<pass>/<id>.ts) and MCT log lines reach journald and Loki, so a
    raw command echo would leak them exactly the way two Jellyfin API keys leaked
    into a public repo on 2026-08-03 (see docs/secret-exposure-20260902.md)."""
    return re.sub(r"(/live/)[^/]+/[^/]+/", r"\1<REDACTED>/<REDACTED>/", str(text))


def log(msg: str) -> None:
    msg = _redact_url(msg)
    now = datetime.now(LOCAL_TZ).strftime("%Y-%m-%d %H:%M:%S")
    print(f"[{now}] {msg}", flush=True)


def push_loki_alert(msg: str, level: str = "alert") -> None:
    """Fire-and-forget push to Loki job='media-core-alerts'."""
    stream = {"job": "media-core-alerts", "level": level, "source": "mct"}
    ts_ns = str(int(datetime.now(timezone.utc).timestamp() * 1_000_000_000))
    body = {"streams": [{"stream": stream, "values": [[ts_ns, msg]]}]}
    try:
        req = urllib.request.Request(
            LOKI_URL,
            data=json.dumps(body).encode("utf-8"),
            headers={"Content-Type": "application/json"},
            method="POST",
        )
        urllib.request.urlopen(req, timeout=5).read()
    except Exception:
        pass


def get_jf_token() -> str:
    if JF_KEY_FILE.exists():
        try:
            tok = JF_KEY_FILE.read_text().strip()
            if tok:
                return tok
        except Exception:
            pass
    try:
        tok = subprocess.run(
            ["/usr/sbin/pct", "exec", CT_ID, "--", "cat", "/srv/media-core/.jellyfin_api_key"],
            capture_output=True, text=True, timeout=10, check=True,
        ).stdout.strip()
        if tok:
            return tok
    except Exception:
        pass
    return ""


def jf_api(endpoint: str, method: str = "GET", data: dict | None = None) -> dict | list | None:
    token = get_jf_token()
    headers = {"Authorization": f'MediaBrowser Token="{token}"', "User-Agent": "MCT/1.0"}
    payload = json.dumps(data).encode("utf-8") if data is not None else None
    if payload:
        headers["Content-Type"] = "application/json"
    url = f"{JF_BASE_URL}{endpoint}"
    req = urllib.request.Request(url, data=payload, headers=headers, method=method)
    try:
        with urllib.request.urlopen(req, timeout=10) as resp:
            body = resp.read()
            return json.loads(body) if body else {}
    except Exception:
        return None


def jf_get_image_bytes(item_id: str) -> bytes | None:
    token = get_jf_token()
    headers = {"Authorization": f'MediaBrowser Token="{token}"', "User-Agent": "MCT/1.0"}
    url = f"{JF_BASE_URL}/Items/{item_id}/Images/Primary"
    req = urllib.request.Request(url, headers=headers, method="GET")
    try:
        with urllib.request.urlopen(req, timeout=10) as resp:
            return resp.read()
    except Exception:
        return None


def parse_playlist() -> list[dict[str, str]]:
    raw = subprocess.check_output(
        ["/usr/sbin/pct", "exec", CT_ID, "--", "cat", "/srv/media-core/threadfin/conf/playlist.m3u"],
        text=True, timeout=15,
    )
    channels = []
    lines = raw.splitlines()
    for i, line in enumerate(lines):
        line = line.strip()
        if line.startswith("#EXTINF:"):
            chno_m = re.search(r'tvg-chno="([^"]+)"', line)
            chno = chno_m.group(1).strip() if chno_m else ""
            name_m = re.search(r'tvg-name="([^"]+)"', line)
            name = name_m.group(1).strip() if name_m else ""
            if not name and "," in line:
                name = line.split(",", 1)[1].strip()
            url = ""
            if i + 1 < len(lines) and lines[i + 1].strip().startswith("http"):
                url = lines[i + 1].strip()
            if url:
                channels.append({"chno": chno, "name": name, "url": url})
    return channels


def resolve_channel(query: str, channels: list[dict[str, str]]) -> dict[str, str] | None:
    q = query.strip()
    m = re.match(r"^(\d+)\s*(.*)$", q)
    if m:
        cno = m.group(1)
        for c in channels:
            if c["chno"] == cno:
                return c
    for c in channels:
        if c["chno"] == q or c["name"].lower() == q.lower():
            return c
    for c in channels:
        if q.lower() in c["name"].lower():
            return c
    return None


def parse_duration(dstr: str) -> int:
    dstr = dstr.strip().lower()
    if dstr.isdigit():
        return int(dstr)
    if ":" in dstr:
        parts = [int(p) for p in dstr.split(":")]
        if len(parts) == 3:
            return parts[0] * 3600 + parts[1] * 60 + parts[2]
        if len(parts) == 2:
            return parts[0] * 60 + parts[1]
    m = re.match(r"^((?P<h>\d+(\.\d+)?)h)?\s*((?P<m>\d+)m(in)?)?\s*((?P<s>\d+)s)?$", dstr)
    if m:
        secs = 0
        if m.group("h"):
            secs += int(float(m.group("h")) * 3600)
        if m.group("m"):
            secs += int(m.group("m")) * 60
        if m.group("s"):
            secs += int(m.group("s"))
        if secs >= 0:
            return secs
    raise ValueError(f"Invalid duration format: {dstr}")


def check_exclusion(start_dt: datetime, end_dt: datetime,
                    self_booking_id: str | None = None) -> tuple[bool, str]:
    recs = jf_api("/LiveTv/Recordings?IsInProgress=true")
    if recs and isinstance(recs, dict) and recs.get("Items"):
        names = [r.get("Name", "unnamed") for r in recs["Items"]]
        return False, f"Jellyfin recording currently in progress ({', '.join(names)})"

    timers = jf_api("/LiveTv/Timers")
    if timers and isinstance(timers, dict):
        for t in timers.get("Items", []):
            if t.get("Status") in ("Completed", "Cancelled", "Error"):
                continue
            try:
                t_s = datetime.fromisoformat(t["StartDate"].replace("Z", "+00:00")) - timedelta(seconds=t.get("PrePaddingSeconds", 0))
                t_e = datetime.fromisoformat(t["EndDate"].replace("Z", "+00:00")) + timedelta(seconds=t.get("PostPaddingSeconds", 0))
            except Exception:
                continue
            if t_s < end_dt and t_e > start_dt:
                t_name = t.get("Name", "unnamed")
                return False, f"Overlapping Jellyfin timer '{t_name}' ({t_s.astimezone(LOCAL_TZ).strftime('%Y-%m-%d %H:%M')} to {t_e.astimezone(LOCAL_TZ).strftime('%H:%M')})"

    if MCT_BOOKINGS_FILE.exists():
        try:
            bookings = json.loads(MCT_BOOKINGS_FILE.read_text())
            if isinstance(bookings, list):
                for b in bookings:
                    if b.get("status") in ("cancelled", "canceled", "done", "error"):
                        continue
                    # A capture launched by mct-scheduler must not treat its OWN
                    # booking as a conflict. Booking-awareness was added to this
                    # function after the scheduler's end-to-end test had already
                    # passed, so every scheduled capture would refuse at launch.
                    if self_booking_id and str(b.get("id")) == str(self_booking_id):
                        continue
                    try:
                        b_s = datetime.fromisoformat(b["start"]).astimezone(timezone.utc)
                        b_e = datetime.fromisoformat(b["end"]).astimezone(timezone.utc)
                    except Exception:
                        continue
                    if b_s < end_dt and b_e > start_dt:
                        b_title = b.get("title") or b.get("name") or "unnamed booking"
                        return False, f"Overlapping MCT booking '{b_title}' ({b_s.astimezone(LOCAL_TZ).strftime('%Y-%m-%d %H:%M')} to {b_e.astimezone(LOCAL_TZ).strftime('%H:%M')})"
        except Exception:
            pass

    return True, ""


def _find_sports_dvr_auto_script() -> Path:
    if SPORTS_DVR_AUTO_SCRIPT.exists():
        return SPORTS_DVR_AUTO_SCRIPT
    local_script = Path(__file__).resolve().parent / "sports-dvr-auto"
    if local_script.exists():
        return local_script
    return SPORTS_DVR_AUTO_SCRIPT


def get_sports_dvr_auto_module() -> Any:
    """Dynamically import and cache sports-dvr-auto module."""
    global _SPORTS_DVR_AUTO_MOD
    if _SPORTS_DVR_AUTO_MOD is not None:
        return _SPORTS_DVR_AUTO_MOD
    script_path = _find_sports_dvr_auto_script()
    if script_path.exists():
        try:
            loader = importlib.machinery.SourceFileLoader("sports_dvr_auto", str(script_path))
            spec = importlib.util.spec_from_file_location("sports_dvr_auto", str(script_path), loader=loader)
            if spec and spec.loader:
                mod = importlib.util.module_from_spec(spec)
                loader.exec_module(mod)
                _SPORTS_DVR_AUTO_MOD = mod
                return mod
        except Exception as exc:
            log(f"WARNING: Could not import sports-dvr-auto ({exc})")
    return None


def load_espn_schedule() -> list[dict[str, Any]]:
    """Reuse ESPN schedule plumbing from sports-dvr-auto."""
    mod = get_sports_dvr_auto_module()
    if mod and hasattr(mod, "fetch_espn_schedule"):
        try:
            return mod.fetch_espn_schedule()
        except Exception as exc:
            log(f"WARNING: fetch_espn_schedule failed ({exc}), falling back to direct ESPN API")

    # Direct ESPN fallback if sports-dvr-auto is unavailable
    games: list[dict[str, Any]] = []
    teams = [
        ("Brewers", "baseball/mlb", "mil"),
        ("Packers", "football/nfl", "gb"),
        ("Bucks", "basketball/nba", "mil"),
        ("Badgers Football", "football/college-football", "275"),
        ("Badgers Basketball", "basketball/mens-college-basketball", "275"),
    ]
    seen_ids: set[str] = set()
    for team_label, sport_path, team_id in teams:
        for stype in (1, 2, 3):
            url = f"https://site.api.espn.com/apis/site/v2/sports/{sport_path}/teams/{team_id}/schedule?seasontype={stype}"
            req = urllib.request.Request(url)
            try:
                with urllib.request.urlopen(req, timeout=10) as resp:
                    data = json.load(resp)
            except Exception:
                continue
            for event in data.get("events", []):
                eid = event.get("id")
                if not eid or eid in seen_ids:
                    continue
                seen_ids.add(eid)
                try:
                    s_dt = datetime.fromisoformat(event["date"].replace("Z", "+00:00"))
                except Exception:
                    continue
                comp = (event.get("competitions") or [{}])[0]
                status_type = ((comp.get("status") or {}).get("type") or {})
                games.append({
                    "id": eid,
                    "team": team_label,
                    "name": event.get("name") or event.get("shortName") or "Game",
                    "shortName": event.get("shortName") or "",
                    "start": s_dt,
                    "end": s_dt + timedelta(hours=3, minutes=15),
                    "state": status_type.get("state", "pre"),
                    "completed": bool(status_type.get("completed", False)),
                    "status_detail": status_type.get("detail") or status_type.get("shortDetail") or "",
                })
    return games


def find_espn_fixture(title: str, channel_name: str, start_dt: datetime, games: list[dict[str, Any]]) -> dict[str, Any] | None:
    start_utc = start_dt.astimezone(timezone.utc)
    target_str = f"{title} {channel_name}".lower()

    for g in games:
        if abs((g["start"] - start_utc).total_seconds()) > 4 * 3600:
            continue

        team_lead = g.get("team", "").lower().split()[0]
        if team_lead and team_lead in target_str:
            return g

        tokens = {w.lower() for w in re.findall(r"[A-Za-z]{3,}", g.get("name", ""))}
        tokens -= {"live", "the", "and"}
        if sum(1 for w in tokens if w in target_str) >= 2:
            return g

    return None


def lookup_epg_and_artwork(ch: dict[str, str], start_dt: datetime, custom_title: str | None = None, custom_genre: str = "Sports") -> dict[str, Any]:
    """Look up Jellyfin EPG program airing on channel at start_dt, and retrieve artwork."""
    jf_chans_resp = jf_api("/LiveTv/Channels")
    jf_chans = (jf_chans_resp or {}).get("Items", []) if isinstance(jf_chans_resp, dict) else []

    matched_ch = None
    if ch.get("chno"):
        for c in jf_chans:
            if str(c.get("ChannelNumber")) == str(ch["chno"]) or str(c.get("Number")) == str(ch["chno"]):
                matched_ch = c
                break
    if not matched_ch:
        q_norm = ch.get("name", "").lower().strip()
        for c in jf_chans:
            if c.get("Name", "").lower().strip() == q_norm:
                matched_ch = c
                break
        if not matched_ch:
            for c in jf_chans:
                c_norm = c.get("Name", "").lower().strip()
                if q_norm in c_norm or c_norm in q_norm:
                    matched_ch = c
                    break

    channel_id = matched_ch.get("Id") if matched_ch else None
    channel_name = matched_ch.get("Name") if matched_ch else ch.get("name", "")
    channel_img_tag = (matched_ch.get("ImageTags") or {}).get("Primary") if matched_ch else None

    matched_prog = None
    if channel_id:
        start_utc = start_dt.astimezone(timezone.utc)
        progs_resp = jf_api(f"/LiveTv/Programs?ChannelIds={channel_id}&Fields=Overview,Genres,Tags,People,Studios,OfficialRating&Limit=100")
        progs = (progs_resp or {}).get("Items", []) if isinstance(progs_resp, dict) else []

        for p in progs:
            try:
                p_s = datetime.fromisoformat(p["StartDate"].replace("Z", "+00:00"))
                p_e = datetime.fromisoformat(p["EndDate"].replace("Z", "+00:00"))
                if p_s <= start_utc < p_e:
                    matched_prog = p
                    break
            except Exception:
                continue

        if not matched_prog and progs:
            best_diff = 1800
            for p in progs:
                try:
                    p_s = datetime.fromisoformat(p["StartDate"].replace("Z", "+00:00"))
                    diff = abs((p_s - start_utc).total_seconds())
                    if diff < best_diff:
                        best_diff = diff
                        matched_prog = p
                except Exception:
                    continue

    prog_title = matched_prog.get("Name") if matched_prog else ""
    prog_overview = matched_prog.get("Overview") if matched_prog else ""
    prog_genres = matched_prog.get("Genres") or [] if matched_prog else []
    prog_img_tag = (matched_prog.get("ImageTags") or {}).get("Primary") if matched_prog else None
    prog_id = matched_prog.get("Id") if matched_prog else None

    final_title = custom_title or prog_title or channel_name
    final_plot = prog_overview

    genres_list: list[str] = []
    for g in prog_genres:
        if g and g not in genres_list:
            genres_list.append(g)
    if custom_genre and custom_genre not in genres_list:
        genres_list.append(custom_genre)
    if "Sports" not in genres_list:
        genres_list.append("Sports")

    poster_bytes: bytes | None = None
    poster_source = "none"

    if prog_id and prog_img_tag:
        img_data = jf_get_image_bytes(prog_id)
        if img_data:
            poster_bytes = img_data
            poster_source = f"programme image ({prog_id})"

    if not poster_bytes and channel_id and channel_img_tag:
        img_data = jf_get_image_bytes(channel_id)
        if img_data:
            poster_bytes = img_data
            poster_source = f"channel logo ({channel_id})"

    has_full_metadata = bool(final_plot and final_plot.strip()) and bool(genres_list) and bool(poster_bytes)

    return {
        "title": final_title,
        "plot": final_plot,
        "genres": genres_list,
        "poster_bytes": poster_bytes,
        "poster_source": poster_source,
        "has_full_metadata": has_full_metadata,
        "lockdata": has_full_metadata,
        "channel_matched": channel_name,
        "prog_matched": prog_title,
    }


def calculate_hard_cap(
    start_dt: datetime,
    duration_sec: int,
    max_extension_sec: int,
    fixed_pad_sec: int,
    fixture: dict[str, Any] | None,
    self_booking_id: str | None = None,
) -> tuple[int, datetime, str, bool, str]:
    """Calculate the hard cap duration and end time, clamped to following timers."""
    start_utc = start_dt.astimezone(timezone.utc)
    nominal_end_utc = start_utc + timedelta(seconds=duration_sec)

    if fixture:
        if fixture.get("completed") or fixture.get("state") == "post":
            potential_ext = 0
            detail = fixture.get("status_detail") or "completed"
            ext_reason = f"ESPN fixture is final ({detail}) -> 0s extension"
        else:
            potential_ext = max_extension_sec
            state_val = fixture.get("state")
            ext_reason = f"ESPN fixture active/upcoming (state={state_val}) -> {max_extension_sec}s max extension"
    else:
        potential_ext = fixed_pad_sec
        ext_reason = f"No ESPN fixture -> {fixed_pad_sec}s fixed pad"

    target_end_utc = nominal_end_utc + timedelta(seconds=potential_ext)

    upcoming_events: list[tuple[datetime, str]] = []
    timers_data = jf_api("/LiveTv/Timers")
    if timers_data and isinstance(timers_data, dict):
        for t in timers_data.get("Items", []):
            if t.get("Status") in ("Completed", "Cancelled", "Error"):
                continue
            try:
                t_s = datetime.fromisoformat(t["StartDate"].replace("Z", "+00:00")) - timedelta(seconds=t.get("PrePaddingSeconds", 0))
                if t_s >= start_utc:
                    name = t.get("Name", "unnamed")
                    upcoming_events.append((t_s, f"Jellyfin timer '{name}'"))
            except Exception:
                continue

    if MCT_BOOKINGS_FILE.exists():
        try:
            bookings_data = json.loads(MCT_BOOKINGS_FILE.read_text())
            if isinstance(bookings_data, list):
                for b in bookings_data:
                    if b.get("status") in ("cancelled", "canceled", "done", "error"):
                        continue
                    # Our own booking starts exactly at start_utc, so the b_s >=
                    # start_utc test below matches it and clamps the extension to
                    # zero -- silently discarding auto-extend for every scheduled
                    # capture (extra innings would have been cut off).
                    if self_booking_id and str(b.get("id")) == str(self_booking_id):
                        continue
                    try:
                        b_s = datetime.fromisoformat(b["start"]).astimezone(timezone.utc)
                        if b_s >= start_utc:
                            btitle = b.get("title") or b.get("name") or "unnamed"
                            upcoming_events.append((b_s, f"MCT booking '{btitle}'"))
                    except Exception:
                        continue
        except Exception:
            pass

    clamped = False
    clamp_info = ""
    if upcoming_events:
        earliest_t, label = min(upcoming_events, key=lambda x: x[0])
        if target_end_utc > earliest_t:
            clamped = True
            t_str = earliest_t.astimezone(LOCAL_TZ).strftime("%Y-%m-%d %H:%M:%S")
            old_str = target_end_utc.astimezone(LOCAL_TZ).strftime("%Y-%m-%d %H:%M:%S")
            clamp_info = f"Clamped by {label} at {t_str} (was {old_str})"
            target_end_utc = earliest_t

    hard_cap_sec = max(duration_sec, int((target_end_utc - start_utc).total_seconds()))
    return hard_cap_sec, target_end_utc, ext_reason, clamped, clamp_info


def build_nfo_xml(title: str, start_dt: datetime, plot: str, genres: list[str], lockdata: bool) -> str:
    xml_lines = [
        '<?xml version="1.0" encoding="utf-8" standalone="yes"?>',
        '<movie>',
        f'  <title>{html.escape(title)}</title>',
        f'  <dateadded>{start_dt.strftime("%Y-%m-%d %H:%M:%S")}</dateadded>',
    ]
    if plot and plot.strip():
        xml_lines.append(f'  <plot>{html.escape(plot.strip())}</plot>')
    else:
        xml_lines.append('  <plot />')

    for g in genres:
        if g:
            xml_lines.append(f'  <genre>{html.escape(g)}</genre>')

    xml_lines.append(f'  <lockdata>{"true" if lockdata else "false"}</lockdata>')
    xml_lines.append('</movie>\n')
    return '\n'.join(xml_lines)


def get_ct_file_size(path_in_ct: str) -> int:
    """Return size in bytes of file inside CT 105, or -1 if missing."""
    res = subprocess.run(
        ["/usr/sbin/pct", "exec", CT_ID, "--", "stat", "-c", "%s", path_in_ct],
        capture_output=True, text=True
    )
    if res.returncode == 0 and res.stdout.strip().isdigit():
        return int(res.stdout.strip())
    return -1


def get_ct_file_mtime(path_in_ct: str) -> float:
    """Return mtime epoch of file inside CT 105, or -1.0 if missing."""
    res = subprocess.run(
        ["/usr/sbin/pct", "exec", CT_ID, "--", "stat", "-c", "%Y", path_in_ct],
        capture_output=True, text=True
    )
    if res.returncode == 0 and res.stdout.strip().isdigit():
        return float(res.stdout.strip())
    return -1.0


def sweep_orphans(threshold_hours: float = 1.0, dry_run: bool = False) -> tuple[int, int]:
    """Scan /srv/media-core/media/recordings/ for *.raw.ts orphans.

    Rules:
    1. Active capture (mtime within 10min and active booking/unit running): KEEP (do not touch).
    2. Redundant raw file (clean .ts already exists and size > 0): SWEEP (remove .raw.ts).
    3. Unusable stub (<1MB or 0 bytes) with terminal booking or age > threshold: SWEEP (remove .raw.ts).
    4. Usable orphan (>=1MB) whose capture stopped/exited:
       PROMOTE to clean .ts (via pre-remux or direct move), write sidecars/NFO if needed,
       enqueue to comskip, and refresh Jellyfin.

    Returns (swept_count, promoted_count).
    """
    res = subprocess.run(
        ["/usr/sbin/pct", "exec", CT_ID, "--", "find", "/srv/media-core/media/recordings", "-name", "*.raw.ts"],
        capture_output=True, text=True
    )
    if res.returncode != 0 or not res.stdout.strip():
        return 0, 0

    raw_files = [line.strip() for line in res.stdout.strip().splitlines() if line.strip()]
    if not raw_files:
        return 0, 0

    bookings = []
    if MCT_BOOKINGS_FILE.exists():
        try:
            bookings = json.loads(MCT_BOOKINGS_FILE.read_text())
        except Exception:
            bookings = []

    active_units = set()
    try:
        u_res = subprocess.run(["systemctl", "list-units", "mct-*", "--state=active", "--no-legend", "--plain"],
                               capture_output=True, text=True)
        for u_line in u_res.stdout.splitlines():
            parts = u_line.strip().split()
            if parts:
                active_units.add(parts[0])
    except Exception:
        pass

    now_epoch = time.time()
    threshold_sec = max(600, int(threshold_hours * 3600))
    swept_count = 0
    promoted_count = 0

    for raw_ct_path in raw_files:
        raw_size = get_ct_file_size(raw_ct_path)
        raw_mtime = get_ct_file_mtime(raw_ct_path)
        age_sec = now_epoch - raw_mtime if raw_mtime > 0 else 999999

        # Rule 1: never touch a file that is still being written.
        #
        # A recent mtime is now a KEEP in its own right, not merely a
        # precondition for the unit lookup below. On 2026-09-04 that lookup
        # compared a booking's bare unit name against systemctl output that
        # carries the ".service" suffix, so it never matched: the sweep promoted
        # a capture that was 8 minutes into a 15-minute recording, pre-remuxed
        # the raw file and unlinked it while ffmpeg still held it open. ffmpeg
        # went on writing to a deleted inode and everything after that moment was
        # lost. Tonight's 3h15m capture would have been hit 13 times.
        is_active = age_sec < 600
        if not is_active:
            for b in bookings:
                if b.get("status") == "running":
                    unit = (b.get("unit") or "").removesuffix(".service")
                    if unit and any(u.removesuffix(".service") == unit for u in active_units):
                        is_active = True
                        break
                    if not unit:
                        is_active = True
                        break
        if is_active:
            log(f"[Orphan-Guard] Keeping active recording raw capture: {raw_ct_path} (mtime {age_sec:.0f}s ago)")
            continue

        # Rule 2: Clean counterpart already exists
        clean_ct_path = raw_ct_path[:-7] + ".ts"
        clean_size = get_ct_file_size(clean_ct_path)
        if clean_size > 0:
            log(f"[Orphan-Sweep] Sweeping redundant raw file: {raw_ct_path} (clean file exists: {clean_size} bytes)")
            if not dry_run:
                subprocess.run(["/usr/sbin/pct", "exec", CT_ID, "--", "rm", "-f", raw_ct_path], check=False)
            swept_count += 1
            continue

        # Rule 3: Unusable stub (<1MB)
        MIN_USABLE = 1_000_000
        if raw_size < MIN_USABLE:
            log(f"[Orphan-Sweep] Sweeping unusable raw stub: {raw_ct_path} ({raw_size} bytes)")
            if not dry_run:
                subprocess.run(["/usr/sbin/pct", "exec", CT_ID, "--", "rm", "-f", raw_ct_path], check=False)
            swept_count += 1
            continue

        # Rule 4: Usable capture (>=1MB) whose capture stopped/exited -> Promote
        log(f"[Orphan-Sweep] Promoting usable orphan capture: {raw_ct_path} ({raw_size} bytes) -> {clean_ct_path}")
        if not dry_run:
            raw_container_path = raw_ct_path.replace("/srv/media-core", "")
            clean_container_path = clean_ct_path.replace("/srv/media-core", "")
            remux_cmd = [
                "/usr/sbin/pct", "exec", CT_ID, "--",
                "docker", "exec", "jellyfin",
                "/usr/lib/jellyfin-ffmpeg/ffmpeg", "-y", "-v", "error",
                "-err_detect", "ignore_err",
                "-fflags", "+genpts+discardcorrupt",
                "-i", raw_container_path,
                "-c", "copy",
                "-avoid_negative_ts", "make_zero",
                clean_container_path,
            ]
            res_remux = subprocess.run(remux_cmd, capture_output=True, text=True)
            if res_remux.returncode == 0 and get_ct_file_size(clean_ct_path) > 0:
                subprocess.run(["/usr/sbin/pct", "exec", CT_ID, "--", "rm", "-f", raw_ct_path], check=False)
            else:
                subprocess.run(["/usr/sbin/pct", "exec", CT_ID, "--", "mv", "-f", raw_ct_path, clean_ct_path], check=False)

            nfo_ct_path = raw_ct_path[:-7] + ".nfo"
            if get_ct_file_size(nfo_ct_path) <= 0:
                base_name = Path(clean_ct_path).stem
                nfo_xml = f'<?xml version="1.0" encoding="utf-8" standalone="yes"?>\n<movie>\n  <title>{html.escape(base_name)}</title>\n  <lockdata>false</lockdata>\n</movie>\n'
                subprocess.run(["/usr/sbin/pct", "exec", CT_ID, "--", "sh", "-c", f"cat > '{nfo_ct_path}'"],
                               input=nfo_xml, text=True, check=False)

            subprocess.run(["/usr/sbin/pct", "exec", CT_ID, "--", "sh", "-c",
                            f"echo '{clean_container_path}' >> /srv/media-core/media/recordings/.postprocess/queue"],
                           check=False)
            jf_api("/Library/Refresh", method="POST")

        promoted_count += 1

    return swept_count, promoted_count


def probe_ct_duration(path_in_ct: str) -> float:
    """Probe duration of media file in seconds inside CT 105."""
    cmd = [
        "/usr/sbin/pct", "exec", CT_ID, "--",
        "docker", "exec", "jellyfin",
        "/usr/lib/jellyfin-ffmpeg/ffprobe", "-v", "error",
        "-show_entries", "format=duration",
        "-of", "default=noprint_wrappers=1:nokey=1",
        path_in_ct,
    ]
    try:
        res = subprocess.run(cmd, capture_output=True, text=True, timeout=30)
        if res.returncode == 0 and res.stdout.strip():
            return float(res.stdout.strip())
    except Exception:
        pass
    return -1.0


def dedupe_base_file(ct_dir: str, base: str) -> str:
    """Keep same-day recordings distinct without uglifying the common case.

    Dropping the clock from the filename (2026-09-06 rather than
    2026_09_06_00_40_00) means two recordings of the same fixture on the same
    day would collide -- a baseball doubleheader being the real case. Only then
    do we suffix, and we suffix in game order: ' G1', ' G2', ... The single-game
    case, which is nearly all of them, stays clean.
    """
    probe = subprocess.run(
        ["/usr/sbin/pct", "exec", CT_ID, "--", "sh", "-c",
         f"ls -1 '{ct_dir}' 2>/dev/null"],
        capture_output=True, text=True,
    )
    existing = probe.stdout or ""
    if f"{base}." not in existing and f"{base} G" not in existing:
        return base
    # A file for this fixture/day already exists -> this is game 2 (or later).
    # Rename the incumbent to ' G1' the first time, so the pair reads G1/G2.
    if f"{base} G1" not in existing:
        subprocess.run(
            ["/usr/sbin/pct", "exec", CT_ID, "--", "sh", "-c",
             f"for f in '{ct_dir}/{base}'.*; do [ -e \"$f\" ] || continue; "
             f"ext=\"${{f##*.}}\"; mv \"$f\" '{ct_dir}/{base} G1'.\"$ext\"; done"],
            capture_output=True, text=True,
        )
        log(f"Same-day collision on '{base}': renamed the earlier recording to '{base} G1'")
        return f"{base} G2"
    n = 2
    while f"{base} G{n}" in existing:
        n += 1
    return f"{base} G{n}"


def derive_stitched_path_name(clean_path: str) -> str:
    mod = get_sports_dvr_auto_module()
    if mod and hasattr(mod, "derive_stitched_path"):
        return mod.derive_stitched_path(clean_path)
    p = Path(clean_path)
    return str(p.with_name(f"{p.stem}.mkv"))


def finalize_and_promote_capture(
    raw_path: str,
    clean_path: str,
    preremux_cmd: list[str],
    nfo_path: str,
    poster_path: str,
    nfo_content: str,
    meta: dict,
    duration_sec: int = 0,
    stopped_cleanly: bool = False,
    interrupted: bool = False,
    is_abnormal: bool = False,
    failure_reason: str = "",
) -> tuple[bool, bool]:
    """Normalise/promote raw capture, create sidecars, enqueue, and remove raw file.

    If abnormal exit occurred (ffmpeg non-zero, unit stopped, SIGTERM):
    - Checks file size: if < 1MB (unusable stub), cleans it up and logs leak prevention.
    - If usable (>= 1MB): attempts pre-remux. If pre-remux fails, moves raw file directly
      to clean_path so the recording is never lost.
    - Writes poster and NFO, refreshes Jellyfin, and removes raw capture.

    Returns (promoted, is_success).
    """
    raw_ct_path = f"/srv/media-core{raw_path}"
    clean_ct_path = f"/srv/media-core{clean_path}"
    raw_size = get_ct_file_size(raw_ct_path)

    MIN_USABLE_SIZE = 1_000_000  # 1MB minimum for valid capture
    if raw_size < MIN_USABLE_SIZE:
        log(f"[Orphan-Guard] Raw capture {raw_path} is unusable ({raw_size} bytes, <1MB). Removing orphan stub to prevent disk leak.")
        subprocess.run(["/usr/sbin/pct", "exec", CT_ID, "--", "rm", "-f", raw_ct_path], check=False)
        return False, False

    if is_abnormal:
        log(f"[Orphan-Guard] Abnormal exit ({failure_reason}), but raw capture is usable ({raw_size} bytes). Promoting orphan to preserve game...")

    log(f"Pre-remuxing to normalise DTS: {clean_path}")
    res_remux = subprocess.run(preremux_cmd, capture_output=True, text=True)
    remux_ok = (res_remux.returncode == 0 and get_ct_file_size(clean_ct_path) > 0)

    if remux_ok:
        subprocess.run(["/usr/sbin/pct", "exec", CT_ID, "--", "rm", "-f", raw_ct_path], check=False)
    else:
        err = res_remux.stderr.strip()[-200:] if res_remux.stderr else "unknown error"
        log(f"WARNING: Pre-remux failed ({err}). Falling back to direct promotion of raw file to {clean_path} to preserve capture.")
        subprocess.run(["/usr/sbin/pct", "exec", CT_ID, "--", "mv", "-f", raw_ct_path, clean_ct_path], check=False)

    if meta.get("poster_bytes"):
        try:
            write_poster_cmd = ["/usr/sbin/pct", "exec", CT_ID, "--", "sh", "-c", f"cat > '/srv/media-core{poster_path}'"]
            subprocess.run(write_poster_cmd, input=meta["poster_bytes"], check=True)
            log(f"Wrote poster: {poster_path} ({len(meta['poster_bytes'])} bytes from {meta['poster_source']})")
        except Exception as exc:
            log(f"WARNING: Failed writing poster.jpg: {exc}")

    try:
        write_nfo_cmd = ["/usr/sbin/pct", "exec", CT_ID, "--", "sh", "-c", f"cat > '/srv/media-core{nfo_path}'"]
        subprocess.run(write_nfo_cmd, input=nfo_content, text=True, check=True)
        log(f"Wrote NFO: {nfo_path} (lockdata={meta['lockdata']}, genres={meta['genres']}, plot_len={len(meta['plot'])})")
    except Exception as exc:
        log(f"WARNING: Failed writing NFO: {exc}")

    try:
        enqueue_cmd = ["/usr/sbin/pct", "exec", CT_ID, "--", "sh", "-c", f"echo '{clean_path}' >> /srv/media-core/media/recordings/.postprocess/queue"]
        subprocess.run(enqueue_cmd, check=True)
        log(f"Enqueued for comskip: {clean_path}")
    except Exception as exc:
        log(f"WARNING: Failed enqueuing for comskip: {exc}")

    captured_dur = probe_ct_duration(clean_path)
    if captured_dur <= 0:
        captured_dur = float(duration_sec) if (not is_abnormal and not interrupted) else 0.0

    is_success, verdict_reason = evaluate_capture_success(
        captured_sec=captured_dur,
        requested_sec=duration_sec,
        stopped_cleanly=stopped_cleanly,
        interrupted=interrupted,
    )

    jf_api("/Library/Refresh", method="POST")
    if is_success:
        log(f"Capture preserved and post-processing pipeline complete: {clean_path}")
        log("MCT-RESULT: success")
    else:
        log(f"Partial capture preserved for library: {clean_path}")
        log(f"MCT-RESULT: failed ({verdict_reason})")
        push_loki_alert(f"level=alert source=mct msg='Capture failed: {verdict_reason}'")

    return True, is_success


def concat_and_stitch_segments(
    segment_paths: list[str],
    clean_path: str,
    start_dt: datetime,
    poster_path: str,
    meta: dict[str, Any],
    title: str,
    container_dir: str,
    duration_sec: int = 0,
    stopped_cleanly: bool = False,
    interrupted: bool = False,
) -> tuple[bool, bool]:
    """Stitch multiple segments using sports-dvr-auto's proven concat machinery.

    Follows sports-dvr-auto and process-queue precedents:
    1. perform_ffmpeg_concat: per-segment pre-remux via preremux_segment_on_ct105
       into MKV (with split-stream fallback for torn AAC packets), then concat demuxer.
    2. Guard against MKV concat silent truncation (Line ~2575 in sports-dvr-auto):
       checks that stitched duration matches combined segment duration.
    3. Write NFO and poster for stitched file.
    4. archive_segments: moves raw segments out of /media/recordings into /media/segments-archive
       so they are not indexed as duplicate recordings.
    5. Enqueues the STITCHED file for comskip - not the individual segments.
    6. Never lose a segment: if stitch fails, rescues every individual segment as a playable
       .ts with sidecar NFO and comskip queue entry, and alerts user via Loki.

    Returns (stitched_ok, is_success).
    """
    mod = get_sports_dvr_auto_module()
    if not mod or not hasattr(mod, "perform_ffmpeg_concat"):
        log("ERROR: sports-dvr-auto module unavailable for perform_ffmpeg_concat. Triggering segment rescue.")
        _rescue_segments(segment_paths, start_dt, meta, title, container_dir, poster_path, "sports-dvr-auto unavailable")
        return False, False

    stitched_path = derive_stitched_path_name(clean_path)
    log(f"Stitching {len(segment_paths)} segments into {stitched_path}...")

    # Calculate expected duration to catch silent MKV concat truncation (Line ~2575)
    expected_dur = 0.0
    for s_path in segment_paths:
        d = probe_ct_duration(s_path)
        if d > 0:
            expected_dur += d
    log(f"Combined expected duration across {len(segment_paths)} segments: ~{expected_dur:.1f}s")

    concat_ok, concat_err = mod.perform_ffmpeg_concat(segment_paths, stitched_path)

    if concat_ok:
        stitched_dur = probe_ct_duration(stitched_path)
        log(f"Probed stitched duration: {stitched_dur:.1f}s")
        if expected_dur > 30 and stitched_dur > 0 and stitched_dur < (expected_dur - 15) and stitched_dur < (expected_dur * 0.85):
            concat_ok = False
            concat_err = (f"Stitched duration ({stitched_dur:.1f}s) is significantly shorter than combined "
                          f"segment duration ({expected_dur:.1f}s) -- concat silently truncated at a bad segment")
            log(f"ERROR: {concat_err}")

    if concat_ok:
        # Write stitched NFO
        stitched_nfo_path = str(Path(stitched_path).with_suffix(".nfo"))
        stitched_stem = Path(stitched_path).stem
        stitched_nfo_xml = build_nfo_xml(stitched_stem, start_dt, meta["plot"], meta["genres"], meta["lockdata"])
        try:
            write_nfo_cmd = ["/usr/sbin/pct", "exec", CT_ID, "--", "sh", "-c", f"cat > '/srv/media-core{stitched_nfo_path}'"]
            subprocess.run(write_nfo_cmd, input=stitched_nfo_xml, text=True, check=True)
            log(f"Wrote stitched NFO: {stitched_nfo_path}")
        except Exception as exc:
            log(f"WARNING: Failed writing stitched NFO: {exc}")

        # Write poster
        if meta.get("poster_bytes"):
            try:
                write_poster_cmd = ["/usr/sbin/pct", "exec", CT_ID, "--", "sh", "-c", f"cat > '/srv/media-core{poster_path}'"]
                subprocess.run(write_poster_cmd, input=meta["poster_bytes"], check=True)
                log(f"Wrote poster: {poster_path}")
            except Exception as exc:
                log(f"WARNING: Failed writing poster: {exc}")

        # Archive raw segments out of /media/recordings
        if hasattr(mod, "archive_segments"):
            try:
                archived, failed = mod.archive_segments(segment_paths, clean_path)
                log(f"Archived {len(archived)} segments to /media/segments-archive (failed: {len(failed)})")
            except Exception as exc:
                log(f"WARNING: archive_segments encountered error: {exc}")

        # Enqueue the STITCHED file for comskip - NOT the segments
        try:
            enqueue_cmd = ["/usr/sbin/pct", "exec", CT_ID, "--", "sh", "-c",
                           f"echo '{stitched_path}' >> /srv/media-core/media/recordings/.postprocess/queue"]
            subprocess.run(enqueue_cmd, check=True)
            log(f"Enqueued stitched file for comskip: {stitched_path}")
        except Exception as exc:
            log(f"WARNING: Failed enqueuing stitched file for comskip: {exc}")

        final_dur = stitched_dur if (stitched_dur is not None and stitched_dur > 0) else expected_dur
        is_success, verdict_reason = evaluate_capture_success(
            captured_sec=final_dur,
            requested_sec=duration_sec,
            stopped_cleanly=stopped_cleanly,
            interrupted=interrupted,
        )

        jf_api("/Library/Refresh", method="POST")
        if is_success:
            log(f"Capture stitched and post-processing pipeline complete: {stitched_path}")
            log("MCT-RESULT: success")
        else:
            log(f"Partial stitched capture preserved for library: {stitched_path}")
            log(f"MCT-RESULT: failed ({verdict_reason})")
            push_loki_alert(f"level=alert source=mct msg='Capture failed for {title}: {verdict_reason}'")

        return True, is_success

    # Stitch failed: rescue every segment
    _rescue_segments(segment_paths, start_dt, meta, title, container_dir, poster_path, concat_err)
    return False, False


def _rescue_segments(
    segment_paths: list[str],
    start_dt: datetime,
    meta: dict[str, Any],
    title: str,
    container_dir: str,
    poster_path: str,
    reason: str,
) -> None:
    """Rescue segments when stitch fails. Precedent: rescue_original in process-queue.py.
    Never lose a segment: a rescued partial beats a silent loss.
    """
    log(f"ALERT: Stitch failed ({reason}). Preserving all {len(segment_paths)} individual segments in library.")
    push_loki_alert(f"level=alert source=mct msg='Stitch failed for {title}: {reason} -- segments rescued'")

    for idx, seg_p in enumerate(segment_paths, start=1):
        seg_clean_p = seg_p[:-7] + ".ts" if seg_p.endswith(".raw.ts") else (seg_p if seg_p.endswith(".ts") else f"{seg_p}.ts")
        seg_raw_ct = f"/srv/media-core{seg_p}"
        seg_clean_ct = f"/srv/media-core{seg_clean_p}"

        log(f"[Rescue] Promoting segment {idx}: {seg_p} -> {seg_clean_p}")
        remux_cmd = [
            "/usr/sbin/pct", "exec", CT_ID, "--",
            "docker", "exec", "jellyfin",
            "/usr/lib/jellyfin-ffmpeg/ffmpeg", "-y", "-v", "error",
            "-err_detect", "ignore_err",
            "-fflags", "+genpts+discardcorrupt",
            "-i", seg_p,
            "-c", "copy",
            "-avoid_negative_ts", "make_zero",
            seg_clean_p,
        ]
        res_remux = subprocess.run(remux_cmd, capture_output=True, text=True)
        if res_remux.returncode == 0 and get_ct_file_size(seg_clean_ct) > 0:
            if seg_raw_ct != seg_clean_ct:
                subprocess.run(["/usr/sbin/pct", "exec", CT_ID, "--", "rm", "-f", seg_raw_ct], check=False)
        else:
            # Fallback: direct move, preserving bytes without parsing
            log(f"[Rescue] Pre-remux failed on {seg_p}, using direct move fallback")
            if seg_raw_ct != seg_clean_ct:
                subprocess.run(["/usr/sbin/pct", "exec", CT_ID, "--", "mv", "-f", seg_raw_ct, seg_clean_ct], check=False)

        seg_nfo_ct = str(Path(seg_clean_ct).with_suffix(".nfo"))
        seg_stem = Path(seg_clean_p).stem
        seg_nfo_xml = build_nfo_xml(seg_stem, start_dt, meta["plot"], meta["genres"], meta["lockdata"])
        subprocess.run(["/usr/sbin/pct", "exec", CT_ID, "--", "sh", "-c", f"cat > '{seg_nfo_ct}'"],
                       input=seg_nfo_xml, text=True, check=False)

        subprocess.run(["/usr/sbin/pct", "exec", CT_ID, "--", "sh", "-c",
                        f"echo '{seg_clean_p}' >> /srv/media-core/media/recordings/.postprocess/queue"],
                       check=False)

    if meta.get("poster_bytes"):
        try:
            write_poster_cmd = ["/usr/sbin/pct", "exec", CT_ID, "--", "sh", "-c", f"cat > '/srv/media-core{poster_path}'"]
            subprocess.run(write_poster_cmd, input=meta["poster_bytes"], check=True)
        except Exception:
            pass

    jf_api("/Library/Refresh", method="POST")
    log(f"All {len(segment_paths)} partial segments promoted and rescued. Playable in Jellyfin.")
    log(f"MCT-RESULT: failed (Stitch failed: {reason})")


def main() -> int:
    parser = argparse.ArgumentParser(description="Manual Capture Tool (MCT)")
    parser.add_argument("-c", "--channel", help="Channel number or name (e.g. 121 or 'Milwaukee Brewers HD')")
    parser.add_argument("-d", "--duration", help="Duration (e.g. 3h15m, 195m, 11700)")
    parser.add_argument("-t", "--title", help="Recording title (e.g. 'Milwaukee Brewers at Chicago Cubs')")
    parser.add_argument("--category", default="Sports", help="Category folder (default: Sports)")
    parser.add_argument("--genre", default="Sports", help="Genre for NFO (default: Sports)")
    parser.add_argument("--start-time", help="ISO start time for window calculation / naming (default: now)")
    parser.add_argument("--max-extension", default="90m", help="Maximum auto-extension duration (default: 90m)")
    parser.add_argument("--fixed-pad", default="5m", help="Fixed pad duration when no ESPN fixture exists (default: 5m)")
    parser.add_argument("--poll-interval", type=int, default=120, help="Supervisor ESPN polling interval in seconds (default: 120)")
    parser.add_argument("--booking-id", help="mct-bookings.json id of the booking this run fulfils, so it is not treated as a conflict")
    parser.add_argument("--dry-run", action="store_true", help="Show planned action without capturing or touching tuner")
    parser.add_argument("--sweep-orphans", action="store_true", help="Sweep or promote orphaned .raw.ts recordings")
    parser.add_argument("--threshold-hours", type=float, default=1.0, help="Age threshold in hours before sweeping terminal stubs (default: 1.0)")
    parser.add_argument("--restart-and-stitch", "--stitch", dest="restart_and_stitch", action="store_true", default=True,
                        help="Restart interrupted captures into segments and stitch at completion (default: enabled)")
    parser.add_argument("--no-restart-and-stitch", "--no-stitch", dest="restart_and_stitch", action="store_false",
                        help="Disable restart-and-stitch (single-shot mode)")
    parser.add_argument("--max-restarts", type=int, default=MAX_RESTARTS,
                        help="Maximum restart attempts (default: None, bounded only by window)")
    parser.add_argument("--restart-backoff", type=float, default=RESTART_BACKOFF_BASE_SEC,
                        help=f"Base backoff in seconds after content-yielding segment (default: {RESTART_BACKOFF_BASE_SEC}s)")
    parser.add_argument("--initial-dead-backoff", type=float, default=INITIAL_DEAD_BACKOFF_SEC,
                        help=f"Initial backoff in seconds after a dead restart (default: {INITIAL_DEAD_BACKOFF_SEC}s)")
    parser.add_argument("--max-backoff", type=float, default=MAX_BACKOFF_SEC,
                        help=f"Maximum backoff in seconds for dead restarts (default: {MAX_BACKOFF_SEC}s)")
    parser.add_argument("--min-restart-remaining", type=int, default=MIN_RESTART_REMAINING_SEC,
                        help=f"Minimum remaining capture window in seconds to allow restart (default: {MIN_RESTART_REMAINING_SEC}s)")
    parser.add_argument("--stream-url",
                        help="Direct stream URL override (for tests, bypasses playlist and tuner)")
    args = parser.parse_args()

    env_stitch = os.environ.get("MCT_RESTART_AND_STITCH")
    if env_stitch is not None:
        if env_stitch.lower() in ("0", "false", "no"):
            args.restart_and_stitch = False
        elif env_stitch.lower() in ("1", "true", "yes"):
            args.restart_and_stitch = True

    if args.sweep_orphans:
        swept, promoted = sweep_orphans(threshold_hours=args.threshold_hours, dry_run=args.dry_run)
        log(f"Orphan sweep complete: {swept} swept, {promoted} promoted.")
        return 0

    if not args.stream_url and (not args.channel or not args.duration):
        parser.error("-c/--channel and -d/--duration are required for capture.")
    elif args.stream_url and not args.duration:
        parser.error("-d/--duration is required for capture.")

    try:
        duration_sec = parse_duration(args.duration)
    except ValueError as exc:
        log(f"ERROR: {exc}")
        push_loki_alert(f"level=alert source=mct msg='Invalid duration: {args.duration}'")
        return 1

    try:
        max_ext_sec = parse_duration(args.max_extension)
    except ValueError as exc:
        log(f"ERROR: Invalid max-extension: {exc}")
        return 1

    try:
        fixed_pad_sec = parse_duration(args.fixed_pad)
    except ValueError as exc:
        log(f"ERROR: Invalid fixed-pad: {exc}")
        return 1

    try:
        sweep_orphans(threshold_hours=args.threshold_hours, dry_run=args.dry_run)
    except Exception as exc:
        log(f"Warning: startup orphan sweep encountered error: {exc}")

    if args.stream_url:
        ch = {"chno": "999", "name": args.channel or "Test Stream", "url": args.stream_url}
    else:
        try:
            channels = parse_playlist()
        except Exception as exc:
            log(f"ERROR: Could not read playlist from CT 105: {exc}")
            push_loki_alert(f"level=alert source=mct msg='Playlist read failure: {exc}'")
            return 1

        ch = resolve_channel(args.channel, channels)
        if not ch:
            log(f"ERROR: Could not resolve channel '{args.channel}' in playlist.m3u")
            push_loki_alert(f"level=alert source=mct msg='Channel resolution failure for {args.channel}'")
            return 1

    now = datetime.now(LOCAL_TZ)
    if args.start_time:
        try:
            start_dt = datetime.fromisoformat(args.start_time)
            if start_dt.tzinfo is None:
                start_dt = start_dt.replace(tzinfo=LOCAL_TZ)
        except ValueError:
            start_dt = now
    else:
        start_dt = now

    nominal_end_dt = start_dt + timedelta(seconds=duration_sec)

    # 1. EPG & Artwork lookup
    meta = lookup_epg_and_artwork(ch, start_dt, custom_title=args.title, custom_genre=args.genre)
    title = meta["title"]
    # 2026-09-06: filenames are read by humans on a tile, so collapse the double
    # spaces that EPG titles routinely carry ("Live  BL") and use an ISO date
    # rather than a full underscore timestamp -- it sorts correctly and reads
    # cleanly. Same-day collisions are handled by dedupe_base_file() below.
    safe_title = re.sub(r'[/\\:*?"<>|]', "", title)
    safe_title = re.sub(r"\s+", " ", safe_title).strip()
    ts_str = start_dt.strftime("%Y-%m-%d")

    container_dir = f"/media/recordings/{args.category}/{safe_title}"
    ct105_dir = f"/srv/media-core{container_dir}"
    base_file = dedupe_base_file(ct105_dir, f"{safe_title} {ts_str}")
    raw_path = f"{container_dir}/{base_file}.raw.ts"
    clean_path = f"{container_dir}/{base_file}.ts"
    nfo_path = f"{container_dir}/{base_file}.nfo"
    poster_path = f"{container_dir}/poster.jpg"
    queue_entry = clean_path

    # 2. Check exclusion for nominal recording window
    MAX_WAIT_SECONDS = 12 * 3600
    lead = (start_dt - datetime.now(LOCAL_TZ)).total_seconds()
    if lead > MAX_WAIT_SECONDS and not args.dry_run:
        log(f"REFUSING CAPTURE: start time is {lead/3600:.1f}h away (max {MAX_WAIT_SECONDS/3600:.0f}h). "
            f"Book it through the DVR dashboard instead of holding a process open that long.")
        return 2

    if not args.stream_url:
        ok, err = check_exclusion(start_dt.astimezone(timezone.utc), nominal_end_dt.astimezone(timezone.utc),
                                  getattr(args, 'booking_id', None))
        if not ok:
            log(f"REFUSING CAPTURE: {err}")
            push_loki_alert(f"level=alert source=mct msg='Refusing capture: {err}'")
            return 2

    # 3. ESPN fixture matching and Hard Cap calculation
    espn_games = load_espn_schedule()
    fixture = find_espn_fixture(title, ch["name"], start_dt, espn_games)
    hard_cap_sec, hard_cap_end_dt, ext_reason, is_clamped, clamp_info = calculate_hard_cap(
        start_dt, duration_sec, max_ext_sec, fixed_pad_sec, fixture,
        getattr(args, 'booking_id', None),
    )

    nfo_content = build_nfo_xml(safe_title, start_dt, meta["plot"], meta["genres"], meta["lockdata"])

    ffmpeg_cmd = [
        "/usr/sbin/pct", "exec", CT_ID, "--",
        "docker", "exec", "-i", "jellyfin",
        "/usr/lib/jellyfin-ffmpeg/ffmpeg", "-y",
        "-nostats", "-loglevel", "error",
        "-reconnect_delay_max", "120",
        "-reconnect_delay_total_max", "1800",
        "-reconnect_max_retries", "-1",
        "-reconnect", "1", "-reconnect_streamed", "1",
        "-reconnect_on_network_error", "1",
        "-rw_timeout", "15000000",
        "-i", ch["url"],
        "-t", str(hard_cap_sec),
        "-c", "copy",
        raw_path,
    ]

    preremux_cmd = [
        "/usr/sbin/pct", "exec", CT_ID, "--",
        "docker", "exec", "jellyfin",
        "/usr/lib/jellyfin-ffmpeg/ffmpeg", "-y", "-v", "error",
        "-err_detect", "ignore_err",
        "-fflags", "+genpts+discardcorrupt",
        "-i", raw_path,
        "-c", "copy",
        "-avoid_negative_ts", "make_zero",
        clean_path,
    ]

    if args.dry_run:
        log("=== MCT DRY RUN ===")
        log(f"Channel:        {ch['chno']} {ch['name']} (Jellyfin: {meta['channel_matched']})")
        log(f"Stream URL:     {ch['url']}")
        log(f"Start Time:     {start_dt.isoformat()}")
        log(f"Nominal Dur:    {duration_sec}s ({timedelta(seconds=duration_sec)}) -> {nominal_end_dt.isoformat()}")
        if fixture:
            log(f"ESPN Fixture:   {fixture['team']} - {fixture['name']} (state={fixture['state']}, detail={fixture['status_detail'] or 'N/A'})")
        else:
            log("ESPN Fixture:   None (No matching fixture found)")
        log(f"Auto-Extend:    {ext_reason}")
        if is_clamped:
            log(f"Clamp Warning:  {clamp_info}")
        stitch_info = (f"ENABLED ({'max ' + str(args.max_restarts) + ' restarts' if args.max_restarts else 'window-bounded'}, "
                       f"{args.restart_backoff}s base backoff, {args.initial_dead_backoff}s-{args.max_backoff}s dead adaptive)") if args.restart_and_stitch else "DISABLED (single-shot)"
        log(f"Restart-Stitch: {stitch_info}")
        log(f"Target NFO:     {nfo_path}")
        log(f"Target Poster:  {poster_path} (Source: {meta['poster_source']}, Bytes: {len(meta['poster_bytes']) if meta['poster_bytes'] else 0})")
        log(f"Metadata Lock:  {meta['lockdata']} (plot={'yes' if meta['plot'] else 'empty'}, genres={meta['genres']})")
        log(f"Comskip Q:      {queue_entry}")
        log(f"Exclusion:      {'SKIPPED (stream-url mode)' if args.stream_url else 'PASS (no overlapping Jellyfin timers or active recordings)'}")
        log(f"FFmpeg CMD:     {' '.join(ffmpeg_cmd)}")
        log(f"Pre-remux:      {' '.join(preremux_cmd)}")
        return 0

    if lead > 1 and not args.stream_url:
        log(f"Waiting {lead:.0f}s until {start_dt.isoformat()} before opening the tuner")
        time.sleep(lead)
        ok, err = check_exclusion(start_dt.astimezone(timezone.utc), nominal_end_dt.astimezone(timezone.utc),
                                  getattr(args, 'booking_id', None))
        if not ok:
            log(f"REFUSING CAPTURE: {err} (appeared while waiting for start time)")
            push_loki_alert(f"level=alert source=mct msg='Refusing capture after wait: {err}'")
            return 2

    log(f"Starting capture: {title} on {ch['chno']} {ch['name']} (Nominal: {duration_sec}s, Hard Cap: {hard_cap_sec}s)")
    if fixture:
        log(f"Supervising ESPN game '{fixture['name']}' (state={fixture['state']}, detail={fixture['status_detail']})")
    if is_clamped:
        log(f"Extension window: {clamp_info}")

    subprocess.run(["/usr/sbin/pct", "exec", CT_ID, "--", "mkdir", "-p", ct105_dir], check=True)

    segment_paths: list[str] = []
    restart_count = 0
    consecutive_dead_restarts = 0
    segment_idx = 1
    start_mono = time.monotonic()
    interrupted = [False]
    stopped_cleanly = False
    delay_extended = [False]  # list so it survives the segment loop
    current_p: list[subprocess.Popen | None] = [None]
    last_returncode = 0
    last_err_msg = ""
    last_ran_to_hard_cap = False

    def _sig_handler(signum, frame):
        log(f"[Supervisor] Caught signal {signum}, initiating clean capture shutdown...")
        interrupted[0] = True
        p = current_p[0]
        try:
            if p and p.stdin and not p.stdin.closed:
                p.stdin.write(b"q\n")
                p.stdin.flush()
                p.stdin.close()
        except Exception:
            pass

    prev_sigterm = signal.signal(signal.SIGTERM, _sig_handler)
    prev_sigint = signal.signal(signal.SIGINT, _sig_handler)

    try:
        while True:
            elapsed_total = time.monotonic() - start_mono
            remaining_sec = int(hard_cap_sec - elapsed_total)

            if remaining_sec < args.min_restart_remaining and segment_idx > 1:
                log(f"[Supervisor] Remaining capture window ({remaining_sec}s) is below threshold ({args.min_restart_remaining}s). Ending capture.")
                break

            if segment_idx == 1:
                seg_raw_path = raw_path
                ffmpeg_err_path = f"/var/log/mct/ffmpeg-{base_file}.err"
            else:
                seg_raw_path = f"{container_dir}/{base_file}.seg{segment_idx}.raw.ts"
                ffmpeg_err_path = f"/var/log/mct/ffmpeg-{base_file}-seg{segment_idx}.err"

            seg_ffmpeg_cmd = [
                "/usr/sbin/pct", "exec", CT_ID, "--",
                "docker", "exec", "-i", "jellyfin",
                "/usr/lib/jellyfin-ffmpeg/ffmpeg", "-y",
                "-nostats", "-loglevel", "error",
                "-reconnect_delay_max", "120",
                "-reconnect_delay_total_max", "1800",
                "-reconnect_max_retries", "-1",
                "-reconnect", "1", "-reconnect_streamed", "1",
                "-reconnect_on_network_error", "1",
                "-rw_timeout", "15000000",
                "-i", ch["url"],
                "-t", str(remaining_sec),
                "-c", "copy",
                seg_raw_path,
            ]

            if segment_idx > 1:
                log(f"[Restart-Guard] Launching segment {segment_idx} (target duration: {remaining_sec}s, output: {seg_raw_path})")

            ffmpeg_err_f = open(ffmpeg_err_path, "wb")
            p = subprocess.Popen(seg_ffmpeg_cmd, stdin=subprocess.PIPE,
                                 stdout=subprocess.DEVNULL, stderr=ffmpeg_err_f)
            current_p[0] = p

            is_supervising = fixture is not None and not (fixture.get("completed") or fixture.get("state") == "post")
            if is_supervising:
                while True:
                    poll_start = time.monotonic()
                    while time.monotonic() - poll_start < args.poll_interval:
                        ret = p.poll()
                        if ret is not None or interrupted[0]:
                            break
                        time.sleep(2)

                    if p.poll() is not None or interrupted[0]:
                        break

                    elapsed = time.monotonic() - start_mono
                    try:
                        latest_games = load_espn_schedule()
                        cur_fixture = find_espn_fixture(title, ch["name"], start_dt, latest_games)
                    except Exception as exc:
                        log(f"[Supervisor] ESPN poll error ({exc}), continuing...")
                        continue

                    if not cur_fixture:
                        log("[Supervisor] Fixture no longer visible in ESPN schedule, continuing to hard cap...")
                        continue

                    fixture_state = cur_fixture.get("state")
                    is_completed = bool(cur_fixture.get("completed") or fixture_state == "post")
                    detail = cur_fixture.get("status_detail") or fixture_state or "unknown"

                    if is_completed:
                        log(f"[Supervisor] Game is FINAL ({detail}). Stopping ffmpeg capture cleanly...")
                        try:
                            if p.stdin and not p.stdin.closed:
                                p.stdin.write(b"q\n")
                                p.stdin.flush()
                                p.stdin.close()
                        except Exception as e:
                            log(f"[Supervisor] Failed writing q to stdin: {e}")
                        stopped_cleanly = True
                        break
                    elif elapsed < duration_sec:
                        log(f"[Supervisor] Game status: {detail} (elapsed {int(elapsed)}s / nominal {duration_sec}s)")
                        # On 2026-09-04 ESPN reported "Delayed, Top 1st" on all fifteen polls
                        # and this branch logged it fifteen times and did nothing. A delayed
                        # game has not started, so its content lands later than the window we
                        # computed at launch. Push the deadline out, once, bounded, and never
                        # past a clamp - `ran_to_hard_cap` below compares against this
                        # variable, so extending it turns ffmpeg finishing its -t into a
                        # premature exit that restart-and-stitch continues.
                        if ("delay" in str(detail).lower() or "postpon" in str(detail).lower()) \
                                and not delay_extended[0]:
                            if is_clamped:
                                log(f"[Supervisor] Fixture is delayed ({detail}) but the hard cap is "
                                    f"clamped by a following reservation ({clamp_info}); not extending.")
                                delay_extended[0] = True
                            else:
                                bump = min(MAX_DELAY_EXTENSION_SEC, int(duration_sec * 0.5))
                                hard_cap_sec += bump
                                delay_extended[0] = True
                                log(f"[Supervisor] Fixture is DELAYED ({detail}). Extending the capture "
                                    f"deadline by {bump}s to {hard_cap_sec}s so the delayed content is "
                                    f"still inside the window.")
                                push_loki_alert(
                                    f"level=info source=mct msg='Delayed fixture: extended window by {bump}s for {title}'")
                    elif fixture_state == "in":
                        log(f"[Supervisor] Game is IN PROGRESS ({detail}). Auto-extending capture (elapsed {int(elapsed)}s / hard cap {hard_cap_sec}s)...")
            else:
                while True:
                    ret = p.poll()
                    if ret is not None or interrupted[0]:
                        break
                    time.sleep(2)

            try:
                p.wait(timeout=15 if (stopped_cleanly or interrupted[0]) else None)
            except subprocess.TimeoutExpired:
                log("[Supervisor] ffmpeg did not terminate within 15s of 'q'; sending SIGINT fallback...")
                subprocess.run(["/usr/sbin/pct", "exec", CT_ID, "--", "docker", "exec", "jellyfin",
                                "pkill", "-INT", "-f", seg_raw_path], check=False)
                try:
                    p.wait(timeout=10)
                except subprocess.TimeoutExpired:
                    log("[Supervisor] ffmpeg failed to respond to SIGINT; terminating...")
                    p.kill()
                    p.wait()

            try:
                ffmpeg_err_f.flush()
                ffmpeg_err_f.close()
            except Exception:
                pass

            try:
                with open(ffmpeg_err_path, "rb") as fh:
                    stderr_data = fh.read()
            except Exception:
                stderr_data = b""

            last_returncode = p.returncode
            last_err_msg = stderr_data.decode("utf-8", errors="replace").strip()[-300:]

            seg_ct_path = f"/srv/media-core{seg_raw_path}"
            seg_size = get_ct_file_size(seg_ct_path)
            MIN_USABLE_SIZE = 1_000_000
            is_usable = (seg_size >= MIN_USABLE_SIZE)

            ran_to_hard_cap = (time.monotonic() - start_mono) >= (hard_cap_sec - 5)
            last_ran_to_hard_cap = ran_to_hard_cap
            is_deliberate_stop = stopped_cleanly or interrupted[0]

            if is_deliberate_stop or ran_to_hard_cap:
                if is_usable:
                    segment_paths.append(seg_raw_path)
                    log(f"[Supervisor] Segment {segment_idx} finished cleanly ({seg_size} bytes). Capture complete.")
                elif seg_size > 0:
                    log(f"[Supervisor] Segment {segment_idx} finished but is sub-MB stub ({seg_size} bytes).")
                break

            # Abnormal / premature exit
            log(f"WARNING: ffmpeg capture exited prematurely on segment {segment_idx} with code {p.returncode}: {last_err_msg}")

            if not is_usable:
                consecutive_dead_restarts += 1
                # Archive rather than delete. A stub is evidence: it records that a
                # restart fired and got nothing, which is exactly what you need when
                # reconstructing why a recording came up short. Deleting it destroys
                # the only trace. /media/segments-archive is outside the indexed
                # library, so archived stubs never appear as recordings.
                stub_archive = "/media/segments-archive"
                stamp = datetime.now(LOCAL_TZ).strftime("%Y%m%d-%H%M%S")
                stub_dest = f"{stub_archive}/{Path(seg_raw_path).name}.stub-{stamp}"
                log(f"[Orphan-Guard] Segment {segment_idx} is an unusable stub ({seg_size} bytes < 1MB). "
                    f"Archiving for post-mortem: {stub_dest}")
                subprocess.run(["/usr/sbin/pct", "exec", CT_ID, "--", "mkdir", "-p",
                                f"/srv/media-core{stub_archive}"], check=False)
                mv = subprocess.run(["/usr/sbin/pct", "exec", CT_ID, "--", "mv", "-f",
                                     seg_ct_path, f"/srv/media-core{stub_dest}"],
                                    capture_output=True, text=True)
                if mv.returncode != 0:
                    log(f"[Orphan-Guard] Could not archive stub ({mv.stderr.strip()[:120]}); leaving it in place "
                        f"rather than deleting evidence.")
            else:
                consecutive_dead_restarts = 0
                if segment_idx == 1 and args.restart_and_stitch:
                    # Rename segment 1 to .seg1.raw.ts so all segments in chain are consistently numbered
                    renamed_seg1 = f"{container_dir}/{base_file}.seg1.raw.ts"
                    renamed_ct = f"/srv/media-core{renamed_seg1}"
                    subprocess.run(["/usr/sbin/pct", "exec", CT_ID, "--", "mv", "-f", seg_ct_path, renamed_ct], check=True)
                    seg_raw_path = renamed_seg1
                segment_paths.append(seg_raw_path)
                log(f"[Restart-Guard] Segment {segment_idx} preserved ({seg_size} bytes): {seg_raw_path}")

            if not args.restart_and_stitch:
                log("[Supervisor] Restart-and-stitch disabled. Ending capture.")
                break

            restart_count += 1
            if args.max_restarts is not None and restart_count > args.max_restarts:
                log(f"ERROR: Maximum restart count ({args.max_restarts}) reached against failing stream. Refusing further restarts.")
                push_loki_alert(f"level=alert source=mct msg='Maximum restart limit reached ({args.max_restarts}) for {title}'")
                break

            rem_time = int(hard_cap_sec - (time.monotonic() - start_mono))
            if rem_time < args.min_restart_remaining:
                log(f"[Supervisor] Remaining window ({rem_time}s) below restart threshold ({args.min_restart_remaining}s). Ending capture.")
                break

            current_backoff = get_adaptive_backoff(
                consecutive_dead=consecutive_dead_restarts,
                base_backoff=args.restart_backoff,
                initial_dead=args.initial_dead_backoff,
                max_backoff=args.max_backoff,
            )

            if (rem_time - current_backoff) < args.min_restart_remaining:
                log(f"[Supervisor] Remaining window ({rem_time}s) minus backoff ({current_backoff:.1f}s) below threshold ({args.min_restart_remaining}s). Ending capture.")
                break

            restart_desc = f"{restart_count}" + (f"/{args.max_restarts}" if args.max_restarts is not None else "")
            dead_desc = f", consecutive dead: {consecutive_dead_restarts}" if consecutive_dead_restarts > 0 else " (content reset)"
            log(f"[Restart-Guard] Initiating restart {restart_desc} after {current_backoff:.1f}s backoff{dead_desc} (remaining window: {rem_time}s)...")
            push_loki_alert(f"level=info source=mct msg='Restarting capture segment {segment_idx+1} for {title} (remaining {rem_time}s, backoff {current_backoff:.0f}s)'")

            sleep_start = time.monotonic()
            while time.monotonic() - sleep_start < current_backoff:
                if interrupted[0]:
                    break
                time.sleep(min(1.0, current_backoff - (time.monotonic() - sleep_start)))

            if interrupted[0]:
                log("[Supervisor] Interrupted during restart backoff. Stopping capture.")
                break

            segment_idx += 1

    finally:
        try:
            signal.signal(signal.SIGTERM, prev_sigterm)
            signal.signal(signal.SIGINT, prev_sigint)
        except Exception:
            pass

    # Post-capture processing
    if len(segment_paths) == 0:
        log("ERROR: Capture produced no usable segments (all <1MB or missing).")
        push_loki_alert(f"level=alert source=mct msg='Capture failed with no usable data on {ch['name']}'")
        log("MCT-RESULT: failed (no usable data)")
        return 4

    if len(segment_paths) == 1:
        single_seg = segment_paths[0]
        preremux_cmd = [
            "/usr/sbin/pct", "exec", CT_ID, "--",
            "docker", "exec", "jellyfin",
            "/usr/lib/jellyfin-ffmpeg/ffmpeg", "-y", "-v", "error",
            "-err_detect", "ignore_err",
            "-fflags", "+genpts+discardcorrupt",
            "-i", single_seg,
            "-c", "copy",
            "-avoid_negative_ts", "make_zero",
            clean_path,
        ]
        is_abnormal = (not stopped_cleanly and not interrupted[0] and not last_ran_to_hard_cap)
        if is_abnormal and last_returncode != 0:
            push_loki_alert(f"level=alert source=mct msg='ffmpeg capture failed on {ch['name']}: {last_err_msg[-200:]}'")

        promoted, is_success = finalize_and_promote_capture(
            raw_path=single_seg,
            clean_path=clean_path,
            preremux_cmd=preremux_cmd,
            nfo_path=nfo_path,
            poster_path=poster_path,
            nfo_content=nfo_content,
            meta=meta,
            duration_sec=duration_sec,
            stopped_cleanly=stopped_cleanly,
            interrupted=interrupted[0],
            is_abnormal=is_abnormal,
            failure_reason=f"ffmpeg exit {last_returncode}" if last_returncode != 0 else "premature clean EOF",
        )
        if not promoted or not is_success:
            return 4
        return 0

    # Multi-segment: stitch
    stitched_ok, is_success = concat_and_stitch_segments(
        segment_paths=segment_paths,
        clean_path=clean_path,
        start_dt=start_dt,
        poster_path=poster_path,
        meta=meta,
        title=title,
        container_dir=container_dir,
        duration_sec=duration_sec,
        stopped_cleanly=stopped_cleanly,
        interrupted=interrupted[0],
    )
    if not stitched_ok or not is_success:
        return 4
    return 0


if __name__ == "__main__":
    sys.exit(main())
