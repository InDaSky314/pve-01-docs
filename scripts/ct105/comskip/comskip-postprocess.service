[Unit]
Description=DVR commercial-removal post-processing (comskip queue runner)
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /srv/media-core/comskip/process-queue.py
Nice=15
IOSchedulingClass=idle
# comskip on a 3-4h game can legitimately run a long time
TimeoutStartSec=6h
