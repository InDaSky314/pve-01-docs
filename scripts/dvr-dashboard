#!/usr/bin/env python3
"""Small dashboard: upcoming games, scheduled recordings, and a keep-awake override.

Serves one responsive page plus a JSON API on the LAN and over Tailscale.
Stdlib only -- no web framework, no build step, nothing to keep updated.

  GET  /              the page
  GET  /api/status    everything the page renders
  POST /api/override  {"hours": N}  keep the host up; N<=0 clears

The override writes a timestamp that dvr-clean-shutdown reads, so pressing
the button stops tonight's automatic shutdown. It does NOT hold the mains
timer open -- that is a physical switch and the page says so.

Docs: /root/pve-01-docs/docs/livetv-custom-build-and-updates-20260726.md
"""
from __future__ import annotations

import hashlib
import json
import subprocess
import threading
import urllib.request
from datetime import datetime, timedelta, time as dtime
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path
from zoneinfo import ZoneInfo

LOCAL = ZoneInfo("Europe/Berlin")
PORT = 8099
POWER_ON, POWER_OFF = dtime(4, 57), dtime(22, 24)
SHUTDOWN_AT = dtime(22, 10)

OVERRIDE = Path("/var/lib/dvr-dashboard/override-until")
CT = "105"
NEXTPVR = "http://localhost:8866/service"
JELLYFIN_TIMERS = "/srv/media-core/jellyfin/config/data/livetv/timers.json"
JF_DONE = {"Completed", "Cancelled", "Error"}

LOOKAHEAD_DAYS = 10
DURATION = {"football": timedelta(hours=3, minutes=45),
            "basketball": timedelta(hours=2, minutes=45)}
TEAMS = [
    ("Packers",          "football/nfl",                       "gb"),
    ("Badgers Football", "football/college-football",          "275"),
    ("Badgers Basketball", "basketball/mens-college-basketball", "275"),
    ("Bucks",            "basketball/nba",                     "mil"),
]

_cache: dict = {"at": None, "games": []}
_lock = threading.Lock()


# ---------------------------------------------------------------- helpers
def pct(*args: str, timeout: int = 25) -> str:
    return subprocess.run(["/usr/sbin/pct", "exec", CT, "--", *args],
                          capture_output=True, text=True,
                          timeout=timeout, check=True).stdout


def outside_window(start: datetime, end: datetime) -> bool:
    cur = start
    while cur <= end:
        if not (POWER_ON <= cur.time() <= POWER_OFF):
            return True
        cur += timedelta(minutes=15)
    return not (POWER_ON <= end.time() <= POWER_OFF)


def override_until() -> datetime | None:
    try:
        ts = datetime.fromisoformat(OVERRIDE.read_text().strip())
    except (OSError, ValueError):
        return None
    return ts if ts > datetime.now(LOCAL) else None


# ---------------------------------------------------------------- sources
def games(now: datetime) -> list[dict]:
    """ESPN schedules, cached 30 min so page loads do not hammer the API."""
    with _lock:
        fresh = _cache["at"] and (now - _cache["at"]) < timedelta(minutes=30)
        if fresh:
            return _cache["games"]

    out: list[dict] = []
    horizon = now + timedelta(days=LOOKAHEAD_DAYS)
    for label, sport, team in TEAMS:
        try:
            req = urllib.request.Request(
                f"https://site.api.espn.com/apis/site/v2/sports/{sport}"
                f"/teams/{team}/schedule",
                headers={"User-Agent": "dvr-dashboard/1.0"})
            with urllib.request.urlopen(req, timeout=20) as r:
                data = json.load(r)
        except Exception:                                  # noqa: BLE001
            continue
        kind = "football" if "football" in sport else "basketball"
        for ev in data.get("events", []):
            try:
                start = datetime.fromisoformat(
                    ev["date"].replace("Z", "+00:00")).astimezone(LOCAL)
            except (KeyError, ValueError):
                continue
            if not (now <= start <= horizon):
                continue
            end = start + DURATION[kind]
            out.append({"team": label,
                        "name": ev.get("shortName") or ev.get("name") or "game",
                        "start": start.isoformat(), "end": end.isoformat(),
                        "needsPower": outside_window(start, end)})
    out.sort(key=lambda g: g["start"])
    with _lock:
        _cache.update(at=now, games=out)
    return out


def recordings(now: datetime) -> tuple[list[dict], list[str]]:
    items, problems = [], []

    try:
        init = pct("curl", "-s", "--max-time", "10",
                   f"{NEXTPVR}?method=session.initiate&ver=1.0&device=dashboard")
        sid = init.split("<sid>")[1].split("</sid>")[0]
        salt = init.split("<salt>")[1].split("</salt>")[0]
        h = hashlib.md5(f":{hashlib.md5(b'0000').hexdigest()}:{salt}".encode()).hexdigest()
        pct("curl", "-s", "--max-time", "10",
            f"{NEXTPVR}?method=session.login&md5={h}&sid={sid}")
        for f in ("inprogress", "pending"):
            xml = pct("curl", "-s", "--max-time", "10",
                      f"{NEXTPVR}?method=recording.list&filter={f}&sid={sid}")
            for chunk in xml.split("<recording>")[1:]:
                def tag(t: str) -> str:
                    return (chunk.split(f"<{t}>")[1].split(f"</{t}>")[0]
                            if f"<{t}>" in chunk else "")
                try:
                    start = datetime.fromtimestamp(int(tag("start_time")), tz=LOCAL)
                    end = start + timedelta(seconds=int(tag("duration") or 0))
                except (ValueError, IndexError):
                    continue
                items.append({"source": "NextPVR", "name": tag("name") or "recording",
                              "start": start.isoformat(), "end": end.isoformat(),
                              "live": f == "inprogress",
                              "needsPower": outside_window(start, end)})
    except Exception as exc:                               # noqa: BLE001
        problems.append(f"NextPVR unreachable ({type(exc).__name__})")

    try:
        for t in json.loads(pct("cat", JELLYFIN_TIMERS)):
            if t.get("Status") in JF_DONE:
                continue
            start = datetime.fromisoformat(
                t["StartDate"].replace("Z", "+00:00")).astimezone(LOCAL)
            end = datetime.fromisoformat(
                t["EndDate"].replace("Z", "+00:00")).astimezone(LOCAL)
            start -= timedelta(seconds=t.get("PrePaddingSeconds") or 0)
            end += timedelta(seconds=t.get("PostPaddingSeconds") or 0)
            if end < now:
                continue
            items.append({"source": "Jellyfin", "name": t.get("Name", "recording"),
                          "start": start.isoformat(), "end": end.isoformat(),
                          "live": start <= now <= end,
                          "needsPower": outside_window(start, end)})
    except Exception as exc:                               # noqa: BLE001
        problems.append(f"Jellyfin timers unreadable ({type(exc).__name__})")

    items.sort(key=lambda r: r["start"])
    return items, problems


def status() -> dict:
    now = datetime.now(LOCAL)
    recs, problems = recordings(now)
    ov = override_until()
    return {
        "now": now.isoformat(),
        "powerOn": POWER_ON.strftime("%H:%M"),
        "powerOff": POWER_OFF.strftime("%H:%M"),
        "shutdownAt": SHUTDOWN_AT.strftime("%H:%M"),
        "override": ov.isoformat() if ov else None,
        "games": games(now),
        "recordings": recs,
        "problems": problems,
    }


# ---------------------------------------------------------------- http
PAGE = r"""<!doctype html><html lang="en"><head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="color-scheme" content="light dark"><title>Media-Core DVR</title>
<style>
:root{--bg:#f4f5f7;--card:#fff;--fg:#16181d;--dim:#666e7a;--line:#e3e6ea;
--accent:#2f6fdd;--warn:#b3541e;--warnbg:#fff3e8;--ok:#1a7f4b;--okbg:#e9f7ef;--live:#c0392b}
@media(prefers-color-scheme:dark){:root{--bg:#101216;--card:#181b21;--fg:#e8eaed;
--dim:#98a0ad;--line:#262a32;--accent:#5b9bff;--warn:#e08a4a;--warnbg:#2a1e14;
