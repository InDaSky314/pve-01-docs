def load_mct_bookings() -> list[dict[str, Any]]:
    if not MCT_BOOKINGS.exists():
        return []
    try:
        data = json.loads(MCT_BOOKINGS.read_text())
        if isinstance(data, list):
            return data
    except Exception:
        pass
    return []


def save_mct_bookings(bookings: list[dict[str, Any]]) -> None:
    MCT_BOOKINGS.parent.mkdir(parents=True, exist_ok=True)
    tmp = MCT_BOOKINGS.with_suffix(".tmp")
    tmp.write_text(json.dumps(bookings, indent=2) + "\n")
    tmp.replace(MCT_BOOKINGS)

