.row{display:flex;gap:12px;padding:9px 0;border-top:1px solid var(--line);align-items:baseline}
.row:first-of-type{border-top:0}
.when{flex:0 0 8.5em;font-variant-numeric:tabular-nums;font-size:.9rem}
