#!/usr/bin/env python3
"""Dashboard: tonight's power state, scheduled recordings, and full team schedules.

Serves one responsive page plus a JSON API on the LAN and over Tailscale.
Stdlib only -- no web framework, no build step, nothing to keep patched.

  GET  /               the page
  GET  /api/status     power state, recordings, games in the next 10 days
  GET  /api/schedule   full season for every followed team, with recording match
  POST /api/override   {"hours": N}  keep the host up; N<=0 clears

The override writes a timestamp that dvr-clean-shutdown reads, so pressing
the button stops tonight's automatic shutdown. It does NOT hold the mains
timer open -- that is a physical switch, and the page says so.

Docs: /root/pve-01-docs/docs/livetv-custom-build-and-updates-20260726.md
"""
from __future__ import annotations

import hashlib
import json
import subprocess
import threading
import urllib.request
from datetime import datetime, timedelta, timezone, time as dtime
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path
from zoneinfo import ZoneInfo

LOCAL = ZoneInfo("Europe/Berlin")
PORT = 8099
POWER_ON, POWER_OFF = dtime(4, 57), dtime(22, 24)
SHUTDOWN_AT = dtime(22, 10)

OVERRIDE = Path("/var/lib/dvr-dashboard/override-until")
CT = "105"
NEXTPVR = "http://localhost:8866/service"
JELLYFIN_TIMERS = "/srv/media-core/jellyfin/config/data/livetv/timers.json"
JF_DONE = {"Completed", "Cancelled", "Error"}

UPCOMING_DAYS = 10
DURATION = {"football": timedelta(hours=3, minutes=45),
            "basketball": timedelta(hours=2, minutes=45)}
TEAMS = [
    ("Packers",            "football/nfl",                       "gb"),
    ("Badgers Football",   "football/college-football",          "275"),
    ("Badgers Basketball", "basketball/mens-college-basketball", "275"),
    ("Bucks",              "basketball/nba",                     "mil"),
]

# Schedules change rarely; recordings change often. Cached separately.
_sched: dict = {"at": None, "games": []}
_lock = threading.Lock()


def pct(*args: str, timeout: int = 25) -> str:
    return subprocess.run(["/usr/sbin/pct", "exec", CT, "--", *args],
                          capture_output=True, text=True,
                          timeout=timeout, check=True).stdout


def npvr_start(tag) -> datetime:
    """NextPVR start time as a real local datetime.

    <start_time> is local wall time ("07/31/2026 22:00:00"). <start_time_ticks>
    looks like an epoch but is that same wall time encoded as if it were UTC,
    so reading it with fromtimestamp(tz=LOCAL) lands 2 h out in CEST. Parse the
    string; fall back to relabelling the ticks rather than trusting them.
    """
    raw = tag("start_time")
    if raw:
        return datetime.strptime(raw.strip(), "%m/%d/%Y %H:%M:%S").replace(tzinfo=LOCAL)
    naive = datetime.fromtimestamp(int(tag("start_time_ticks")), tz=timezone.utc)
    return naive.replace(tzinfo=LOCAL)

def outside_window(start: datetime, end: datetime) -> bool:
    cur = start
    while cur <= end:
        if not (POWER_ON <= cur.time() <= POWER_OFF):
            return True
        cur += timedelta(minutes=15)
    return not (POWER_ON <= end.time() <= POWER_OFF)


def override_until() -> datetime | None:
    try:
        ts = datetime.fromisoformat(OVERRIDE.read_text().strip())
    except (OSError, ValueError):
        return None
    return ts if ts > datetime.now(LOCAL) else None


# ESPN's default schedule response is the regular season only. Preseason and
# postseason live behind seasontype, and preseason matters here -- those games
# are watched too, and they start weeks before the regular season.
SEASON_TYPES = {1: "Preseason", 2: "", 3: "Postseason"}


def all_games(now: datetime) -> list[dict]:
    """Every game ESPN lists for the followed teams, all season types. Cached 6 h."""
    with _lock:
        if _sched["at"] and (now - _sched["at"]) < timedelta(hours=6):
            return _sched["games"]

    out: list[dict] = []
    seen: set = set()
    for label, sport, team in TEAMS:
      for stype, sname in SEASON_TYPES.items():
        try:
            req = urllib.request.Request(
                f"https://site.api.espn.com/apis/site/v2/sports/{sport}"
                f"/teams/{team}/schedule?seasontype={stype}",
                headers={"User-Agent": "dvr-dashboard/1.0"})
            with urllib.request.urlopen(req, timeout=20) as r:
                data = json.load(r)
        except Exception:                                   # noqa: BLE001
            continue
        kind = "football" if "football" in sport else "basketball"
        for ev in data.get("events", []):
            try:
                start = datetime.fromisoformat(
                    ev["date"].replace("Z", "+00:00")).astimezone(LOCAL)
            except (KeyError, ValueError):
                continue
            comp = (ev.get("competitions") or [{}])[0]
            done = bool(((comp.get("status") or {}).get("type") or {}).get("completed"))
            score = ""
            if done:
                bits = []
                for c in comp.get("competitors") or []:
                    ab = (c.get("team") or {}).get("abbreviation") or ""
                    sc = (c.get("score") or {})
                    val = sc.get("displayValue") if isinstance(sc, dict) else sc
                    if ab and val is not None:
                        bits.append(f"{ab} {val}")
                score = "  ".join(reversed(bits))
            key = (label, ev.get("id") or start.isoformat())
            if key in seen:
                continue
            seen.add(key)
            end = start + DURATION[kind]
            out.append({
                "team": label, "kind": kind, "season": sname,
                "name": ev.get("shortName") or ev.get("name") or "game",
                "start": start.isoformat(), "end": end.isoformat(),
                "done": done, "score": score,
                "needsPower": outside_window(start, end),
            })
    out.sort(key=lambda g: g["start"])
    with _lock:
        _sched.update(at=now, games=out)
    return out


def channel_names(sid: str) -> dict[str, str]:
    """number -> name, so a Jellyfin timer's 'hdhr_100' can be shown as a name.

    Jellyfin timers carry only the tuner's channel id. Both tuners number these
    channels identically, so NextPVR's list resolves them.
    """
    out: dict[str, str] = {}
    try:
        xml = pct("curl", "-s", "--max-time", "10",
                  f"{NEXTPVR}?method=channel.list&sid={sid}")
    except Exception:                                       # noqa: BLE001
        return out
    for chunk in xml.split("<channel>")[1:]:
        def tag(t: str) -> str:
            return (chunk.split(f"<{t}>")[1].split(f"</{t}>")[0]
                    if f"<{t}>" in chunk else "")
        if tag("number"):
            out[tag("number")] = tag("name")
    return out


def recordings(now: datetime) -> tuple[list[dict], list[str]]:
    items, problems = [], []
    chmap: dict[str, str] = {}
    try:
        init = pct("curl", "-s", "--max-time", "10",
                   f"{NEXTPVR}?method=session.initiate&ver=1.0&device=dashboard")
        sid = init.split("<sid>")[1].split("</sid>")[0]
        salt = init.split("<salt>")[1].split("</salt>")[0]
        h = hashlib.md5(f":{hashlib.md5(b'0000').hexdigest()}:{salt}".encode()).hexdigest()
        pct("curl", "-s", "--max-time", "10",
            f"{NEXTPVR}?method=session.login&md5={h}&sid={sid}")
        chmap = channel_names(sid)
        # A recording currently airing appears under BOTH filters, so track ids.
        seen_rec: set = set()
        for f in ("inprogress", "pending"):
            xml = pct("curl", "-s", "--max-time", "10",
                      f"{NEXTPVR}?method=recording.list&filter={f}&sid={sid}")
            for chunk in xml.split("<recording>")[1:]:
                def tag(t: str) -> str:
                    return (chunk.split(f"<{t}>")[1].split(f"</{t}>")[0]
                            if f"<{t}>" in chunk else "")
                # NextPVR exposes BOTH a formatted <start_time>
                # ('07/31/2026 22:00:00') and epoch <start_time_ticks>;
                # likewise <duration> ('00:30') and <duration_seconds>.
                # Parsing the formatted pair threw and hit the continue
                # below, so every NextPVR recording was silently invisible.
                try:
                    start = npvr_start(tag)
                    end = start + timedelta(seconds=int(tag("duration_seconds") or 0))
                except (ValueError, IndexError):
                    continue
                start -= timedelta(seconds=int(tag("pre_padding") or 0) * 60)
                end += timedelta(seconds=int(tag("post_padding") or 0) * 60)
                rid = tag("id")
                if rid and rid in seen_rec:
                    continue
                seen_rec.add(rid)
                sub = tag("subtitle")
                items.append({"source": "NextPVR", "name": tag("name") or "recording",
                              "subtitle": sub, "channel": tag("channel"),
                              "start": start.isoformat(), "end": end.isoformat(),
                              "live": start <= now <= end,
                              "needsPower": outside_window(start, end)})
    except Exception as exc:                                # noqa: BLE001
        problems.append(f"NextPVR unreachable ({type(exc).__name__})")

    try:
        for t in json.loads(pct("cat", JELLYFIN_TIMERS)):
            if t.get("Status") in JF_DONE:
                continue
            start = datetime.fromisoformat(
                t["StartDate"].replace("Z", "+00:00")).astimezone(LOCAL)
            end = datetime.fromisoformat(
                t["EndDate"].replace("Z", "+00:00")).astimezone(LOCAL)
            start -= timedelta(seconds=t.get("PrePaddingSeconds") or 0)
            end += timedelta(seconds=t.get("PostPaddingSeconds") or 0)
            if end < now:
                continue
            num = "".join(ch for ch in str(t.get("ChannelId", "")) if ch.isdigit())
            items.append({"source": "Jellyfin", "name": t.get("Name", "recording"),
                          "channel": chmap.get(num) or (f"ch {num}" if num else ""),
                          "subtitle": t.get("EpisodeTitle") or "",
                          "start": start.isoformat(), "end": end.isoformat(),
                          "live": start <= now <= end,
                          "needsPower": outside_window(start, end)})
    except Exception as exc:                                # noqa: BLE001
        problems.append(f"Jellyfin timers unreadable ({type(exc).__name__})")

    items.sort(key=lambda r: r["start"])
    return items, problems


def tag_recordings(games: list[dict], recs: list[dict]) -> None:
    """Mark games whose airtime overlaps a scheduled recording.

    Matched purely on time overlap -- neither DVR records "the Packers game",
    it records a channel for a span. So we report which recording overlaps and
    let the reader judge, rather than asserting the game itself is covered.
    """
    for g in games:
        gs, ge = datetime.fromisoformat(g["start"]), datetime.fromisoformat(g["end"])
        hits = [r["name"] for r in recs
                if datetime.fromisoformat(r["start"]) < ge
                and datetime.fromisoformat(r["end"]) > gs]
        g["recording"] = hits[0] if hits else None


def status() -> dict:
    now = datetime.now(LOCAL)
    recs, problems = recordings(now)
    horizon = now + timedelta(days=UPCOMING_DAYS)
    upcoming = [g for g in all_games(now)
                if now <= datetime.fromisoformat(g["start"]) <= horizon]
    tag_recordings(upcoming, recs)
    ov = override_until()
    return {"now": now.isoformat(),
            "powerOn": POWER_ON.strftime("%H:%M"),
            "powerOff": POWER_OFF.strftime("%H:%M"),
            "shutdownAt": SHUTDOWN_AT.strftime("%H:%M"),
            "override": ov.isoformat() if ov else None,
            "games": upcoming, "recordings": recs, "problems": problems}


def schedule() -> dict:
    now = datetime.now(LOCAL)
    recs, problems = recordings(now)
    games = [dict(g) for g in all_games(now)]
    tag_recordings(games, recs)
    return {"now": now.isoformat(), "teams": [t[0] for t in TEAMS],
            "games": games, "problems": problems}


