def load_json_config(path: Path, defaults: dict) -> dict:
    if not path.exists():
        save_json_config(path, defaults)
        return dict(defaults)
    try:
        data = json.loads(path.read_text())
        if not isinstance(data, dict):
            raise ValueError("Config root must be a JSON object")
        updated = False
        for k, v in defaults.items():
            if k not in data:
                data[k] = v
                updated = True
        if updated:
            save_json_config(path, data)
        return data
    except Exception as exc:
        sys.stderr.write(f"WARNING: Failed reading {path}: {exc}. Resetting to defaults.\n")
        save_json_config(path, defaults)
        return dict(defaults)


def save_json_config(path: Path, config: dict) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_suffix(".tmp")
    tmp.write_text(json.dumps(config, indent=2) + "\n")
    tmp.replace(path)


def pct(*args: str, timeout: int = 25) -> str:
    return subprocess.run(["/usr/sbin/pct", "exec", CT, "--", *args],
                          capture_output=True, text=True,
                          timeout=timeout, check=True).stdout


def check_link(host: str, port: int, timeout: float = 1.5) -> bool:
    try:
        with socket.create_connection((host, port), timeout=timeout):
            return True
    except OSError:
        return False


def links_status() -> list[dict]:
    return [{"group": l["group"], "label": l["label"], "url": l["url"],
              "up": check_link(l["host"], l["port"])} for l in LINKS]


# Added 2026-08-11 per owner request: a way to see whether sports-dvr-auto's
# extend/trim/stall/restore/stitch logic actually fired, without SSHing in
# and grepping the systemd journal. Same file sports-dvr-auto itself appends
# to (/var/lib/dvr-dashboard/dvr-automation-events.jsonl) -- this dashboard
# only reads it, never writes it, so there's no write-contention risk between
# the two processes.
AUTOMATION_EVENT_LOG = Path("/var/lib/dvr-dashboard/dvr-automation-events.jsonl")


def automation_events(n: int = 50) -> list[dict]:
    if not AUTOMATION_EVENT_LOG.exists():
        return []
    try:
        lines = AUTOMATION_EVENT_LOG.read_text().splitlines()
    except OSError:
        return []
    out = []
    for line in lines[-n:]:
        try:
            out.append(json.loads(line))
        except json.JSONDecodeError:
            continue
    out.reverse()
    return out


def outside_window(start: datetime, end: datetime) -> bool:
    cur = start
    while cur <= end:
        if not is_powered(cur):
            return True
        cur += timedelta(minutes=15)
    return not is_powered(end)


def override_until() -> datetime | None:
    try:
        ts = datetime.fromisoformat(OVERRIDE.read_text().strip())
    except (OSError, ValueError):
        return None
    return ts if ts > datetime.now(LOCAL) else None


SEASON_TYPES = {1: "Preseason", 2: "", 3: "Postseason"}

OPENLIGADB_BASE = "https://api.openligadb.de/getmatchdata"
_oldb_cache: dict = {"at": None, "games": []}
_problems: list[str] = []


def normalize_text(text: str) -> str:
    if not text:
        return ""
    t = unicodedata.normalize("NFKC", text).lower()
    return t.replace("\u2013", "-").replace("\u2014", "-")


def team_in_text(team_name: str, text: str) -> bool:
    norm_text = normalize_text(text)
    words = re.findall(r"\b[a-z0-9äöüß]+\b", normalize_text(team_name))
    stop = {"fc", "vfl", "vfb", "sv", "sc", "fsv", "tsg", "rb", "1", "04", "05", "07", "09", "spvgg"}
    sig = [w for w in words if w not in stop and len(w) > 1]
    return any(w in norm_text for w in (sig if sig else words))


def fetch_openligadb_bayern(now: datetime, problems: list[str], chmap: dict[str, str]) -> list[dict]:
    """Fetch Bayern Munich fixtures from OpenLigaDB for Bundesliga (bl1) and DFB-Pokal (dfb)
    for the current season, enriched with broadcast info from Jellyfin's EPG.
    """
    global _oldb_cache
    now_utc = datetime.now(timezone.utc)
    season_year = now.year if now.month >= 7 else now.year - 1

    leagues = [("bl1", f"{OPENLIGADB_BASE}/bl1/{season_year}"),
               ("dfb", f"{OPENLIGADB_BASE}/dfb/{season_year}")]

    raw_matches = []
    fetch_failed = False

    for league_key, url in leagues:
        try:
            req = urllib.request.Request(url, headers={"User-Agent": "DVRDashboard/1.0"})
            with urllib.request.urlopen(req, timeout=15) as resp:
                data = json.load(resp)
                if isinstance(data, list):
                    raw_matches.extend(data)
        except Exception as exc:
            fetch_failed = True
            problems.append(f"OpenLigaDB {league_key} unreachable ({type(exc).__name__})")

    if fetch_failed and not raw_matches:
        if _oldb_cache.get("games"):
            return list(_oldb_cache["games"])
        return []

    ch_items = (jf_request("/emby/LiveTv/Channels?Limit=2000") or {}).get("Items", [])
    channels_by_id = {c.get("Id"): c for c in ch_items if isinstance(c, dict) and c.get("Id")}

    out = []
    seen_ids = set()

    for m in raw_matches:
        t1 = m.get("team1") or {}
        t2 = m.get("team2") or {}
        t1_name = t1.get("teamName", "")
        t2_name = t2.get("teamName", "")
        if not ("Bayern" in t1_name or "Bayern" in t2_name):
            continue

        match_id = str(m.get("matchID") or "")
        if match_id in seen_ids:
            continue
        seen_ids.add(match_id)

        dt_utc = m.get("matchDateTimeUTC")
        if not dt_utc:
            continue
        try:
            start_utc = datetime.fromisoformat(dt_utc.replace("Z", "+00:00"))
        except (ValueError, TypeError):
            continue
        start = start_utc.astimezone(LOCAL)
        end = start + DURATION["soccer"]

        group_name = (m.get("group") or {}).get("groupName", "")
        done = bool(m.get("matchIsFinished"))

        score = ""
        if done:
            res = next((r for r in m.get("matchResults", [])
                        if r.get("resultTypeKind") in ("After90Minutes", "AfterExtraTime", "AfterPenaltyShootout")
                        or r.get("resultName") == "Endergebnis"),
                       m.get("matchResults")[-1] if m.get("matchResults") else None)
            if res:
                p1 = res.get("pointsTeam1", 0)
                p2 = res.get("pointsTeam2", 0)
                s1 = t1.get("shortName") or t1_name
                s2 = t2.get("shortName") or t2_name
                score = f"{s1} {p1}  {s2} {p2}"

        # EPG enrichment: query Jellyfin LiveTV Programs around kickoff
        # Guide window is ~54 days; only query if match is within reasonable range (-1 day to +60 days)
        resolved_channel = None
        broadcast_list = []
        if (now_utc - timedelta(days=1)) <= start_utc <= (now_utc + timedelta(days=60)):
            min_s = (start_utc - timedelta(hours=3)).strftime("%Y-%m-%dT%H:%M:%SZ")
            max_s = (start_utc + timedelta(hours=2)).strftime("%Y-%m-%dT%H:%M:%SZ")
            p_resp = jf_request("/LiveTv/Programs",
                                data={"MinStartDate": min_s, "MaxStartDate": max_s, "Limit": 500},
                                method="POST")
            matched_progs = []
            for p in (p_resp.get("Items", []) if isinstance(p_resp, dict) else []):
                try:
                    ps = datetime.fromisoformat(p["StartDate"].replace("Z", "+00:00"))
                    pe = datetime.fromisoformat(p["EndDate"].replace("Z", "+00:00"))
                except Exception:
                    continue
                if not (ps <= start_utc < pe):
                    continue
                ep = p.get("EpisodeTitle") or ""
                if team_in_text(t1_name, ep) and team_in_text(t2_name, ep):
                    cid = p.get("ChannelId")
                    c = channels_by_id.get(cid, {})
                    cno = str(c.get("ChannelNumber") or c.get("Number") or "").strip()
                    cname = (c.get("Name") or "").strip()
                    disp = chmap.get(cid) or chmap.get(cno) or (f"{cno} {cname}".strip() if cno else cname)
                    matched_progs.append({
                        "channel_id": cid,
                        "channel_number": cno,
                        "channel_name": cname,
                        "display": disp,
                    })

            if matched_progs:
                # Prefer primary HD feed: 1011 (Sky Sport Bundesliga HD)
                matched_progs.sort(key=lambda x: (
                    0 if x["channel_number"] == "1011" or x["channel_name"] == "Sky Sport Bundesliga HD"
                    else (1 if "Sky Sport Bundesliga HD" in x["channel_name"] else 2),
                    int(x["channel_number"]) if x["channel_number"].isdigit() else 99999
                ))
                primary = matched_progs[0]
                resolved_channel = primary["display"]
                broadcast_list = [primary["display"]] + [mp["display"] for mp in matched_progs[1:]]

        channel_field = resolved_channel if resolved_channel else "not in guide yet"

        out.append({
            "id": match_id,
            "team": "Bayern Munich",
            "kind": "soccer",
            "season": group_name,
            "name": f"{t1_name} vs. {t2_name}",
            "start": start.isoformat(),
            "end": end.isoformat(),
            "done": done,
            "score": score,
            "broadcasts": broadcast_list,
            "channel": channel_field,
            "needsPower": outside_window(start, end),
        })

    if out:
        _oldb_cache["games"] = list(out)
        _oldb_cache["at"] = now
    elif _oldb_cache.get("games"):
        out = list(_oldb_cache["games"])

    return out


def all_games(now: datetime, problems: list[str] | None = None) -> list[dict]:
    """Every game listed for the followed teams, all season types. Cached 6 h."""
    global _problems
    with _lock:
        if _sched["at"] and (now - _sched["at"]) < timedelta(hours=6):
            if problems is not None:
                problems.extend(_problems)
            return _sched["games"]

    out: list[dict] = []
    seen: set = set()
    current_problems: list[str] = []
    chmap = channel_names()
    jf_channels = get_jellyfin_channels()

    for label, sport, team in TEAMS:
        for stype, sname in SEASON_TYPES.items():
            try:
                req = urllib.request.Request(
                    f"https://site.api.espn.com/apis/site/v2/sports/{sport}"
                    f"/teams/{team}/schedule?seasontype={stype}",
                )
                with urllib.request.urlopen(req, timeout=15) as r:
                    data = json.load(r)
            except Exception:                               # noqa: BLE001
                continue
            kind = sport.split("/")[0]
            for ev in data.get("events", []):
                try:
                    start = datetime.fromisoformat(
                        ev["date"].replace("Z", "+00:00")).astimezone(LOCAL)
                except (KeyError, ValueError):
                    continue
                comp = (ev.get("competitions") or [{}])[0]
                done = bool(((comp.get("status") or {}).get("type") or {}).get("completed"))
                score = ""
                if done:
                    bits = []
                    for c in comp.get("competitors") or []:
                        ab = (c.get("team") or {}).get("abbreviation") or ""
                        sc = (c.get("score") or {})
                        val = sc.get("displayValue") if isinstance(sc, dict) else sc
                        if ab and val is not None:
                            bits.append(f"{ab} {val}")
                    score = "  ".join(reversed(bits))
                key = (label, ev.get("id") or start.isoformat())
                if key in seen:
                    continue
                seen.add(key)
                end = start + DURATION[kind]

                broadcast_names: list[str] = []
                for bc in comp.get("broadcasts") or []:
                    m_short = (bc.get("media") or {}).get("shortName")
                    if m_short:
                        broadcast_names.append(m_short)
                    for n in bc.get("names") or []:
                        if n and n not in broadcast_names:
                            broadcast_names.append(n)

                g_item = {
                    "id": str(ev.get("id") or ""),
                    "team": label, "kind": kind, "season": sname,
                    "name": ev.get("shortName") or ev.get("name") or "game",
                    "start": start.isoformat(), "end": end.isoformat(),
                    "done": done, "score": score,
                    "broadcasts": broadcast_names,
                    "needsPower": outside_window(start, end),
                }
                cid, cname = resolve_channel_id(g_item, jf_channels)
                if cid:
                    g_item["channel"] = chmap.get(cid) or chmap.get(cname) or cname
                out.append(g_item)

    # Scoreboard fallback for dynamic-PPV teams / Champions League
    dynamic_leagues = {sport for label, sport, _ in TEAMS if label in DYNAMIC_PPV_TEAMS}
    for sport in dynamic_leagues:
        try:
            req = urllib.request.Request(
                f"https://site.api.espn.com/apis/site/v2/sports/{sport}/scoreboard")
            with urllib.request.urlopen(req, timeout=15) as r:
                data = json.load(r)
        except Exception:                                   # noqa: BLE001
            continue
        kind = sport.split("/")[0]
        for ev in data.get("events", []):
            full_name = ev.get("name") or ev.get("shortName") or ""
            disp_name = ev.get("shortName") or ev.get("name") or "game"
            matched_label = next(
                (lbl for lbl in DYNAMIC_PPV_TEAMS
                 if any(p.search(full_name) for p in PPV_TEAM_PATTERNS.get(lbl, []))),
                None)
            if not matched_label:
                continue
            try:
                start = datetime.fromisoformat(
                    ev["date"].replace("Z", "+00:00")).astimezone(LOCAL)
            except (KeyError, ValueError):
                continue
            if start < now - timedelta(hours=3):
                continue
            key = (matched_label, ev.get("id") or start.isoformat())
            if key in seen:
                continue
            seen.add(key)
            comp = (ev.get("competitions") or [{}])[0]
            done = bool(((comp.get("status") or {}).get("type") or {}).get("completed"))
            end = start + DURATION[kind]
            g_item = {
                "id": str(ev.get("id") or ""),
                "team": matched_label, "kind": kind, "season": "",
                "name": disp_name,
                "start": start.isoformat(), "end": end.isoformat(),
                "done": done, "score": "",
                "broadcasts": [],
                "needsPower": outside_window(start, end),
            }
            out.append(g_item)

    # OpenLigaDB fixtures for Bayern Munich (Bundesliga + DFB-Pokal)
    oldb_games = fetch_openligadb_bayern(now, current_problems, chmap)
    for g in oldb_games:
        key = ("Bayern Munich", g["id"] or g["start"])
        if key in seen:
            continue
        seen.add(key)
        out.append(g)

    out.sort(key=lambda g: g["start"])
    with _lock:
        _sched.update(at=now, games=out)
        _problems = list(current_problems)

    if problems is not None:
        problems.extend(current_problems)
    return out


def channel_names() -> dict[str, str]:
    out: dict[str, str] = {}
    data = jf_request("/emby/LiveTv/Channels?Limit=2000")
    if not data or not isinstance(data, dict):
        return out
    for c in data.get("Items", []):
        number = str(c.get("ChannelNumber") or c.get("Number") or "").strip()
        name = (c.get("Name") or "").strip()
        cid = str(c.get("Id") or "").strip()
        display = f"{number} {name}".strip() if number else name
        if number:
            out[number] = display
            out[f"hdhr_{number}"] = display
        if cid:
            out[cid] = display
        if name:
            out[name] = display
            out[name.lower()] = display
    return out


def recordings(now: datetime) -> tuple[list[dict], list[str]]:
    items, problems = [], []
    chmap = channel_names()

    try:
        for t in json.loads(pct("cat", JELLYFIN_TIMERS)):
            if t.get("Status") in JF_DONE:
                continue
            start = datetime.fromisoformat(
                t["StartDate"].replace("Z", "+00:00")).astimezone(LOCAL)
            end = datetime.fromisoformat(
                t["EndDate"].replace("Z", "+00:00")).astimezone(LOCAL)
            start -= timedelta(seconds=t.get("PrePaddingSeconds") or 0)
            end += timedelta(seconds=t.get("PostPaddingSeconds") or 0)
            if end < now:
                continue
            raw_cid = str(t.get("ChannelId") or "")
            num = "".join(ch for ch in raw_cid if ch.isdigit())
            c_name = t.get("ChannelName") or ""
            c_disp = chmap.get(raw_cid) or chmap.get(num) or chmap.get(c_name) or (f"ch {num}" if num else "")
            items.append({"source": "Jellyfin", "engine": "jellyfin",
                          "name": t.get("Name", "recording"),
                          "channel": c_disp,
                          "subtitle": t.get("EpisodeTitle") or "",
                          "start": start.isoformat(), "end": end.isoformat(),
                          "live": start <= now <= end,
                          "needsPower": outside_window(start, end)})
    except Exception as exc:                                # noqa: BLE001
        problems.append(f"Jellyfin timers unreadable ({type(exc).__name__})")

    try:
        for b in load_mct_bookings():
            if b.get("status") in ("cancelled", "done", "failed"):
                continue
            try:
                b_start = datetime.fromisoformat(b["start"]).astimezone(LOCAL)
                duration_sec = int(b.get("duration_sec", 0))
                b_end = b_start + timedelta(seconds=duration_sec)
            except Exception:
                continue
            if b_end + timedelta(minutes=15) < now:
                continue
            c_disp = b.get("channel_display") or f"{b.get('channel_number', '')} {b.get('channel_name', '')}".strip() or str(b.get("channel", ""))
            title = b.get("title") or b.get("name", "MCT recording")
            status = b.get("status", "booked")
            items.append({"source": "MCT", "engine": "mct",
                          "id": str(b.get("id", "")),
                          "name": title,
                          "channel": c_disp,
                          "subtitle": f"Status: {status}",
                          "start": b_start.isoformat(), "end": b_end.isoformat(),
                          "status": status,
                          "live": status == "running" or (b_start <= now <= b_end),
                          "needsPower": outside_window(b_start, b_end)})
    except Exception as exc:                                # noqa: BLE001
        problems.append(f"MCT bookings unreadable ({type(exc).__name__})")

    items.sort(key=lambda r: r["start"])
    return items, problems


def tag_recordings(games: list[dict], recs: list[dict]) -> None:
    # A timer only carries the "<Team>:" name prefix when sports-dvr-auto created
    # it. Anything scheduled by hand, or from the Jellyfin UI, used to fall through
    # to the UI's "other recording overlaps" label even when it WAS this game --
    # how the 2026-09-05 Bayern match and the 2026-09-02 Brewers game both read as
    # foreign overlaps. Channel is the reliable second signal, and it generalises:
    # recordings() and the schedule rows format channel identically ("<num> <name>"),
    # so an overlapping timer on the same channel is this game's own recording.
    for g in games:
        gs, ge = datetime.fromisoformat(g["start"]), datetime.fromisoformat(g["end"])
        hits = [r for r in recs
                if datetime.fromisoformat(r["start"]) < ge
                and datetime.fromisoformat(r["end"]) > gs]
        g["recording"] = hits[0]["name"] if hits else None
        g["recordingIsThisGame"] = False
        g["engine"] = hits[0].get("engine", hits[0].get("source", "jellyfin").lower()) if hits else None
        g["bookingStatus"] = hits[0].get("status") if hits else None
        g["bookingId"] = hits[0].get("id") if hits else None
        team = g.get("team") or ""
        gch = g.get("channel") or ""
        # Third signal, for the ESPN-sourced US teams: those games carry no
        # resolved channel (only the OpenLigaDB/EPG path sets one), so the
        # channel comparison above can never fire for them. The team's leading
        # token is distinctive enough -- "Brewers" appears in both the timer name
        # ("Milwaukee Brewers at Chicago Cubs") and its channel ("121 Milwaukee
        # Brewers HD"). Leading token, not trailing: "Badgers Football" would
        # otherwise match on "Football".
        tok = team.split()[0].lower() if team else ""
        for r in hits:
            rname = str(r.get("name", ""))
            rch = str(r.get("channel", ""))
            if (team and rname.startswith(team + ":")) or (
                    gch and gch != "not in guide yet" and rch == gch) or (
                    len(tok) >= 4 and (tok in rname.lower() or tok in rch.lower())):
                g["recording"] = rname
                g["recordingIsThisGame"] = True
                g["engine"] = r.get("engine", r.get("source", "jellyfin").lower())
                g["bookingStatus"] = r.get("status")
                g["bookingId"] = r.get("id")
                break


def status() -> dict:
    now = datetime.now(LOCAL)
    recs, problems = recordings(now)
    oldb_probs: list[str] = []
    games = all_games(now, oldb_probs)
    problems.extend(oldb_probs)
    horizon = now + timedelta(days=UPCOMING_DAYS)
    upcoming = [g for g in games
                if now <= datetime.fromisoformat(g["start"]) <= horizon]
    tag_recordings(upcoming, recs)
    ov = override_until()
    cutoff, is_late = todays_power_off(now)
    check_at = cutoff - SHUTDOWN_BUFFER
    suffix = " (+1d)" if is_late else ""
    return {"now": now.isoformat(),
            "powerOn": POWER_ON.strftime("%H:%M"),
            "powerOff": cutoff.strftime("%H:%M") + suffix,
            "shutdownAt": check_at.strftime("%H:%M") + suffix,
            "override": ov.isoformat() if ov else None,
            "games": upcoming, "recordings": recs, "problems": problems}


def schedule() -> dict:
    now = datetime.now(LOCAL)
    recs, problems = recordings(now)
    oldb_probs: list[str] = []
    games = [dict(g) for g in all_games(now, oldb_probs)]
    problems.extend(oldb_probs)
    tag_recordings(games, recs)
    # dict.fromkeys() dedupes while preserving first-seen order -- needed
    # since a team can have multiple TEAMS rows (Bayern Munich has 3, one
    # per ESPN competition: Bundesliga/DFB-Pokal/Champions League), which
    # would otherwise render as duplicate filter pills in the UI.
    return {"now": now.isoformat(), "teams": list(dict.fromkeys(t[0] for t in TEAMS)),
            "games": games, "problems": problems}


