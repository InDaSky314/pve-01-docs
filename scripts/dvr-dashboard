AUTH_FILE = Path("/etc/dvr-dashboard.auth")


def load_auth() -> tuple[str, str]:
    if not AUTH_FILE.exists():
        sys.stderr.write(f"ERROR: Auth file missing: {AUTH_FILE}. DVR dashboard refuses to start unauthenticated.\n")
        sys.exit(1)
    try:
        content = AUTH_FILE.read_text().strip()
    except Exception as exc:
        sys.stderr.write(f"ERROR: Failed to read auth file {AUTH_FILE}: {exc}\n")
        sys.exit(1)
    if not content or ":" not in content:
        sys.stderr.write(f"ERROR: Auth file {AUTH_FILE} invalid format. Expected 'username:password' on one line.\n")
        sys.exit(1)
    user, pwd = content.split(":", 1)
    user, pwd = user.strip(), pwd.strip()
    if not user or not pwd:
        sys.stderr.write(f"ERROR: Auth file {AUTH_FILE} contains empty username or password.\n")
        sys.exit(1)
    return user, pwd


AUTH_USER, AUTH_PASS = load_auth()

LOCAL = ZoneInfo("Europe/Berlin")
PORT = int(os.environ.get("PORT", "8099"))

# Real physical timer schedule, confirmed against the owner's actual timer
# 2026-08-08. Power restores at the same time every day; the cutoff differs
# by day of week -- Fri and Sat nights stay on past midnight, cutting off
# early the FOLLOWING calendar day instead of that same evening.
POWER_ON = dtime(5, 5)
POWER_OFF_NORMAL = dtime(22, 25)     # Sun/Mon/Tue/Wed/Thu nights, same day
POWER_OFF_LATE = dtime(1, 0)         # Fri/Sat nights, lands on the *next* day
LATE_NIGHT_WEEKDAYS = (4, 5)         # Mon=0 ... Fri=4, Sat=5
SHUTDOWN_BUFFER = timedelta(minutes=15)  # how far ahead of the real cutoff to check


def is_powered(moment: datetime) -> bool:
    """Is the physical mains timer actually supplying power at this instant?"""
    t = moment.time()
    if t >= POWER_ON:
        # Evening/daytime portion of today. Fri/Sat stay on straight through;
        # every other night follows the normal same-day cutoff.
        if moment.weekday() in LATE_NIGHT_WEEKDAYS:
            return True
        return t <= POWER_OFF_NORMAL
    # Early-morning portion of today, before POWER_ON. Only "on" if
    # yesterday was a late night and we haven't hit that late cutoff yet.
    if (moment - timedelta(days=1)).weekday() in LATE_NIGHT_WEEKDAYS:
        return t <= POWER_OFF_LATE
    return False


def todays_power_off(now: datetime) -> tuple[datetime, bool]:
    """The next real cutoff from `now`'s perspective, and whether it's the
    late (next-calendar-day) kind. Used for display and for the
    shutdown-recheck comparison -- both care about "today's applicable
    cutoff", which needs the early-morning tail-end case handled specially:
    at e.g. Sunday 00:30, the relevant cutoff is *today* at 01:00 (the tail
    of Saturday night), not Sunday's own evening 22:25."""
    if now.time() < POWER_ON and (now - timedelta(days=1)).weekday() in LATE_NIGHT_WEEKDAYS:
        cutoff = now.replace(hour=POWER_OFF_LATE.hour, minute=POWER_OFF_LATE.minute,
                             second=0, microsecond=0)
        return cutoff, True
    if now.weekday() in LATE_NIGHT_WEEKDAYS:
        cutoff = (now + timedelta(days=1)).replace(
            hour=POWER_OFF_LATE.hour, minute=POWER_OFF_LATE.minute,
            second=0, microsecond=0)
        return cutoff, True
    cutoff = now.replace(hour=POWER_OFF_NORMAL.hour, minute=POWER_OFF_NORMAL.minute,
                         second=0, microsecond=0)
    return cutoff, False


def next_shutdown_cutoff(now: datetime) -> tuple[datetime, bool]:
    """The next real cutoff strictly after `now` -- for sizing "keep awake
    tonight" to exactly cover the current powered stretch, no more, no less."""
    for days_ahead in range(3):
        day = (now + timedelta(days=days_ahead)).date()
        late = day.weekday() in LATE_NIGHT_WEEKDAYS
        if late:
            cutoff = datetime.combine(day + timedelta(days=1), POWER_OFF_LATE, tzinfo=LOCAL)
        else:
            cutoff = datetime.combine(day, POWER_OFF_NORMAL, tzinfo=LOCAL)
        if cutoff > now:
            return cutoff, late
    return now + timedelta(hours=12), False  # unreachable in practice


def keep_awake_cutoff(now: datetime) -> datetime:
    """What "Keep awake tonight" should actually protect through."""
    cutoff, late = next_shutdown_cutoff(now)
    for _ in range(3):  # Fri+Sat is the longest possible late-night run
        if not late:
            return cutoff
        cutoff, late = next_shutdown_cutoff(cutoff)
    return cutoff


