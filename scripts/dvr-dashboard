.pill.warn{background:var(--warnbg);color:var(--warn)}
.pill.rec{background:var(--okbg);color:var(--ok)}
.pill.live{background:var(--live);color:#fff}
.status{display:flex;align-items:center;gap:10px;flex-wrap:wrap}
