<script>
const fD=s=>new Date(s).toLocaleString([],{weekday:'short',day:'numeric',month:'short',
  hour:'2-digit',minute:'2-digit'});
const fT=s=>new Date(s).toLocaleTimeString([],{hour:'2-digit',minute:'2-digit'});
const fCT=s=>new Date(s).toLocaleTimeString([],{hour:'2-digit',minute:'2-digit',
  timeZone:'America/Chicago'});
const esc=s=>String(s).replace(/[<>&]/g,c=>({'<':'&lt;','>':'&gt;','&':'&amp;'}[c]));
let TEAM='All', SCHED=null, PON=null;

const TEAM_BADGES = {
  'Packers': 'NFL',
  'Badgers Football': 'CFB',
  'Badgers Basketball': 'NCAAM',
  'Bucks': 'NBA',
  'Brewers': 'MLB'
};
let SPORTS_CONFIG = {};

async function loadSportsConfig() {
  try {
    SPORTS_CONFIG = await (await fetch('/api/sports-config')).json();
    renderSportsConfig();
    if (SCHED) render();
  } catch (e) {
    const el = document.getElementById('sports-toggles');
    if (el) el.innerHTML = '<div class="err">Could not load sports config</div>';
  }
}

function renderSportsConfig() {
  const el = document.getElementById('sports-toggles');
  if (!el) return;
  const teams = Object.keys(SPORTS_CONFIG);
  if (!teams.length) {
    el.innerHTML = '<div class="empty">No sports teams found.</div>';
    return;
  }
  el.innerHTML = teams.map(t => {
    const on = !!SPORTS_CONFIG[t];
    const badge = TEAM_BADGES[t] || '';
    return `<div class="toggle-row">
      <div class="toggle-label">
        <span class="toggle-name">${esc(t)}</span>
        ${badge ? `<span class="badge">${esc(badge)}</span>` : ''}
      </div>
      <div class="toggle-right">
        <span class="toggle-state-text ${on ? 'on' : ''}">${on ? 'Auto ON' : 'Off'}</span>
        <button type="button" role="switch" aria-checked="${on}" aria-label="Toggle ${esc(t)} auto-recording" class="switch" onclick="toggleTeam('${esc(t)}', ${!on})">
          <div class="switch-thumb"></div>
        </button>
      </div>
    </div>`;
  }).join('');
}

async function toggleTeam(team, newState) {
  SPORTS_CONFIG[team] = newState;
  renderSportsConfig();
  try {
    const res = await fetch('/api/sports-config', {
      method: 'POST',
      headers: {'Content-Type': 'application/json'},
      body: JSON.stringify({team: team, enabled: newState})
    });
    const j = await res.json().catch(() => ({}));
    if (!res.ok || !j.ok) throw new Error(j.error || 'Server HTTP error');
    if (j.config) SPORTS_CONFIG = j.config;
    renderSportsConfig();
    if (SCHED) render();
  } catch (e) {
    SPORTS_CONFIG[team] = !newState;
    renderSportsConfig();
    alert('Could not update sports recording toggle: ' + e.message);
  }
}

async function recordGame(btn, encodedGame) {
  const game = JSON.parse(decodeURIComponent(encodedGame));
  const origText = btn.textContent;
  btn.disabled = true;
  btn.textContent = 'Scheduling…';
  try {
    const res = await fetch('/api/record-game', {
      method: 'POST',
      headers: {'Content-Type': 'application/json'},
      body: JSON.stringify(game)
    });
    const j = await res.json().catch(() => ({}));
    if (!res.ok || !j.ok) {
      throw new Error(j.error || 'Server error creating recording timer');
    }
    await load();
    if (SCHED) await loadSched();
  } catch (e) {
    alert('Could not record game: ' + e.message);
    btn.disabled = false;
    btn.textContent = origText;
  }
}

function pills(g, past){let h='';
  if(g.season)h+=`<span class="pill season">${esc(g.season)}</span>`;
  if(SPORTS_CONFIG[g.team] === false)h+=`<span class="pill season" title="Auto-record toggled off for ${esc(g.team)}">auto off</span>`;
  const sameGame=g.team&&g.recording&&g.recording.startsWith(g.team+':');
  if(g.recording){
    const label=sameGame?'recording':'other recording overlaps';
    h+=`<span class="pill rec" title="${esc(g.recording)}">${label}</span>`;
  }
  if(!past && !g.done && !sameGame && g.team && g.kind){
    const enc = encodeURIComponent(JSON.stringify(g));
    h+=`<button class="pill btn-rec" onclick="recordGame(this, '${enc}')">Record</button>`;
  }
  if(g.needsPower&&!g.done)h+='<span class="pill warn">needs power</span>';
  return h}

function row(g,past,extra){
  const ct=g.kind?` <span class="tag">(${fCT(g.start)} CT)</span>`:'';
  const ctEnd=g.kind?` (${fCT(g.end)} CT)`:'';
  return `<div class="row${past?' past':''}"><div class="when">${fD(g.start)}${ct}<br>
  <span class="tag">to ${fT(g.end)}${ctEnd}</span></div>
  <div class="what"><b>${esc(g.name)}</b><span class="tag">${
    [g.channel, g.subtitle, g.team||g.source, g.score].filter(Boolean).map(esc).join(' · ')
  }</span></div>
  <div class="pills">${extra||''}${pills(g, past)}</div></div>`}

function tab(w){
  const n=w==='now', s=w==='sched', l=w==='links', e=w==='events';
  document.getElementById('p-now').hidden=!n;
  document.getElementById('p-sched').hidden=!s;
  document.getElementById('p-links').hidden=!l;
  document.getElementById('p-events').hidden=!e;
  document.getElementById('t-now').setAttribute('aria-selected',n);
  document.getElementById('t-sched').setAttribute('aria-selected',s);
  document.getElementById('t-links').setAttribute('aria-selected',l);
  document.getElementById('t-events').setAttribute('aria-selected',e);
  if(s&&!SCHED)loadSched();
  if(l)loadLinks();
  if(e)loadEvents();
}
const EVENT_LABELS = {
  extend: 'Extended recording', trim: 'Trimmed recording (game ended)',
  stall_detected: 'Stall detected', stall_self_recovered: 'Stall self-recovered (no action needed)',
  restore_triggered: 'Auto-restore triggered', stitch_completed: 'Files stitched together',
  stitch_failed: 'Stitch failed', segment_cleanup: 'Archived segments cleaned up',
};
async function loadEvents(){
  const el=document.getElementById('events-body');
  el.innerHTML='<div class="empty">loading…</div>';
  let events;
  try{events=await (await fetch('/api/automation-events')).json()}
  catch(e){el.innerHTML='<div class="err">could not load automation events</div>';return}
  if(!events.length){el.innerHTML='<div class="empty">no automation events logged yet</div>';return}
  el.innerHTML=`<div class="card"><h2>Recent automation activity</h2>${events.map(ev=>{
    const label=EVENT_LABELS[ev.event]||ev.event;
    const dry=ev.dry_run?'<span class="tag">DRY-RUN</span> ':'';
    const okBadge=ev.success===true?'<span class="tag" style="color:var(--ok)">OK</span>'
      :ev.success===false?'<span class="tag" style="color:var(--live)">FAILED</span>':'';
    const skip=new Set(['ts','event','name','timer_id','dry_run','success']);
    const detail=Object.entries(ev).filter(([k])=>!skip.has(k))
      .map(([k,v])=>`${esc(k)}: ${esc(JSON.stringify(v))}`).join(' · ');
    return `<div class="row"><div class="what">
      <div>${dry}<b>${esc(label)}</b> ${okBadge} — ${esc(ev.name||'')}</div>
      <span class="tag">${fD(ev.ts)}</span>
      ${detail?`<div class="tag" style="display:block;margin-top:4px">${detail}</div>`:''}
    </div></div>`;
  }).join('')}</div>`;
}
async function loadLinks(){
  const el=document.getElementById('links-body');
  el.innerHTML='<div class="empty">checking links…</div>';
  let links;
  try{links=await (await fetch('/api/links')).json()}
  catch(e){el.innerHTML='<div class="err">could not check links</div>';return}
  const groups={};
  for(const lk of links)(groups[lk.group]=groups[lk.group]||[]).push(lk);
  el.innerHTML=Object.entries(groups).map(([g,items])=>`
    <div class="card">
      <h2>${esc(g)}</h2>
      ${items.map(lk=>`<div class="row"><div class="what">
        <div class="link-row">
          <span class="dot" style="background:var(${lk.up?'--ok':'--live'})" title="${
            lk.up?'reachable from the server just now':'unreachable from the server just now'}"></span>
          <a href="${esc(lk.url)}" target="_blank" rel="noopener"><b>${esc(lk.label)}</b></a>
        </div>
        <span class="tag">${esc(lk.url)}</span>
      </div></div>`).join('')}
    </div>`).join('');
}
async function load(){
  let d;try{d=await (await fetch('/api/status')).json()}catch(e){
    document.getElementById('sub').textContent='cannot reach server';return}
  PON=d.powerOn; SD=d.shutdownAt;
  document.getElementById('sub').textContent=
    `Power on ${d.powerOn} · off ${d.powerOff} · auto-shutdown ${d.shutdownAt}`;
  const dot=document.getElementById('dot');
  if(d.override){dot.style.background='var(--ok)';
    document.getElementById('pstate').textContent='Staying awake';
    document.getElementById('pnote').textContent='Override until '+fD(d.override)+
      '. The server will not shut itself down before then.'}
  else{dot.style.background='var(--accent)';
    document.getElementById('pstate').textContent='Normal schedule';
    document.getElementById('pnote').textContent=
      'Shuts down at '+d.shutdownAt+' unless a recording is due.'}
  document.getElementById('recs').innerHTML=
    (d.problems||[]).map(p=>`<div class="err">${esc(p)}</div>`).join('')+
    (d.recordings.length?d.recordings.map(r=>row({...r,team:r.source},false,
      r.live?'<span class="pill live">RECORDING</span>':'')).join('')
     :'<div class="empty">Nothing scheduled.</div>');
  document.getElementById('games').innerHTML=d.games.length
    ? d.games.map(g=>row(g,false)).join('')
    : '<div class="empty">No games in the next 10 days.</div>';
}
async function loadSched(){
  const el=document.getElementById('sched');
  el.innerHTML='<div class="empty">loading schedules…</div>';
  try{SCHED=await (await fetch('/api/schedule')).json()}
  catch(e){el.innerHTML='<div class="err">could not load schedules</div>';return}
  const f=document.getElementById('filter');
  f.innerHTML=['All',...SCHED.teams].map(t=>
    `<button aria-pressed="${t===TEAM}" onclick="pick('${esc(t)}')">${esc(t)}</button>`).join('');
  render();
}
function pick(t){TEAM=t;document.querySelectorAll('#filter button')
  .forEach(b=>b.setAttribute('aria-pressed',b.textContent===t));render()}
let showPast=false;
function togglePast(){showPast=!showPast;render()}
function render(){
  const now=new Date(SCHED.now);
  const gs=SCHED.games.filter(g=>TEAM==='All'||g.team===TEAM);
  if(!gs.length){document.getElementById('sched').innerHTML=
    '<div class="empty">No games listed. ESPN publishes schedules closer to the season.</div>';return}
  const past=gs.filter(g=>new Date(g.start)<now);
  const upcoming=gs.filter(g=>new Date(g.start)>=now);
  let html='';
  if(past.length){
    html+=`<button class="act" style="margin-bottom:12px" onclick="togglePast()">${
      showPast?'Hide':'Show'} ${past.length} past game${past.length===1?'':'s'}</button>`;
    if(showPast){
      let month='';
      for(const g of past){
        const m=new Date(g.start).toLocaleString([], {month:'long',year:'numeric'});
        if(m!==month){month=m;html+=`<div class="month">${m}</div>`}
        html+=row(g,true);
      }
    }
  }
  let month='';
  for(const g of upcoming){
    const m=new Date(g.start).toLocaleString([], {month:'long',year:'numeric'});
    if(m!==month){month=m;html+=`<div class="month">${m}</div>`}
    html+=row(g,false);
  }
  if(!upcoming.length&&!(showPast&&past.length))
    html+='<div class="empty">No upcoming games. Tap above to see past ones.</div>';
  document.getElementById('sched').innerHTML=html;
}
async function ov(h){
  const r=await fetch('/api/override',{method:'POST',
    headers:{'Content-Type':'application/json'},body:JSON.stringify({hours:h})});
  const j=await r.json().catch(()=>({}));
  if(j.rechecked){
    note('Override cancelled. It is past '+(SD||'the shutdown time')+
      ', so the nightly check ran again — the server will shut down shortly '+
      'unless a recording is due.',true);
  }
  load();
}
async function keepAwakeTonight(){
  await fetch('/api/override',{method:'POST',
    headers:{'Content-Type':'application/json'},body:JSON.stringify({untilShutdown:true})});
  load();
}
let armed=false, SD=null;
function note(t,show){const n=document.getElementById('sdnote');
  n.innerHTML=t;n.classList.toggle('show',!!show)}
function disarm(){armed=false;const b=document.getElementById('sd');
  b.classList.remove('armed');b.textContent='Shut down now';note('',false)}
async function sd(force){
  const b=document.getElementById('sd');
  if(!armed&&!force){
    armed=true;b.classList.add('armed');b.textContent='Tap again to confirm';
    note('<b>The server will power off.</b> It comes back on its own only when '+
      'the wall timer next restores power (about '+(PON||'04:57')+'). '+
      'If you have switched the timer to always-on, you will have to press the '+
      'power button by hand. Streaming, recordings and this page all stop.',true);
    setTimeout(()=>{if(armed)disarm()},15000);
    return;
  }
  const r=await fetch('/api/shutdown',{method:'POST',
    headers:{'Content-Type':'application/json'},body:JSON.stringify({force:!!force})});
  if(r.status===409){
    const j=await r.json();
    const bits=[...(j.live||[]).map(n=>'<b>recording now:</b> '+esc(n)),
                ...(j.soon||[]).map(n=>'<b>starts soon:</b> '+esc(n)),
                ...(j.problems||[])];
    note('Not shutting down — '+bits.join('; ')+
      '. <button class="act danger" style="margin-top:8px" onclick="sd(true)">'+
      'Shut down anyway</button>',true);
    b.classList.remove('armed');b.textContent='Shut down now';armed=false;
    return;
  }
  note('Shutting down in about a minute. This page will stop responding.',true);
  b.disabled=true;b.textContent='Shutting down…';
}
function loadAll(){load();loadSportsConfig()}
loadAll();setInterval(loadAll,60000);
</script></body></html>"""


class Handler(BaseHTTPRequestHandler):
    protocol_version = "HTTP/1.1"

    def log_message(self, *a):
        pass

    def _send_401(self) -> None:
        body = b"401 Unauthorized\n"
        self.send_response(401)
        self.send_header("WWW-Authenticate", 'Basic realm="DVR"')
        self.send_header("Content-Type", "text/plain")
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(body)

    def _authenticate(self) -> bool:
        auth_header = self.headers.get("Authorization")
        if not auth_header or not auth_header.startswith("Basic "):
            self._send_401()
            return False
        try:
            encoded = auth_header.split(" ", 1)[1].strip()
            decoded = base64.b64decode(encoded).decode("utf-8")
            if ":" not in decoded:
                self._send_401()
                return False
            user, pwd = decoded.split(":", 1)
            if hmac.compare_digest(user, AUTH_USER) and hmac.compare_digest(pwd, AUTH_PASS):
                return True
        except Exception:
            pass
        self._send_401()
        return False

    def _send(self, code: int, body: bytes, ctype: str) -> None:
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(body)

    def _json(self, fn) -> None:
        try:
            body = json.dumps(fn()).encode()
        except Exception as exc:                            # noqa: BLE001
            body = json.dumps({"problems": [str(exc)], "games": [],
                               "recordings": [], "teams": []}).encode()
        self._send(200, body, "application/json")

    def do_GET(self):
        if not self._authenticate():
            return
        if self.path.startswith("/api/status"):
            self._json(status)
        elif self.path.startswith("/api/schedule"):
            self._json(schedule)
        elif self.path.startswith("/api/sports-config"):
            self._json(lambda: load_json_config(SPORTS_CONFIG, DEFAULT_SPORTS_CONFIG))
        elif self.path.startswith("/api/links"):
            self._json(links_status)
        elif self.path.startswith("/api/automation-events"):
            self._json(automation_events)
        elif self.path in ("/", "/index.html"):
            self._send(200, PAGE.encode(), "text/html; charset=utf-8")
        else:
            self._send(404, b"not found", "text/plain")

    def _body(self) -> dict:
        n = int(self.headers.get("Content-Length") or 0)
        return json.loads(self.rfile.read(n) or b"{}")

    def do_POST(self):
        if not self._authenticate():
            return
        if self.path == "/api/override":
            return self._override()
        if self.path == "/api/shutdown":
            return self._shutdown()
        if self.path == "/api/sports-config":
            return self._toggle_config(SPORTS_CONFIG, DEFAULT_SPORTS_CONFIG, key_param="team")
        if self.path == "/api/record-game":
            return self._record_game()
        self._send(404, b"not found", "text/plain")

    def _toggle_config(self, path: Path, defaults: dict, key_param: str = "item"):
        try:
            body = self._body()
        except Exception:
            return self._send(400, b'{"error":"invalid JSON"}', "application/json")

        item_key = body.get(key_param)
        enabled = body.get("enabled")
        if not isinstance(item_key, str) or not isinstance(enabled, bool):
            return self._send(400, b'{"error":"bad request"}', "application/json")

        cfg = load_json_config(path, defaults)
        if item_key not in cfg:
            return self._send(400, b'{"error":"unknown item"}', "application/json")

        cfg[item_key] = enabled
        save_json_config(path, cfg)
        self._send(200, json.dumps({"ok": True, "config": cfg}).encode(), "application/json")

    def _record_game(self):
        try:
            body = self._body()
        except Exception:
            return self._send(400, b'{"error":"invalid JSON"}', "application/json")

        team = body.get("team")
        event_id = body.get("id")
        start_str = body.get("start")
        dry_run_req = bool(body.get("dryRun")) or bool(os.environ.get("DVR_DRY_RUN"))

        if not team or (not event_id and not start_str):
            return self._send(400, b'{"error":"missing game identity (team and id or start required)"}', "application/json")

        now = datetime.now(LOCAL)
        games = all_games(now)
        target_game = None

        for g in games:
            if g["team"] == team:
                if event_id and str(g.get("id")) == str(event_id):
                    target_game = g
                    break
                if start_str and g["start"] == start_str:
                    target_game = g
                    break

        if not target_game:
            kind = body.get("kind") or "baseball"
            try:
                s_dt = datetime.fromisoformat(start_str) if start_str else now
            except ValueError:
                return self._send(400, b'{"error":"invalid start time format"}', "application/json")
            e_str = body.get("end")
            try:
                e_dt = datetime.fromisoformat(e_str) if e_str else s_dt + DURATION.get(kind, timedelta(hours=3))
            except ValueError:
                e_dt = s_dt + DURATION.get(kind, timedelta(hours=3))

            target_game = {
                "id": str(event_id or ""),
                "team": team,
                "kind": kind,
                "name": body.get("name") or f"{team} Game",
                "start": s_dt.isoformat(),
                "end": e_dt.isoformat(),
                "broadcasts": body.get("broadcasts") or [],
            }

        jf_channels = get_jellyfin_channels()
        cid, cname = resolve_channel_id(target_game, jf_channels)
        if not cid:
            return self._send(422, json.dumps({
                "ok": False,
                "error": f"Cannot resolve channel for {target_game['name']} ({cname})"
            }).encode(), "application/json")

        try:
            start_dt = datetime.fromisoformat(target_game["start"])
            end_dt = datetime.fromisoformat(target_game["end"])
        except ValueError:
            return self._send(400, b'{"error":"invalid game start/end datetimes"}', "application/json")

        t_start = start_dt - timedelta(minutes=5)
        t_end = end_dt + timedelta(minutes=15)

        existing_timers = get_existing_timers()
        if is_overlapping_timer(cid, t_start, t_end, existing_timers):
            return self._send(409, json.dumps({
                "ok": False,
                "error": f"An overlapping timer already exists on {cname} for {target_game['name']}"
            }).encode(), "application/json")

        ok, msg, payload = schedule_game_timer(target_game, cid, cname, dry_run=dry_run_req)
        if ok:
            with _lock:
                _sched["at"] = None
            return self._send(200, json.dumps({
                "ok": True,
                "message": f"Timer created for {target_game['name']} on {cname}",
                "channel": cname,
                "dryRun": dry_run_req,
                "payload": payload
            }).encode(), "application/json")
        else:
            return self._send(500, json.dumps({
                "ok": False,
                "error": f"Failed to create timer: {msg}"
            }).encode(), "application/json")

    def _override(self):
        try:
            body = self._body()
            hours = float(body.get("hours", 0))
            until_shutdown = bool(body.get("untilShutdown"))
        except (ValueError, TypeError):
            return self._send(400, b'{"error":"bad request"}', "application/json")
        OVERRIDE.parent.mkdir(parents=True, exist_ok=True)
        now = datetime.now(LOCAL)
        if until_shutdown:
            cutoff = keep_awake_cutoff(now)
            OVERRIDE.write_text(cutoff.isoformat())
            return self._send(200, json.dumps(
                {"ok": True, "until": cutoff.isoformat()}).encode(), "application/json")
        if hours > 0:
            OVERRIDE.write_text((now + timedelta(hours=min(hours, 24))).isoformat())
            return self._send(200, json.dumps({"ok": True}).encode(),
                              "application/json")

        OVERRIDE.unlink(missing_ok=True)
        rechecked = False
        cutoff, _ = todays_power_off(now)
        if now >= cutoff - SHUTDOWN_BUFFER:
            subprocess.Popen(["/usr/local/bin/dvr-clean-shutdown"],
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            rechecked = True
        self._send(200, json.dumps({"ok": True, "rechecked": rechecked}).encode(),
                   "application/json")

    def _shutdown(self):
        force = bool(self._body().get("force"))
        now = datetime.now(LOCAL)
        recs, problems = recordings(now)
        live = [r["name"] for r in recs
                if datetime.fromisoformat(r["start"]) <= now
                <= datetime.fromisoformat(r["end"])]
        soon = [r["name"] for r in recs
                if now < datetime.fromisoformat(r["start"])
                < now + timedelta(hours=2)]
        if (live or soon or problems) and not force:
            return self._send(409, json.dumps({
                "ok": False, "live": live, "soon": soon,
                "problems": problems}).encode(), "application/json")
        OVERRIDE.unlink(missing_ok=True)
        subprocess.Popen(["/usr/sbin/shutdown", "-h", "+1",
                          "Shutdown requested from the DVR dashboard"],
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        self._send(200, json.dumps({"ok": True, "when": "+1 minute"}).encode(),
                   "application/json")


if __name__ == "__main__":
    ThreadingHTTPServer(("0.0.0.0", PORT), Handler).serve_forever()
