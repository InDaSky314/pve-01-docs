.what b{font-weight:600}
.tag{font-size:.72rem;color:var(--dim);display:block}
.pill{font-size:.7rem;padding:2px 8px;border-radius:99px;white-space:nowrap;font-weight:600}
.pill.warn{background:var(--warnbg);color:var(--warn)}
.pill.live{background:var(--live);color:#fff}
.status{display:flex;align-items:center;gap:10px;flex-wrap:wrap}
.dot{width:10px;height:10px;border-radius:50%;flex:0 0 auto}
.big{font-size:1.05rem;font-weight:600}
button{font:inherit;font-weight:600;padding:11px 16px;border-radius:10px;
border:1px solid var(--line);background:var(--card);color:var(--fg);cursor:pointer;
flex:1 1 auto;min-height:44px}
button.primary{background:var(--accent);border-color:var(--accent);color:#fff}
button:active{transform:translateY(1px)}
.btns{display:flex;gap:8px;margin-top:12px;flex-wrap:wrap}
.note{font-size:.8rem;color:var(--dim);margin-top:10px}
.empty{color:var(--dim);font-size:.9rem;padding:6px 0}
.err{background:var(--warnbg);color:var(--warn);border-radius:8px;padding:8px 10px;
font-size:.82rem;margin-bottom:10px}
</style></head><body>
<h1>Media-Core DVR</h1>
<div class="sub" id="sub">loading…</div>
<div class="card">
  <h2>Server power</h2>
  <div class="status"><span class="dot" id="dot"></span><span class="big" id="pstate">…</span></div>
  <div class="note" id="pnote"></div>
  <div class="btns">
    <button class="primary" onclick="ov(12)">Keep awake tonight</button>
    <button onclick="ov(0)">Cancel override</button>
  </div>
  <div class="note"><b>This does not hold the wall timer open.</b>
  It only stops the server shutting itself down. If the physical timer is still
  armed, power is cut anyway — switch it off too.</div>
</div>
<div class="card"><h2>Scheduled recordings</h2><div id="recs"></div></div>
<div class="card"><h2>Upcoming games</h2><div id="games"></div></div>
<script>
const f=s=>{const d=new Date(s);return d.toLocaleString([], {weekday:'short',day:'numeric',
month:'short',hour:'2-digit',minute:'2-digit'})};
const ft=s=>new Date(s).toLocaleTimeString([],{hour:'2-digit',minute:'2-digit'});
function row(when,end,title,tag,pills){
  return `<div class="row"><div class="when">${f(when)}<br><span class="tag">to ${ft(end)}</span></div>
  <div class="what"><b>${title}</b><span class="tag">${tag}</span></div>
  <div>${pills}</div></div>`}
async function load(){
  let d;
  try{d=await (await fetch('/api/status')).json()}catch(e){
    document.getElementById('sub').textContent='cannot reach server';return}
  document.getElementById('sub').textContent=
    `Power on ${d.powerOn} · off ${d.powerOff} · auto-shutdown ${d.shutdownAt}`;
  const dot=document.getElementById('dot');
  if(d.override){dot.style.background='var(--ok)';
    document.getElementById('pstate').textContent='Staying awake';
    document.getElementById('pnote').textContent='Override until '+f(d.override)+
      '. The server will not shut itself down before then.'}
  else{dot.style.background='var(--accent)';
    document.getElementById('pstate').textContent='Normal schedule';
    document.getElementById('pnote').textContent=
      'Shuts down at '+d.shutdownAt+' unless a recording is due.'}
  const rr=document.getElementById('recs');
  rr.innerHTML=(d.problems||[]).map(p=>`<div class="err">${p}</div>`).join('')+
    (d.recordings.length?d.recordings.map(r=>row(r.start,r.end,r.name,r.source,
      (r.live?'<span class="pill live">RECORDING</span> ':'')+
      (r.needsPower?'<span class="pill warn">needs power</span>':''))).join('')
     :'<div class="empty">Nothing scheduled.</div>');
  const gg=document.getElementById('games');
  gg.innerHTML=d.games.length?d.games.map(g=>row(g.start,g.end,g.name,g.team,
    g.needsPower?'<span class="pill warn">outside power window</span>':'')).join('')
    :'<div class="empty">No games in the next 10 days.</div>';
}
async function ov(h){
  await fetch('/api/override',{method:'POST',headers:{'Content-Type':'application/json'},
    body:JSON.stringify({hours:h})});
  load();
}
load();setInterval(load,60000);
</script></body></html>"""


class Handler(BaseHTTPRequestHandler):
    protocol_version = "HTTP/1.1"

    def log_message(self, *a):                             # quiet
        pass

    def _send(self, code: int, body: bytes, ctype: str) -> None:
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(body)

    def do_GET(self):
        if self.path.startswith("/api/status"):
            try:
                body = json.dumps(status()).encode()
            except Exception as exc:                       # noqa: BLE001
                body = json.dumps({"problems": [str(exc)], "games": [],
                                   "recordings": []}).encode()
            self._send(200, body, "application/json")
        elif self.path in ("/", "/index.html"):
            self._send(200, PAGE.encode(), "text/html; charset=utf-8")
        else:
            self._send(404, b"not found", "text/plain")

    def do_POST(self):
        if self.path != "/api/override":
            return self._send(404, b"not found", "text/plain")
        try:
            n = int(self.headers.get("Content-Length") or 0)
            hours = float(json.loads(self.rfile.read(n) or b"{}").get("hours", 0))
        except (ValueError, TypeError):
            return self._send(400, b'{"error":"bad request"}', "application/json")
        OVERRIDE.parent.mkdir(parents=True, exist_ok=True)
        if hours > 0:
            until = datetime.now(LOCAL) + timedelta(hours=min(hours, 24))
            OVERRIDE.write_text(until.isoformat())
        else:
            OVERRIDE.unlink(missing_ok=True)
        self._send(200, json.dumps({"ok": True}).encode(), "application/json")


if __name__ == "__main__":
    ThreadingHTTPServer(("0.0.0.0", PORT), Handler).serve_forever()
