<script>
const fD=s=>new Date(s).toLocaleString([],{weekday:'short',day:'numeric',month:'short',
  hour:'2-digit',minute:'2-digit'});
const fT=s=>new Date(s).toLocaleTimeString([],{hour:'2-digit',minute:'2-digit'});
const esc=s=>String(s).replace(/[<>&]/g,c=>({'<':'&lt;','>':'&gt;','&':'&amp;'}[c]));
let TEAM='All', SCHED=null, PON=null;

function pills(g){let h='';
  if(g.season)h+=`<span class="pill season">${esc(g.season)}</span>`;
  if(g.recording)h+=`<span class="pill rec" title="${esc(g.recording)}">recording</span>`;
  if(g.needsPower&&!g.done)h+='<span class="pill warn">needs power</span>';
  return h}
function row(g,past,extra){
  return `<div class="row${past?' past':''}"><div class="when">${fD(g.start)}<br>
  <span class="tag">to ${fT(g.end)}</span></div>
  <div class="what"><b>${esc(g.name)}</b><span class="tag">${
    [g.channel, g.subtitle, g.team||g.source, g.score].filter(Boolean).map(esc).join(' · ')
  }</span></div>
  <div class="pills">${extra||''}${pills(g)}</div></div>`}

function tab(w){
  const n=w==='now';
  document.getElementById('p-now').hidden=!n;
  document.getElementById('p-sched').hidden=n;
  document.getElementById('t-now').setAttribute('aria-selected',n);
  document.getElementById('t-sched').setAttribute('aria-selected',!n);
  if(!n&&!SCHED)loadSched();
}
async function load(){
  let d;try{d=await (await fetch('/api/status')).json()}catch(e){
    document.getElementById('sub').textContent='cannot reach server';return}
  PON=d.powerOn; SD=d.shutdownAt;
  document.getElementById('sub').textContent=
    `Power on ${d.powerOn} · off ${d.powerOff} · auto-shutdown ${d.shutdownAt}`;
  const dot=document.getElementById('dot');
  if(d.override){dot.style.background='var(--ok)';
    document.getElementById('pstate').textContent='Staying awake';
    document.getElementById('pnote').textContent='Override until '+fD(d.override)+
      '. The server will not shut itself down before then.'}
  else{dot.style.background='var(--accent)';
    document.getElementById('pstate').textContent='Normal schedule';
    document.getElementById('pnote').textContent=
      'Shuts down at '+d.shutdownAt+' unless a recording is due.'}
  document.getElementById('recs').innerHTML=
    (d.problems||[]).map(p=>`<div class="err">${esc(p)}</div>`).join('')+
    (d.recordings.length?d.recordings.map(r=>row({...r,team:r.source},false,
      r.live?'<span class="pill live">RECORDING</span>':'')).join('')
     :'<div class="empty">Nothing scheduled.</div>');
  document.getElementById('games').innerHTML=d.games.length
    ? d.games.map(g=>row(g,false)).join('')
    : '<div class="empty">No games in the next 10 days.</div>';
}
async function loadSched(){
  const el=document.getElementById('sched');
  el.innerHTML='<div class="empty">loading schedules…</div>';
  try{SCHED=await (await fetch('/api/schedule')).json()}
  catch(e){el.innerHTML='<div class="err">could not load schedules</div>';return}
  const f=document.getElementById('filter');
  f.innerHTML=['All',...SCHED.teams].map(t=>
    `<button aria-pressed="${t===TEAM}" onclick="pick('${esc(t)}')">${esc(t)}</button>`).join('');
  render();
}
function pick(t){TEAM=t;document.querySelectorAll('#filter button')
  .forEach(b=>b.setAttribute('aria-pressed',b.textContent===t));render()}
function render(){
  const now=new Date(SCHED.now);
  const gs=SCHED.games.filter(g=>TEAM==='All'||g.team===TEAM);
  if(!gs.length){document.getElementById('sched').innerHTML=
    '<div class="empty">No games listed. ESPN publishes schedules closer to the season.</div>';return}
  let html='',month='';
  for(const g of gs){
    const d=new Date(g.start);
    const m=d.toLocaleString([], {month:'long',year:'numeric'});
    if(m!==month){month=m;html+=`<div class="month">${m}</div>`}
    html+=row(g,d<now);
  }
  document.getElementById('sched').innerHTML=html;
}
async function ov(h){
  const r=await fetch('/api/override',{method:'POST',
    headers:{'Content-Type':'application/json'},body:JSON.stringify({hours:h})});
  const j=await r.json().catch(()=>({}));
  if(j.rechecked){
    note('Override cancelled. It is past '+(SD||'the shutdown time')+
      ', so the nightly check ran again — the server will shut down shortly '+
      'unless a recording is due.',true);
  }
  load();
}
let armed=false, SD=null;
function note(t,show){const n=document.getElementById('sdnote');
  n.innerHTML=t;n.classList.toggle('show',!!show)}
function disarm(){armed=false;const b=document.getElementById('sd');
  b.classList.remove('armed');b.textContent='Shut down now';note('',false)}
async function sd(force){
  const b=document.getElementById('sd');
  if(!armed&&!force){
    armed=true;b.classList.add('armed');b.textContent='Tap again to confirm';
    note('<b>The server will power off.</b> It comes back on its own only when '+
      'the wall timer next restores power (about '+(PON||'04:57')+'). '+
      'If you have switched the timer to always-on, you will have to press the '+
      'power button by hand. Streaming, recordings and this page all stop.',true);
    setTimeout(()=>{if(armed)disarm()},15000);
    return;
  }
  const r=await fetch('/api/shutdown',{method:'POST',
    headers:{'Content-Type':'application/json'},body:JSON.stringify({force:!!force})});
  if(r.status===409){
    const j=await r.json();
    const bits=[...(j.live||[]).map(n=>'<b>recording now:</b> '+esc(n)),
                ...(j.soon||[]).map(n=>'<b>starts soon:</b> '+esc(n)),
                ...(j.problems||[])];
    note('Not shutting down — '+bits.join('; ')+
      '. <button class="act danger" style="margin-top:8px" onclick="sd(true)">'+
      'Shut down anyway</button>',true);
    b.classList.remove('armed');b.textContent='Shut down now';armed=false;
    return;
  }
  note('Shutting down in about a minute. This page will stop responding.',true);
  b.disabled=true;b.textContent='Shutting down…';
}
load();setInterval(load,60000);
</script></body></html>"""


class Handler(BaseHTTPRequestHandler):
    protocol_version = "HTTP/1.1"

    def log_message(self, *a):
        pass

    def _send(self, code: int, body: bytes, ctype: str) -> None:
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(body)

    def _json(self, fn) -> None:
        try:
            body = json.dumps(fn()).encode()
        except Exception as exc:                            # noqa: BLE001
            body = json.dumps({"problems": [str(exc)], "games": [],
                               "recordings": [], "teams": []}).encode()
        self._send(200, body, "application/json")

    def do_GET(self):
        if self.path.startswith("/api/status"):
            self._json(status)
        elif self.path.startswith("/api/schedule"):
            self._json(schedule)
        elif self.path in ("/", "/index.html"):
            self._send(200, PAGE.encode(), "text/html; charset=utf-8")
        else:
            self._send(404, b"not found", "text/plain")

    def _body(self) -> dict:
        n = int(self.headers.get("Content-Length") or 0)
        return json.loads(self.rfile.read(n) or b"{}")

    def do_POST(self):
        if self.path == "/api/override":
            return self._override()
        if self.path == "/api/shutdown":
            return self._shutdown()
        self._send(404, b"not found", "text/plain")

    def _override(self):
        try:
            hours = float(self._body().get("hours", 0))
        except (ValueError, TypeError):
            return self._send(400, b'{"error":"bad request"}', "application/json")
        OVERRIDE.parent.mkdir(parents=True, exist_ok=True)
        now = datetime.now(LOCAL)
        if hours > 0:
            OVERRIDE.write_text((now + timedelta(hours=min(hours, 24))).isoformat())
            return self._send(200, json.dumps({"ok": True}).encode(),
                              "application/json")

        OVERRIDE.unlink(missing_ok=True)
        # Cancelling after the nightly check has already run would otherwise do
        # nothing until tomorrow -- the timer fired hours ago. Re-run the guard
        # so "cancel" means what it looks like it means.
        rechecked = False
        if now.time() >= SHUTDOWN_AT:
            subprocess.Popen(["/usr/local/bin/dvr-clean-shutdown"],
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            rechecked = True
        self._send(200, json.dumps({"ok": True, "rechecked": rechecked}).encode(),
                   "application/json")

    def _shutdown(self):
        force = bool(self._body().get("force"))
        now = datetime.now(LOCAL)
        recs, problems = recordings(now)
        live = [r["name"] for r in recs
                if datetime.fromisoformat(r["start"]) <= now
                <= datetime.fromisoformat(r["end"])]
        soon = [r["name"] for r in recs
                if now < datetime.fromisoformat(r["start"])
                < now + timedelta(hours=2)]
        if (live or soon or problems) and not force:
            return self._send(409, json.dumps({
                "ok": False, "live": live, "soon": soon,
                "problems": problems}).encode(), "application/json")
        OVERRIDE.unlink(missing_ok=True)
        subprocess.Popen(["/usr/sbin/shutdown", "-h", "+1",
                          "Shutdown requested from the DVR dashboard"],
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        self._send(200, json.dumps({"ok": True, "when": "+1 minute"}).encode(),
                   "application/json")


if __name__ == "__main__":
    ThreadingHTTPServer(("0.0.0.0", PORT), Handler).serve_forever()
