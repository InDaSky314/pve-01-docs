<script>
const fD=s=>new Date(s).toLocaleString([],{weekday:'short',day:'numeric',month:'short',
  hour:'2-digit',minute:'2-digit'});
const fT=s=>new Date(s).toLocaleTimeString([],{hour:'2-digit',minute:'2-digit'});
const fCT=s=>new Date(s).toLocaleTimeString([],{hour:'2-digit',minute:'2-digit',
  timeZone:'America/Chicago'});
const esc=s=>String(s).replace(/[<>&]/g,c=>({'<':'&lt;','>':'&gt;','&':'&amp;'}[c]));
let TEAM='All', SCHED=null, PON=null;

const TEAM_BADGES = {
  'Packers': 'NFL',
  'Badgers Football': 'CFB',
  'Badgers Basketball': 'NCAAM',
  'Bucks': 'NBA',
  'Brewers': 'MLB',
  'Bayern Munich': 'BUN'
};
let SPORTS_CONFIG = {};

async function loadSportsConfig() {
  try {
    SPORTS_CONFIG = await (await fetch('/api/sports-config')).json();
    renderSportsConfig();
    if (SCHED) render();
  } catch (e) {
    const el = document.getElementById('sports-toggles');
    if (el) el.innerHTML = '<div class="err">Could not load sports config</div>';
  }
}

function renderSportsConfig() {
  const el = document.getElementById('sports-toggles');
  if (!el) return;
  const teams = Object.keys(SPORTS_CONFIG);
  if (!teams.length) {
    el.innerHTML = '<div class="empty">No sports teams found.</div>';
    return;
  }
  el.innerHTML = teams.map(t => {
    const on = !!SPORTS_CONFIG[t];
    const badge = TEAM_BADGES[t] || '';
    return `<div class="toggle-row">
      <div class="toggle-label">
        <span class="toggle-name">${esc(t)}</span>
        ${badge ? `<span class="badge">${esc(badge)}</span>` : ''}
      </div>
      <div class="toggle-right">
        <span class="toggle-state-text ${on ? 'on' : ''}">${on ? 'Auto ON' : 'Off'}</span>
        <button type="button" role="switch" aria-checked="${on}" aria-label="Toggle ${esc(t)} auto-recording" class="switch" onclick="toggleTeam('${esc(t)}', ${!on})">
          <div class="switch-thumb"></div>
        </button>
      </div>
    </div>`;
  }).join('');
}

async function toggleTeam(team, newState) {
  SPORTS_CONFIG[team] = newState;
  renderSportsConfig();
  try {
    const res = await fetch('/api/sports-config', {
      method: 'POST',
      headers: {'Content-Type': 'application/json'},
      body: JSON.stringify({team: team, enabled: newState})
    });
    const j = await res.json().catch(() => ({}));
    if (!res.ok || !j.ok) throw new Error(j.error || 'Server HTTP error');
    if (j.config) SPORTS_CONFIG = j.config;
    renderSportsConfig();
    if (SCHED) render();
  } catch (e) {
    SPORTS_CONFIG[team] = !newState;
    renderSportsConfig();
    alert('Could not update sports recording toggle: ' + e.message);
  }
}

async function recordGame(btn, encodedGame, engine) {
  const game = JSON.parse(decodeURIComponent(encodedGame));
  game.engine = engine || 'jellyfin';
  const origText = btn.textContent;
  btn.disabled = true;
  btn.textContent = 'Scheduling…';
  try {
    const res = await fetch('/api/record-game', {
      method: 'POST',
      headers: {'Content-Type': 'application/json'},
      body: JSON.stringify(game)
    });
    const j = await res.json().catch(() => ({}));
    if (!res.ok || !j.ok) {
      throw new Error(j.error || 'Server error creating recording timer');
    }
    await load();
    if (SCHED) await loadSched();
  } catch (e) {
    alert('Could not record game: ' + e.message);
    btn.disabled = false;
    btn.textContent = origText;
  }
}

async function cancelBooking(btn, id, engine) {
  if (!confirm('Cancel this recording?')) return;
  const origText = btn.textContent;
  btn.disabled = true;
  btn.textContent = 'Cancelling…';
  try {
    const res = await fetch('/api/cancel-booking', {
      method: 'POST',
      headers: {'Content-Type': 'application/json'},
      body: JSON.stringify({id: id, engine: engine})
    });
    const j = await res.json().catch(() => ({}));
    if (!res.ok || !j.ok) throw new Error(j.error || 'Server error cancelling recording');
    await load();
    if (SCHED) await loadSched();
  } catch (e) {
    alert('Could not cancel recording: ' + e.message);
    btn.disabled = false;
    btn.textContent = origText;
  }
}

function pills(g, past){let h='';
  if(g.season)h+=`<span class="pill season">${esc(g.season)}</span>`;
  if(SPORTS_CONFIG[g.team] === false)h+=`<span class="pill season" title="Auto-record toggled off for ${esc(g.team)}">auto off</span>`;
  const sameGame = g.recordingIsThisGame ||
    (g.team && g.recording && g.recording.startsWith(g.team + ':'));
  if(g.recording){
    const eng = (g.engine || 'Jellyfin').toUpperCase();
    const st = g.bookingStatus ? ` (${g.bookingStatus})` : '';
    const label=sameGame?(g.engine === 'mct' ? `MCT${st}` : `recording (${eng})`):`other recording overlaps (${eng})`;
    h+=`<span class="pill rec" title="${esc(g.recording)}">${esc(label)}</span>`;
    if(sameGame && !past && !g.done && (g.bookingId || g.id)){
      const gid = esc(g.bookingId || g.id);
      const engVal = esc(g.engine || 'jellyfin');
      h+=`<button class="pill btn-cancel" style="background:transparent;border:1px solid var(--live);color:var(--live);cursor:pointer;font-family:inherit;line-height:1.2;margin-left:4px" onclick="cancelBooking(this, '${gid}', '${engVal}')">Cancel</button>`;
    }
  }
  if(!past && !g.done && !sameGame && g.team && g.kind){
    const enc = encodeURIComponent(JSON.stringify(g));
    const gid = 'g' + (g.id || Math.random().toString(36).substring(2, 8));
    h+=`<div class="rec-control">
      <select class="engine-select" id="eng-${gid}" aria-label="Recording engine for ${esc(g.name)}">
        <option value="jellyfin" selected>Jellyfin</option>
        <option value="mct">MCT</option>
      </select>
      <button class="pill btn-rec" onclick="recordGame(this, '${enc}', document.getElementById('eng-${gid}').value)">Record</button>
    </div>`;
  }
  if(g.needsPower&&!g.done)h+='<span class="pill warn">needs power</span>';
  return h}

function row(g,past,extra){
  const ct=g.kind?` <span class="tag">(${fCT(g.start)} CT)</span>`:'';
  const ctEnd=g.kind?` (${fCT(g.end)} CT)`:'';
  return `<div class="row${past?' past':''}"><div class="when">${fD(g.start)}${ct}<br>
  <span class="tag">to ${fT(g.end)}${ctEnd}</span></div>
  <div class="what"><b>${esc(g.name)}</b><span class="tag">${
    [g.channel, g.subtitle, g.team||g.source, g.score].filter(Boolean).map(esc).join(' · ')
  }</span></div>
  <div class="pills">${extra||''}${pills(g, past)}</div></div>`}

function tab(w){
  const n=w==='now', s=w==='sched', l=w==='links', e=w==='events', g=w==='guide';
  document.getElementById('p-now').hidden=!n;
  document.getElementById('p-sched').hidden=!s;
  document.getElementById('p-links').hidden=!l;
  document.getElementById('p-events').hidden=!e;
  document.getElementById('p-guide').hidden=!g;
  document.getElementById('t-now').setAttribute('aria-selected',n);
  document.getElementById('t-sched').setAttribute('aria-selected',s);
  document.getElementById('t-links').setAttribute('aria-selected',l);
  document.getElementById('t-events').setAttribute('aria-selected',e);
  document.getElementById('t-guide').setAttribute('aria-selected',g);
  if(s&&!SCHED)loadSched();
  if(l)loadLinks();
  if(e)loadEvents();
}

let GUIDE_CAT = '';
function setGuideCategory(cat, btn) {
  GUIDE_CAT = cat;
  document.querySelectorAll('#guide-cat-filter button').forEach(b => b.setAttribute('aria-pressed', 'false'));
  btn.setAttribute('aria-pressed', 'true');
  searchGuide();
}

async function searchGuide() {
  const q = document.getElementById('guide-q').value.trim();
  const el = document.getElementById('guide-results');
  if (!q && !GUIDE_CAT) {
    el.innerHTML = '<div class="empty">Type a query or select a category to search.</div>';
    return;
  }
  el.innerHTML = '<div class="empty">Searching EPG…</div>';
  try {
    let url = `/api/epg/search?q=${encodeURIComponent(q)}&limit=25`;
    if (GUIDE_CAT) url += `&category=${encodeURIComponent(GUIDE_CAT)}`;
    const res = await fetch(url);
    const j = await res.json();
    if (!res.ok || !j.results) throw new Error(j.error || 'Failed to search');
    renderGuideResults(j.results);
  } catch (e) {
    el.innerHTML = `<div class="err">Search failed: ${esc(e.message)}</div>`;
  }
}

function renderGuideResults(groups) {
  const el = document.getElementById('guide-results');
  if (!groups.length) {
    el.innerHTML = '<div class="empty">No matching broadcasts found.</div>';
    return;
  }
  el.innerHTML = groups.map(g => {
    const durH = Math.floor(g.duration_sec / 3600);
    const durM = Math.floor((g.duration_sec % 3600) / 60);
    const durStr = durH ? `${durH}h ${durM.toString().padStart(2, '0')}m` : `${durM}m`;
    const sub = g.subtitle ? ` — ${esc(g.subtitle)}` : '';
    const cat = g.category ? `<span class="badge" style="margin-left:6px">${esc(g.category)}</span>` : '';
    
    const chOptions = g.channels.map(c => {
      const rec = c.recommended ? ' [Recommended: Local Market]' : '';
      const deg = c.degraded ? ' [Warning: Degraded Feed]' : '';
      return `<option value="${esc(c.number || c.name)}" data-prog="${esc(c.prog_id)}">${esc(c.number ? c.number + ' ' : '')}${esc(c.name)}${rec}${deg}</option>`;
    }).join('');

    const gJson = encodeURIComponent(JSON.stringify({
      id: 'epg-' + g.channels[0].prog_id,
      title: g.title,
      name: g.title + (g.subtitle ? ' — ' + g.subtitle : ''),
      channel: g.channels[0].number || g.channels[0].name,
      start: g.start_utc,
      end: g.stop_utc,
      duration_sec: g.duration_sec,
      category: g.category || 'Sports',
      genre: g.category || 'Sports'
    }));

    const cardId = 'gc-' + g.id;

    return `<div class="card" style="margin-top:10px" id="${cardId}">
      <div style="display:flex;justify-content:space-between;align-items:baseline;margin-bottom:6px">
        <div><b style="font-size:1.02rem">${esc(g.title)}</b>${sub}${cat}</div>
        <div style="font-size:.85rem;color:var(--dim)">${durStr}</div>
      </div>
      <div style="font-size:.85rem;color:var(--dim);margin-bottom:8px">
        <span>${esc(g.start_local)} – ${esc(g.stop_local.split(' ')[1])} CEST</span>
      </div>
      <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap">
        <select id="ch-${cardId}" style="padding:4px 8px;border-radius:6px;border:1px solid var(--line);background:var(--card);color:var(--fg);font:inherit;font-size:.85rem">
          ${chOptions}
        </select>
        <select id="eng-${cardId}" class="engine-select" style="height:28px">
          <option value="mct">MCT</option>
          <option value="jellyfin">Jellyfin</option>
        </select>
        <button class="pill btn-rec" style="padding:4px 12px;font-size:.82rem" onclick="bookGuideCard('${cardId}', '${gJson}')">Record</button>
      </div>
    </div>`;
  }).join('');
}

async function bookGuideCard(cardId, gJson) {
  const data = JSON.parse(decodeURIComponent(gJson));
  const chSel = document.getElementById('ch-' + cardId);
  const engSel = document.getElementById('eng-' + cardId);
  if (chSel) {
    data.channel = chSel.value;
    const opt = chSel.selectedOptions[0];
    if (opt && opt.dataset.prog) data.id = 'epg-' + opt.dataset.prog;
  }
  if (engSel) data.engine = engSel.value;

  try {
    const res = await fetch('/api/record-game', {
      method: 'POST',
      headers: {'Content-Type': 'application/json'},
      body: JSON.stringify(data)
    });
    const j = await res.json().catch(() => ({}));
    if (!res.ok || !j.ok) throw new Error(j.error || 'Error creating timer');
    alert(j.message || 'Recording booked successfully!');
    if (typeof load === 'function') load();
  } catch (e) {
    alert('Booking refused: ' + e.message);
  }
}
