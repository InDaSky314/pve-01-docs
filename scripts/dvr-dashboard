_jf_token_cache: str | None = None


def get_jf_token() -> str:
    """Read Jellyfin AccessToken from secret file, cached after the first read.

    Falls back to `pct exec 105 -- cat` if local host paths don't exist.
    """
    global _jf_token_cache
    if _jf_token_cache:
        return _jf_token_cache
    for key_file in JF_KEY_FILES:
        if key_file.exists():
            try:
                tok = key_file.read_text().strip()
                if tok:
                    _jf_token_cache = tok
                    return tok
            except Exception as exc:
                sys.stderr.write(f"Failed to read Jellyfin API key file {key_file}: {exc}\n")
    try:
        tok = subprocess.run(
            ["/usr/sbin/pct", "exec", CT, "--", "cat", JELLYFIN_KEY_FILE],
            capture_output=True, text=True, timeout=15, check=True,
        ).stdout.strip()
        if tok:
            _jf_token_cache = tok
            return tok
    except Exception as exc:
        sys.stderr.write(f"Failed to read Jellyfin API key via pct exec into CT{CT}: {exc}\n")
    return ""


def jf_request(endpoint: str, data: dict[str, Any] | None = None, method: str = "GET") -> Any:
    """Execute HTTP request against Jellyfin API."""
    token = get_jf_token()
    if not token:
        return None

    headers = {
        "Authorization": f'MediaBrowser Token="{token}"',
        "Content-Type": "application/json",
        "User-Agent": "SportsDVRDashboard/1.0",
    }
    payload = json.dumps(data).encode("utf-8") if data is not None else None

    for base_url in JF_URLS:
        url = f"{base_url}{endpoint}"
        req = urllib.request.Request(url, data=payload, headers=headers, method=method)
        try:
            with urllib.request.urlopen(req, timeout=10) as resp:
                res_body = resp.read()
                if not res_body:
                    return {}
                return json.loads(res_body)
        except Exception:
            continue

    sys.stderr.write(f"Jellyfin API {method} {endpoint} failed on all URLs\n")
    return None


def get_jellyfin_channels() -> dict[str, str]:
    """Fetch channel list from Jellyfin API or fallback to Threadfin M3U.

    Returns mapping of channel name -> Jellyfin GUID channel ID.
    """
    chans = jf_request("/emby/LiveTv/Channels")
    mapping: dict[str, str] = {}

    if chans and "Items" in chans:
        for c in chans["Items"]:
            cid = c.get("Id")
            cname = c.get("Name", "")
            if cid and cname:
                mapping[cname] = cid
                mapping[cname.lower()] = cid
        return mapping

    tf_urls = ["http://127.0.0.1:34400/m3u/threadfin.m3u", "http://192.168.9.50:34400/m3u/threadfin.m3u"]
    for url in tf_urls:
        try:
            req = urllib.request.Request(url)
            with urllib.request.urlopen(req, timeout=5) as resp:
                m3u_text = resp.read().decode("utf-8", errors="ignore")
                for line in m3u_text.splitlines():
                    if line.startswith("#EXTINF"):
                        parts = line.split(",")
                        cname = parts[-1].strip() if len(parts) > 1 else ""
                        header = parts[0]
                        chno = ""
                        if 'tvg-chno="' in header:
                            chno = header.split('tvg-chno="')[1].split('"')[0]
                        cid = f"hdhr_{chno}" if chno else cname
                        if cname:
                            mapping[cname] = cid
                            mapping[cname.lower()] = cid
                if mapping:
                    return mapping
        except Exception:
            continue

    return mapping


# --- Dynamic PPV team support (Bayern Munich Phase 3, added 2026-08-17) ---
# Some teams (currently just Bayern Munich's English broadcasts) don't air on
# a fixed linear channel -- they air on a dynamically-renamed PPV event slot
# that only gets labeled with the real match info shortly before kickoff.
# resolve_channel_id() below special-cases these teams to scan the live
# provider catalog for a labeled match instead of doing a static name lookup.
# Matching logic (regex patterns, category list, scoring) mirrors
# bayern_ppv_detector.py / bayern_ppv_alert.py (Phase 1/2, see
# /root/pve-01-docs/docs/bayern-bundesliga-dvr-design.md) -- duplicated here
# rather than imported, matching this project's existing convention of each
# deployed script carrying its own copy of small shared logic rather than a
# cross-repo import dependency.
DYNAMIC_PPV_TEAMS = {"Bayern Munich"}

XTREAM_BASE = "http://cf.teltv.xyz"
XTREAM_USER = "c21fa33845e9"
XTREAM_PASS = "3e110912e1"

PPV_TARGET_CATEGORIES = {
    573: {"name": "US| DAZN PPV", "priority": 100},
    575: {"name": "UK| DAZN PPV VIP", "priority": 90},
    1441: {"name": "UK| SKY SPORT+ PPV", "priority": 85},
    1811: {"name": "UK| DAZN PPV", "priority": 80},
    1137: {"name": "DE| BUNDESLIGA HD/4K", "priority": 40},
    433: {"name": "DE| DAZN PPV", "priority": 30},
}

PPV_TEAM_PATTERNS = {
    "Bayern Munich": [re.compile(r"\b(Bayern\s+M[uü]nchen|Bayern\s+Munich|FC\s+Bayern|Bayern)\b", re.IGNORECASE)],
}
PPV_FALSE_POSITIVES = re.compile(
    r"\b(women|frauen|\bII\b|amateure|u19|u17|basketball|bbl|highlights|replay|magazine)\b",
    re.IGNORECASE
)
# Agy's review (20260817T074620Z-bayern-phase3-review.md) caught that this
# candidate's opponent-cross-reference scoring dropped the kickoff-alignment
# and live/next-state bonuses bayern_ppv_detector.py's original scoring uses
# (+40/+10-20 there), leaving max achievable score = category priority + 50.
# At the original 150-point threshold that made Category 573 (US DAZN,
# priority 100) barely pass (150) while every UK category (575/1441/1811,
# priority 80-90) could never pass at all (max 130-140) -- confirmed by
# direct arithmetic, not just Agy's claim. Lowered to 130 so the still-solid
# category+opponent signal is enough; FALSE_POSITIVES already gates out
# highlights/replay/wrong-competition matches before scoring even runs.
PPV_MATCH_THRESHOLD = 130


def _ppv_fetch_streams(cat_id: int) -> list[dict]:
    url = (f"{XTREAM_BASE}/player_api.php?username={XTREAM_USER}&password={XTREAM_PASS}"
           f"&action=get_live_streams&category_id={cat_id}")
    req = urllib.request.Request(url, headers={"User-Agent": "DVRDashboard/1.0"})
    try:
        with urllib.request.urlopen(req, timeout=15) as r:
            return json.load(r)
    except Exception:                                       # noqa: BLE001
        return []


def _ppv_curated_channel_for_stream(stream_id: str) -> tuple[str | None, str | None]:
    """Cross-reference Threadfin's own curated xepg entries (inside CT105) to
    find which already-active curated channel carries this exact live
    stream_id right now. Returns (tvg_chno, channel_name) or (None, None).
    Only DAZN-PPV-group entries are searched (the curated set from Phase 1)."""
    try:
        raw = pct("cat", "/srv/media-core/threadfin/conf/xepg.json", timeout=20)
        xepg = json.loads(raw)
    except Exception:                                       # noqa: BLE001
        return None, None
    needle = f"/{stream_id}.ts"
    for entry in xepg.values():
        if entry.get("group-title") != "DAZN PPV":
            continue
        if entry.get("url", "").endswith(needle):
            return entry.get("tvg-chno"), entry.get("name")
    return None, None


def resolve_dynamic_ppv_channel(team: str, game: dict[str, Any],
                                 jf_channels: dict[str, str]) -> tuple[str | None, str]:
    """Scan the live PPV provider catalog right now for a labeled match for
    `team`, matching bayern_ppv_detector.py's logic. Returns
    (jellyfin_channel_id, channel_name) on a confident match, or
    (None, human-readable reason) otherwise -- the reason surfaces directly
    in the dashboard's error toast via _record_game's 422 response."""
    patterns = PPV_TEAM_PATTERNS.get(team)
    if not patterns:
        return None, f"No PPV matching patterns configured for {team!r}"

    best: tuple[int, dict, dict] | None = None
    for cat_id, cat_info in PPV_TARGET_CATEGORIES.items():
        for stream in _ppv_fetch_streams(cat_id):
            name = stream.get("name", "")
            if PPV_FALSE_POSITIVES.search(name):
                continue
            if not any(p.search(name) for p in patterns):
                continue
            score = cat_info["priority"]
            # Opponent cross-reference boost, same idea as the standalone
            # detector -- game['name'] is ESPN's own short match name, so any
            # word in it besides the team's own name is a reasonable
            # opponent-keyword source to look for in the stream title.
            for word in re.findall(r"\w+", game.get("name", "")):
                lw = word.lower()
                if len(word) > 3 and lw not in ("bayern", "munich", "fc"):
                    if re.search(rf"\b{re.escape(word)}\b", name, re.IGNORECASE):
                        score += 50
                        break
            if best is None or score > best[0]:
                best = (score, stream, cat_info)

    if best is None:
        return None, ("No live PPV slot found for this match yet -- providers often don't "
                       "label the slot until shortly before kickoff. Try again closer to game time.")

    score, stream, cat_info = best
    if score < PPV_MATCH_THRESHOLD:
        return None, f"Best match scored {score} (below the {PPV_MATCH_THRESHOLD}-point confidence threshold)"

    stream_id = str(stream.get("stream_id", ""))
    tvg_chno, curated_name = _ppv_curated_channel_for_stream(stream_id)
    if not curated_name:
        return None, (f"Matched provider stream {stream_id!r} ({stream.get('name','')!r}, score {score}) "
                       "but it isn't one of the curated DAZN PPV channels in Jellyfin -- may need a "
                       "lineup sync (xtream-sync.py) if the provider added slots since Phase 1 was set up.")

    cid = jf_channels.get(curated_name) or jf_channels.get(curated_name.lower())
    if not cid:
        return None, f"Curated channel {curated_name!r} matched but isn't visible in Jellyfin yet -- try a guide refresh"
    return cid, curated_name


def resolve_channel_id(game: dict[str, Any], jf_channels: dict[str, str]) -> tuple[str | None, str]:
    """Resolve broadcast network or EPG channel to Jellyfin channel ID and channel name."""
    team = game.get("team", "")

    # If the game already has an EPG-enriched channel resolved (e.g. "1011 Sky Sport Bundesliga HD")
    g_ch = game.get("channel", "")
    if g_ch and g_ch != "not in guide yet":
        for cname, cid in jf_channels.items():
            if cname.lower() in g_ch.lower() or g_ch.lower() in cname.lower():
                return cid, cname

    broadcasts = game.get("broadcasts") or []

    for bc in broadcasts:
        if bc in STREAMING_NETWORKS:
            return None, f"Streaming Exclusive ({bc})"

        if "Brewers" in bc and "Milwaukee Brewers HD" in jf_channels:
            return jf_channels["Milwaukee Brewers HD"], "Milwaukee Brewers HD"
        if "Bucks" in bc and "Milwaukee Bucks HD" in jf_channels:
            return jf_channels["Milwaukee Bucks HD"], "Milwaukee Bucks HD"

        for cname, cid in jf_channels.items():
            if cname.lower() in bc.lower() or bc.lower() in cname.lower():
                return cid, cname

        preferred_market = LOCAL_MARKET_PREFERENCE.get(team)
        if preferred_market:
            local_matches = [(cid, ch_name) for ch_name, cid in jf_channels.items()
                             if bc.lower() in ch_name.lower() and preferred_market.lower() in ch_name.lower()]
            if local_matches:
                return local_matches[0]

        mapped_name = NETWORK_CHANNEL_MAP.get(bc)
        if mapped_name and (mapped_name in jf_channels or mapped_name.lower() in jf_channels):
            cid = jf_channels.get(mapped_name) or jf_channels.get(mapped_name.lower())
            if cid:
                return cid, mapped_name

        matches = [(cid, ch_name) for ch_name, cid in jf_channels.items() if bc.lower() in ch_name.lower()]
        if matches:
            return matches[0]

    if team in RSN_DEFAULTS:
        rsn_name = RSN_DEFAULTS[team]
        cid = jf_channels.get(rsn_name) or jf_channels.get(rsn_name.lower())
        if cid:
            return cid, rsn_name

    if team in DYNAMIC_PPV_TEAMS:
        return resolve_dynamic_ppv_channel(team, game, jf_channels)

    return None, f"Unmapped ({', '.join(broadcasts) if broadcasts else 'No Broadcast Info'})"


def get_existing_timers() -> list[dict[str, Any]]:
    """Fetch active Jellyfin LiveTv timers."""
    res = jf_request("/emby/LiveTv/Timers")
    return res.get("Items", []) if res else []


def is_overlapping_timer(channel_id: str, start: datetime, end: datetime, existing_timers: list[dict[str, Any]]) -> bool:
    """Check if an existing timer overlaps the given time range on the same channel."""
    for t in existing_timers:
        if t.get("Status") in ("Completed", "Cancelled", "Error"):
            continue
        t_cid = t.get("ChannelId")
        if t_cid != channel_id:
            continue
        try:
            t_start = datetime.fromisoformat(t["StartDate"].replace("Z", "+00:00"))
            t_end = datetime.fromisoformat(t["EndDate"].replace("Z", "+00:00"))
        except (KeyError, ValueError):
            continue

        if t_start < end and t_end > start:
            return True
    return False


def find_matching_program_id(channel_id: str, game_start: datetime) -> str | None:
    """Look up the real EPG Program for a game on this channel, matching by
    start-time proximity (within 30 min). Returns the Program's Id, or None.

    Root-caused 2026-08-16 (Agy independently traced Jellyfin's own server
    source -- see agy-reports/20260816T190057Z-timerdto-investigation.md):
    "IsSports" is not a writable field on the timer-creation DTO at all --
    it's a read-only computed property on the server, populated only by
    copying Tags from a linked EPG Program via ProgramId. The "IsSports":
    True field this function sent (added 2026-08-16, believed to fix
    manually-recorded games landing in "Other") was confirmed via direct
    on-disk inspection to be a silent no-op, same as sports-dvr-auto's
    identical mistake from 2026-08-13. This is the real fix, mirrored from
    sports-dvr-auto's copy of the same helper."""
    # Two match modes (Agy's review, 2026-08-16): proximity to p_start
    # handles normal pre-scheduling; containment (p_start <= target < p_end)
    # handles a lookup for a timestamp deep inside an already-running game.
    programs = jf_request(f"/LiveTv/Programs?ChannelIds={channel_id}&HasAired=false")
    if not programs:
        return None
    # Real bug found + verified 2026-08-17: returning immediately on the
    # first containment hit made this order-dependent on whatever order
    # the API happens to return programs in -- reproduced directly: a
    # loose all-day placeholder block that happens to CONTAIN game_start
    # but appear before the real, much tighter proximity-matched program
    # in the response would win, even though the proximity match is
    # obviously the correct one. Now tracks both and only falls back to
    # containment if no proximity match exists at all (the real reason
    # containment was added: a mid-game restore lookup, where game_start
    # is hours past every program's own start, so proximity can never
    # match to begin with).
    best_id, best_diff = None, None
    containment_id = None
    for p in programs.get("Items", []):
        # Verified live 2026-08-24 (audit F-02, mirrored from
        # sports-dvr-auto's copy of this helper): a non-GUID channel_id
        # (e.g. "hdhr_*") makes Jellyfin silently ignore the ChannelIds
        # filter and return every program in the system, so proximity
        # matching binds to a random show on another channel. Post-filter
        # so a bad id can only produce "no match", never a mis-link.
        if p.get("ChannelId") != channel_id:
            continue
        try:
            p_start = datetime.fromisoformat(str(p["StartDate"]).replace("Z", "+00:00"))
            p_end = datetime.fromisoformat(str(p["EndDate"]).replace("Z", "+00:00"))
        except (KeyError, ValueError, TypeError, AttributeError):
            continue
        if p_start <= game_start < p_end:
            containment_id = p.get("Id")
        diff = abs((p_start - game_start).total_seconds())
        if diff <= 1800 and (best_diff is None or diff < best_diff):
            best_id, best_diff = p.get("Id"), diff
    return best_id or containment_id


def schedule_game_timer(game: dict[str, Any], channel_id: str, channel_name: str, dry_run: bool = False, pad_sec: int = 0) -> tuple[bool, str, dict[str, Any]]:
    """Create a Jellyfin LiveTv timer for a game or EPG program."""
    start_dt = game["start"] if isinstance(game["start"], datetime) else datetime.fromisoformat(game["start"])
    end_dt = game["end"] if isinstance(game["end"], datetime) else datetime.fromisoformat(game["end"])

    start_utc = start_dt.astimezone(timezone.utc)
    end_utc = end_dt.astimezone(timezone.utc)

    start_iso = (start_utc - timedelta(minutes=5)).strftime("%Y-%m-%dT%H:%M:%SZ")
    end_iso = (end_utc + timedelta(minutes=15)).strftime("%Y-%m-%dT%H:%M:%SZ")
    raw_name = game.get("name") or game.get("title") or "Recording"
    team = game.get("team")
    name = f"{team}: {raw_name}" if (team and not raw_name.startswith(team)) else raw_name

    program_id = find_matching_program_id(channel_id, start_utc)

    post_padding = pad_sec if pad_sec > 0 else 1800
    payload = {
        "Type": "Timer",
        "ChannelId": channel_id,
        "ChannelName": channel_name,
        # Required. Without it, Jellyfin's CreateTimer looks up a service named "" and throws 500.
        "ServiceName": "Emby",
        "Name": name,
        "StartDate": start_iso,
        "EndDate": end_iso,
        "PrePaddingSeconds": 300,
        "PostPaddingSeconds": post_padding,
    }
    if program_id:
        payload["ProgramId"] = program_id

    if dry_run:
        return True, "dry-run", payload

    res = jf_request("/emby/LiveTv/Timers", data=payload, method="POST")
    if res is not None:
        return True, "success", payload
    return False, "failed to create timer in Jellyfin", payload


