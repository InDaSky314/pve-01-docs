class Handler(BaseHTTPRequestHandler):
    protocol_version = "HTTP/1.1"

    def log_message(self, *a):
        pass

    def _send_401(self) -> None:
        body = b"401 Unauthorized\n"
        self.send_response(401)
        self.send_header("WWW-Authenticate", 'Basic realm="DVR"')
        self.send_header("Content-Type", "text/plain")
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(body)

    def _authenticate(self) -> bool:
        auth_header = self.headers.get("Authorization")
        if not auth_header or not auth_header.startswith("Basic "):
            self._send_401()
            return False
        try:
            encoded = auth_header.split(" ", 1)[1].strip()
            decoded = base64.b64decode(encoded).decode("utf-8")
            if ":" not in decoded:
                self._send_401()
                return False
            user, pwd = decoded.split(":", 1)
            if hmac.compare_digest(user, AUTH_USER) and hmac.compare_digest(pwd, AUTH_PASS):
                return True
        except Exception:
            pass
        self._send_401()
        return False

    def _send(self, code: int, body: bytes, ctype: str) -> None:
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(body)

    def _json(self, fn) -> None:
        try:
            body = json.dumps(fn()).encode()
        except Exception as exc:                            # noqa: BLE001
            body = json.dumps({"problems": [str(exc)], "games": [],
                               "recordings": [], "teams": []}).encode()
        self._send(200, body, "application/json")

    def do_GET(self):
        if not self._authenticate():
            return
        if self.path.startswith("/api/status"):
            self._json(status)
        elif self.path.startswith("/api/schedule"):
            self._json(schedule)
        elif self.path.startswith("/api/sports-config"):
            self._json(lambda: load_json_config(SPORTS_CONFIG, DEFAULT_SPORTS_CONFIG))
        elif self.path.startswith("/api/links"):
            self._json(links_status)
        elif self.path.startswith("/api/automation-events"):
            self._json(automation_events)
        elif self.path.startswith("/api/epg/search"):
            self._epg_search()
        elif self.path in ("/", "/index.html"):
            self._send(200, PAGE.encode(), "text/html; charset=utf-8")
        else:
            self._send(404, b"not found", "text/plain")

    def _epg_search(self):
        try:
            parsed = urllib.parse.urlparse(self.path)
            params = urllib.parse.parse_qs(parsed.query)
            q = params.get("q", [""])[0].strip()
            cat = params.get("category", [""])[0].strip()
            limit = params.get("limit", ["25"])[0].strip()

            cmd = ["/usr/local/bin/epg-find", "--json"]
            if q:
                cmd.append(q)
            if cat:
                cmd.extend(["--category", cat])
            if limit and limit.isdigit():
                cmd.extend(["-n", limit])

            res = subprocess.run(cmd, capture_output=True, text=True, timeout=15)
            if res.returncode != 0:
                return self._send(500, json.dumps({"ok": False, "error": f"epg-find failed: {res.stderr.strip()}"}).encode(), "application/json")

            self._send(200, res.stdout.encode("utf-8"), "application/json")
        except Exception as exc:
            self._send(500, json.dumps({"ok": False, "error": str(exc)}).encode(), "application/json")

    def _body(self) -> dict:
        n = int(self.headers.get("Content-Length") or 0)
        return json.loads(self.rfile.read(n) or b"{}")

    def do_POST(self):
        if not self._authenticate():
            return
        if self.path == "/api/override":
            return self._override()
        if self.path == "/api/shutdown":
            return self._shutdown()
        if self.path == "/api/sports-config":
            return self._toggle_config(SPORTS_CONFIG, DEFAULT_SPORTS_CONFIG, key_param="team")
        if self.path == "/api/record-game":
            return self._record_game()
        if self.path in ("/api/cancel-booking", "/api/cancel-game"):
            return self._cancel_booking()
        self._send(404, b"not found", "text/plain")

    def _toggle_config(self, path: Path, defaults: dict, key_param: str = "item"):
        try:
            body = self._body()
        except Exception:
            return self._send(400, b'{"error":"invalid JSON"}', "application/json")

        item_key = body.get(key_param)
        enabled = body.get("enabled")
        if not isinstance(item_key, str) or not isinstance(enabled, bool):
            return self._send(400, b'{"error":"bad request"}', "application/json")

        cfg = load_json_config(path, defaults)
        if item_key not in cfg:
            return self._send(400, b'{"error":"unknown item"}', "application/json")

        cfg[item_key] = enabled
        save_json_config(path, cfg)
        self._send(200, json.dumps({"ok": True, "config": cfg}).encode(), "application/json")

    def _cancel_booking(self):
        try:
            body = self._body()
        except Exception:
            return self._send(400, b'{"error":"invalid JSON"}', "application/json")

        bid = str(body.get("id") or "").strip()
        engine = str(body.get("engine", "")).lower()
        if not bid:
            return self._send(400, b'{"error":"missing id"}', "application/json")

        cancelled = False
        msg = ""

        if engine in ("mct", ""):
            bookings = load_mct_bookings()
            for b in bookings:
                # Ids are not unique in this store - a game re-booked after an earlier
                # cancel leaves both records under the same id. Matching the first hit
                # silently "cancelled" an already-cancelled record and left the live
                # booking running, so skip anything already in a terminal state.
                if b.get("status") in ("cancelled", "done", "failed"):
                    continue
                if str(b.get("id")) == bid or str(b.get("name")) == bid or str(b.get("title")) == bid:
                    if b.get("unit"):
                        try:
                            subprocess.run(["systemctl", "stop", b["unit"]], check=False)
                        except Exception:
                            pass
                    if b.get("status") == "running" and b.get("pid"):
                        try:
                            os.kill(b["pid"], signal.SIGTERM)
                        except Exception:
                            pass
                    b["status"] = "cancelled"
                    b["cancelled_at"] = datetime.now(LOCAL).isoformat()
                    save_mct_bookings(bookings)
                    cancelled = True
                    msg = f"MCT booking '{b.get('title') or b.get('name')}' cancelled"
                    break

        if not cancelled and engine in ("jellyfin", ""):
            timers = get_existing_timers()
            for t in timers:
                if str(t.get("Id")) == bid or str(t.get("ProgramId")) == bid or str(t.get("Name")) == bid:
                    tid = t.get("Id")
                    res = jf_request(f"/emby/LiveTv/Timers/{tid}", method="DELETE")
                    if res is not None or res == {}:
                        cancelled = True
                        msg = f"Jellyfin timer '{t.get('Name')}' cancelled"
                        break

        if cancelled:
            with _lock:
                _sched["at"] = None
            return self._send(200, json.dumps({"ok": True, "message": msg, "id": bid}).encode(), "application/json")
        else:
            return self._send(404, json.dumps({"ok": False, "error": f"Booking or timer '{bid}' not found"}).encode(), "application/json")

    def _record_game(self):
        try:
            body = self._body()
        except Exception:
            return self._send(400, b'{"error":"invalid JSON"}', "application/json")

        title = body.get("title") or body.get("name") or body.get("team") or ""
        team = body.get("team") or title
        event_id = body.get("id")
        start_str = body.get("start")
        engine = str(body.get("engine", "jellyfin")).lower()
        dry_run_req = bool(body.get("dryRun")) or bool(os.environ.get("DVR_DRY_RUN"))
        pad_sec = int(body.get("pad_sec", 0))

        if not title or (not event_id and not start_str):
            return self._send(400, b'{"error":"missing programme identity (title/team and id or start required)"}', "application/json")

        if engine not in ("jellyfin", "mct"):
            return self._send(400, b'{"error":"engine must be jellyfin or mct"}', "application/json")

        now = datetime.now(LOCAL)
        games = all_games(now)
        target_game = None

        for g in games:
            if g.get("team") == team or g.get("name") == title:
                if event_id and str(g.get("id")) == str(event_id):
                    target_game = g
                    break
                if start_str and g["start"] == start_str:
                    target_game = g
                    break

        if not target_game:
            kind = body.get("kind") or "sports"
            try:
                s_dt = datetime.fromisoformat(start_str.replace("Z", "+00:00")).astimezone(LOCAL) if start_str else now
            except ValueError:
                return self._send(400, b'{"error":"invalid start time format"}', "application/json")
            e_str = body.get("end")
            dur_sec = body.get("duration_sec")
            try:
                if e_str:
                    e_dt = datetime.fromisoformat(e_str.replace("Z", "+00:00")).astimezone(LOCAL)
                elif dur_sec:
                    e_dt = s_dt + timedelta(seconds=int(dur_sec))
                else:
                    e_dt = s_dt + DURATION.get(kind, timedelta(hours=3))
            except ValueError:
                e_dt = s_dt + DURATION.get(kind, timedelta(hours=3))

            target_game = {
                "id": str(event_id or ""),
                "team": team,
                "kind": kind,
                "name": body.get("name") or title,
                "title": title,
                "start": s_dt.isoformat(),
                "end": e_dt.isoformat(),
                "broadcasts": body.get("broadcasts") or [],
                "pad_sec": pad_sec,
            }

        jf_channels = get_jellyfin_channels()
        chmap = channel_names()
        cid = cname = None
        if target_game.get("broadcasts"):
            cid, cname = resolve_channel_id(target_game, jf_channels)

        ch_override = str(body.get("channel") or "").strip()
        if ch_override:
            _cid = _cname = None
            if ch_override.isdigit():
                _r = jf_request("/emby/LiveTv/Channels?Limit=3000") or {}
                for _c in (_r.get("Items") or []):
                    if str(_c.get("Number") or "") == ch_override:
                        _cid, _cname = _c.get("Id"), _c.get("Name")
                        break
            else:
                for _n, _i in jf_channels.items():
                    if _n.lower() == ch_override.lower():
                        _cid, _cname = _i, _n
                        break
            if _cid:
                cid, cname = _cid, _cname
            else:
                if not cname:
                    cname = ch_override

        if engine == "jellyfin" and not cid:
            return self._send(422, json.dumps({
                "ok": False,
                "error": f"Cannot resolve Jellyfin channel for {target_game['name']} ({cname or ch_override})"
            }).encode(), "application/json")

        try:
            start_dt = datetime.fromisoformat(target_game["start"])
            end_dt = datetime.fromisoformat(target_game["end"])
        except ValueError:
            return self._send(400, b'{"error":"invalid game start/end datetimes"}', "application/json")

        t_start = start_dt - timedelta(minutes=5)
        t_end = end_dt + timedelta(seconds=max(900, pad_sec))
        c_disp = chmap.get(cid) or chmap.get(cname) or (f"{ch_override} {cname}".strip() if ch_override else cname)

        # 1. Single-tuner conflict check: Check for overlapping Jellyfin timers across ALL channels
        existing_timers = get_existing_timers()
        for t in existing_timers:
            if t.get("Status") in ("Completed", "Cancelled", "Error"):
                continue
            try:
                jt_start = datetime.fromisoformat(t["StartDate"].replace("Z", "+00:00")).astimezone(LOCAL) - timedelta(seconds=t.get("PrePaddingSeconds") or 0)
                jt_end = datetime.fromisoformat(t["EndDate"].replace("Z", "+00:00")).astimezone(LOCAL) + timedelta(seconds=t.get("PostPaddingSeconds") or 0)
            except Exception:
                continue
            if jt_start < t_end and jt_end > t_start:
                t_name = t.get("Name", "scheduled recording")
                t_cname = t.get("ChannelName") or t.get("ChannelId") or "channel"
                s_str = jt_start.strftime("%H:%M")
                e_str = jt_end.strftime("%H:%M")
                return self._send(409, json.dumps({
                    "ok": False,
                    "error": f"Tuner conflict: overlapping Jellyfin timer '{t_name}' on {t_cname} ({s_str}–{e_str} CEST)"
                }).encode(), "application/json")

        # 2. Single-tuner conflict check: Check for overlapping MCT bookings across ALL channels
        mct_bookings = load_mct_bookings()
        for b in mct_bookings:
            if b.get("status") in ("cancelled", "done", "failed"):
                continue
            try:
                bs = datetime.fromisoformat(b["start"]).astimezone(LOCAL) - timedelta(minutes=5)
                duration_sec = int(b.get("duration_sec", 0))
                b_pad = int(b.get("fixed_pad") or 900)
                be = datetime.fromisoformat(b["start"]).astimezone(LOCAL) + timedelta(seconds=duration_sec) + timedelta(seconds=b_pad)
            except Exception:
                continue
            if bs < t_end and be > t_start:
                b_title = b.get("title") or b.get("name") or "MCT recording"
                b_ch = b.get("channel_display") or b.get("channel") or "channel"
                s_str = bs.strftime("%H:%M")
                e_str = be.strftime("%H:%M")
                return self._send(409, json.dumps({
                    "ok": False,
                    "error": f"Tuner conflict: overlapping MCT capture '{b_title}' on {b_ch} ({s_str}–{e_str} CEST)"
                }).encode(), "application/json")

        rec_name = target_game.get("name") or title
        if target_game.get("team") and not rec_name.startswith(target_game["team"]):
            rec_name = f"{target_game['team']}: {rec_name}"

        if engine == "jellyfin":
            ok, msg, payload = schedule_game_timer(target_game, cid, cname, dry_run=dry_run_req, pad_sec=pad_sec)
            if ok:
                with _lock:
                    _sched["at"] = None
                return self._send(200, json.dumps({
                    "ok": True,
                    "engine": "jellyfin",
                    "message": f"Jellyfin timer created for {rec_name} on {c_disp}",
                    "channel": c_disp,
                    "dryRun": dry_run_req,
                    "payload": payload
                }).encode(), "application/json")
            else:
                return self._send(500, json.dumps({
                    "ok": False,
                    "error": f"Failed to create Jellyfin timer: {msg}"
                }).encode(), "application/json")

        elif engine == "mct":
            duration_sec = int((end_dt - start_dt).total_seconds())
            if duration_sec <= 0:
                duration_sec = int(DURATION.get(target_game.get("kind", "sports"), timedelta(hours=3)).total_seconds())

            c_num = "".join(ch for ch in c_disp.split()[0] if ch.isdigit()) if c_disp else ""
            mct_ch_arg = ch_override if ch_override else (c_num if c_num else cname)
            booking_id = str(target_game.get("id") or f"mct-{int(start_dt.timestamp())}")

            booking_entry = {
                "id": booking_id,
                "channel": mct_ch_arg,
                "title": rec_name,
                "name": rec_name,
                "start": start_dt.isoformat(),
                "end": end_dt.isoformat(),
                "duration_sec": duration_sec,
                "status": "booked",
                "created_at": now.isoformat(),
                "team": target_game.get("team"),
                "channel_number": c_num,
                "channel_name": cname or c_disp,
                "channel_display": c_disp,
                "category": body.get("category") or "Sports",
                "genre": body.get("genre") or "Sports",
                "engine": "mct"
            }
            if pad_sec > 0:
                booking_entry["fixed_pad"] = pad_sec

            if not dry_run_req:
                mct_bookings.append(booking_entry)
                save_mct_bookings(mct_bookings)

            with _lock:
                _sched["at"] = None

            return self._send(200, json.dumps({
                "ok": True,
                "engine": "mct",
                "message": f"MCT booking created for {rec_name} on {c_disp} at {start_dt.strftime('%Y-%m-%d %H:%M')}",
                "channel": c_disp,
                "dryRun": dry_run_req,
                "booking": booking_entry
            }).encode(), "application/json")

    def _override(self):
        try:
            body = self._body()
            hours = float(body.get("hours", 0))
            until_shutdown = bool(body.get("untilShutdown"))
        except (ValueError, TypeError):
            return self._send(400, b'{"error":"bad request"}', "application/json")
        OVERRIDE.parent.mkdir(parents=True, exist_ok=True)
        now = datetime.now(LOCAL)
        if until_shutdown:
            cutoff = keep_awake_cutoff(now)
            OVERRIDE.write_text(cutoff.isoformat())
            return self._send(200, json.dumps(
                {"ok": True, "until": cutoff.isoformat()}).encode(), "application/json")
        if hours > 0:
            OVERRIDE.write_text((now + timedelta(hours=min(hours, 24))).isoformat())
            return self._send(200, json.dumps({"ok": True}).encode(),
                              "application/json")

        OVERRIDE.unlink(missing_ok=True)
        rechecked = False
        cutoff, _ = todays_power_off(now)
        if now >= cutoff - SHUTDOWN_BUFFER:
            subprocess.Popen(["/usr/local/bin/dvr-clean-shutdown"],
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            rechecked = True
        self._send(200, json.dumps({"ok": True, "rechecked": rechecked}).encode(),
                   "application/json")

    def _shutdown(self):
        force = bool(self._body().get("force"))
        now = datetime.now(LOCAL)
        recs, problems = recordings(now)
        live = [r["name"] for r in recs
                if datetime.fromisoformat(r["start"]) <= now
                <= datetime.fromisoformat(r["end"])]
        soon = [r["name"] for r in recs
                if now < datetime.fromisoformat(r["start"])
                < now + timedelta(hours=2)]
        if (live or soon or problems) and not force:
            return self._send(409, json.dumps({
                "ok": False, "live": live, "soon": soon,
                "problems": problems}).encode(), "application/json")
        OVERRIDE.unlink(missing_ok=True)
        subprocess.Popen(["/usr/sbin/shutdown", "-h", "+1",
                          "Shutdown requested from the DVR dashboard"],
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        self._send(200, json.dumps({"ok": True, "when": "+1 minute"}).encode(),
                   "application/json")


if __name__ == "__main__":
    ThreadingHTTPServer(("0.0.0.0", PORT), Handler).serve_forever()
