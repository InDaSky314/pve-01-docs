    # Design doc's risk-mitigation note (bayern-bundesliga-dvr-design.md
    # 4.2): 2h30m baseline for soccer, deliberately no oversized buffer that
    # would risk capturing an adjacent PPV event on the same dynamic slot.
    "soccer": timedelta(hours=2, minutes=30),
}

