# --- Dynamic PPV team support (Bayern Munich auto-record, added 2026-08-24) ---
# Ported from dvr-dashboard's Phase 3 implementation (2026-08-17), same
# duplication-over-import convention. Bayern's English broadcasts air on
# dynamically-labeled PPV slots that only get the real match name shortly
# before kickoff, so channel resolution is deferred until close to game time
# (PPV_RESOLVE_WINDOW) and retried every scheduler cycle until a confident
# match appears.
DYNAMIC_PPV_TEAMS = {"Bayern Munich"}

# Threadfin group-titles holding curated PPV event slots, and the matching
# channel-name prefixes. Extended 2026-08-25 when the GB DAZN and Sky
# Sports+ blocks were added to the lineup -- before that only the US DAZN
# block existed, which is why a match carried on a UK slot could be scored
# confidently and then not be recordable at all.
PPV_GROUP_TITLES = {"DAZN PPV", "DAZN PPV GB", "Sky Sports+ PPV"}
PPV_CHANNEL_PREFIXES = ("dazn ppv", "dazn ppv gb", "sky sports+ event")


def is_ppv_channel_name(name: str) -> bool:
    return (name or "").lower().startswith(PPV_CHANNEL_PREFIXES)
PPV_RESOLVE_WINDOW = timedelta(hours=6)

# Linear-channel safety net for dynamic-PPV teams (added 2026-08-24 per owner
# request, generalized from the one-off timer hand-created for the 8/28
# Stuttgart match). The English PPV slot can't be resolved until hours before
# kickoff and might never get labeled at all, so EVERY dynamic-PPV fixture
# also gets a timer on a fixed linear channel booked days ahead. It carries
# the wrong-language commentary, so it is deliberately disposable:
# check_ppv_fallback_cancellation() drops it the moment the English
# recording is PROVEN to be capturing bytes. Net effect: the match is never
# missed, and in the normal case the owner never sees the fallback at all.
DYNAMIC_PPV_FALLBACK = {
    # No EPG is published for the Sky Bundesliga channels in this lineup
    # (verified 2026-08-24: zero programmes across all 34 in the fixture
    # window), so the channel can't be chosen per-match from guide data --
    # Sky's main Bundesliga channel is the correct default for a Bayern
    # fixture. A wrong-channel fallback costs nothing the English path
    # doesn't already cover; a missing fallback costs the match.
    "Bayern Munich": "Sky Sport Bundesliga 1 HD (720P)",
}
# Suffix that marks a timer as a disposable fallback. Kept as "(German feed)"
# so the timer hand-created for 8/28 before this automation existed is picked
# up by it rather than being orphaned or duplicated.
PPV_FALLBACK_MARKER = "(German feed)"
# The English recording must have written at least this much before the
# fallback is dropped. A timer flipping to InProgress proves only that
# Jellyfin started -- not that the provider is actually delivering. 50 MB is
# a few seconds of HD, comfortably above "opened the file and stalled".
PPV_FALLBACK_MIN_BYTES = 50_000_000

# --- Probe-then-commit sequencing (owner's design, 2026-08-25) ---
# The provider entitlement is ONE concurrent stream (owner-confirmed), and
# Threadfin advertises TunerCount=1 to Jellyfin (verified in
# /discover.json), so the English PPV recording and the German fallback can
# NEVER run at the same time -- one of them has to be given up BEFORE
# kickoff. A labeled PPV slot is not proof the slot actually carries the
# match, so committing blind risks recording nothing.
#
# The sequencing: once a slot is confidently identified, start the English
# recording EARLY -- during pregame -- so the channel gets PROVEN while
# there is still time to change our minds. If bytes flow, we keep it (and
# gain the pregame). If they don't, we cancel it and put the German
# fallback back, with minutes to spare before kickoff. Worst realistic
# case is losing a little pregame, never the match.
PPV_PROBE_LEAD = timedelta(minutes=40)        # begin probing this far out
PPV_PROBE_VERDICT_AFTER = timedelta(minutes=4)  # judge the probe after this long
PPV_PROBE_ABANDON_BY = timedelta(minutes=8)   # must be back on a fallback by kickoff-8m
PPV_PROBE_MIN_BYTES = 20_000_000              # bytes that prove the channel is live
PPV_PROBE_STATE_FILE = Path("/var/lib/dvr-dashboard/ppv-probe-state.json")

XTREAM_BASE = "http://cf.teltv.xyz"
XTREAM_USER = "c21fa33845e9"
XTREAM_PASS = "3e110912e1"

PPV_TARGET_CATEGORIES = {
    573: {"name": "US| DAZN PPV", "priority": 100},
    575: {"name": "UK| DAZN PPV VIP", "priority": 90},
    1441: {"name": "UK| SKY SPORT+ PPV", "priority": 85},
    1811: {"name": "UK| DAZN PPV", "priority": 80},
    1137: {"name": "DE| BUNDESLIGA HD/4K", "priority": 40},
    433: {"name": "DE| DAZN PPV", "priority": 30},
}

PPV_TEAM_PATTERNS = {
    "Bayern Munich": [re.compile(r"\b(Bayern\s+M[uü]nchen|Bayern\s+Munich|FC\s+Bayern|Bayern)\b", re.IGNORECASE)],
}
PPV_FALSE_POSITIVES = re.compile(
    r"\b(women|frauen|\bII\b|amateure|u19|u17|basketball|bbl|highlights|replay|magazine)\b",
    re.IGNORECASE
)
# See dvr-dashboard for the threshold arithmetic (Agy's Phase 3 review,
# 20260817T074620Z): max achievable score is category priority + 50, so 130
# lets every English category pass on category+opponent signal alone.
PPV_MATCH_THRESHOLD = 130


def _ppv_fetch_streams(cat_id: int) -> tuple[list[dict], str | None]:
    """Returns (streams, error). The error is reported rather than swallowed
    (2026-08-24): this provider returns HTTP 403 for a "Python-urllib/*"
    User-Agent -- verified directly, a custom UA on the identical URL returns
    200 -- so a future refactor that drops the UA header, or any provider
    outage, would have silently yielded [] and been indistinguishable from
    "no slot labeled yet". That would have quietly downgraded a match to the
    German fallback with nothing logged as wrong."""
    url = (f"{XTREAM_BASE}/player_api.php?username={XTREAM_USER}&password={XTREAM_PASS}"
           f"&action=get_live_streams&category_id={cat_id}")
    req = urllib.request.Request(url, headers={"User-Agent": "SportsDVRAuto/1.0"})
    try:
        with urllib.request.urlopen(req, timeout=15) as r:
            return json.load(r), None
    except Exception as exc:                                # noqa: BLE001
        return [], f"cat {cat_id}: {exc}"


# Provider slot labels carry a status prefix before the first "|" --
# confirmed live 2026-08-24 across all six PPV categories, only two values
# occur: "Live" (event in progress) and "End" (event finished). The original
# Phase 3 port ignored this entirely, so a slot still labeled
# "End | Bayern Munich vs ..." from a PREVIOUS fixture could out-score and
# steal the booking from the real upcoming match.
_PPV_STATUS_RE = re.compile(r"^\s*(live|end)\s*\|", re.IGNORECASE)


def _ppv_slot_status(name: str) -> str | None:
    m = _PPV_STATUS_RE.match(name or "")
    return m.group(1).lower() if m else None


def _ppv_curated_channel_for_stream(stream_id: str) -> str | None:
    """Find which curated DAZN-PPV Threadfin channel carries this provider
    stream_id right now, by reading CT105's xepg.json. Returns the curated
    channel name or None."""
    try:
        raw = subprocess.run(
            ["/usr/sbin/pct", "exec", "105", "--", "cat",
             "/srv/media-core/threadfin/conf/xepg.json"],
            capture_output=True, text=True, timeout=20, check=True,
        ).stdout
        xepg = json.loads(raw)
    except Exception:                                       # noqa: BLE001
        return None
    needle = f"/{stream_id}.ts"
    for entry in xepg.values():
        if entry.get("group-title") not in PPV_GROUP_TITLES:
            continue
        if entry.get("url", "").endswith(needle):
            return entry.get("name")
    return None


def resolve_dynamic_ppv_channel(team: str, game: dict[str, Any],
                                 jf_channels: dict[str, str]) -> tuple[str | None, str]:
    """Scan the live PPV provider catalog for a labeled match for `team`.
    Returns (jellyfin_channel_id, channel_name) on a confident match, or
    (None, human-readable skip reason)."""
    now = datetime.now(timezone.utc)
    if game["start"] - now > PPV_RESOLVE_WINDOW:
        return None, (f"PPV slot not expected to be labeled yet "
                       f"(game is {(game['start'] - now).total_seconds() / 3600:.1f}h out; "
                       f"resolution starts {PPV_RESOLVE_WINDOW.total_seconds() / 3600:.0f}h before kickoff)")
    patterns = PPV_TEAM_PATTERNS.get(team)
    if not patterns:
        return None, f"No PPV matching patterns configured for {team!r}"

    best: tuple[int, dict, dict] | None = None
    errors: list[str] = []
    fetched_any = False
    for cat_id, cat_info in PPV_TARGET_CATEGORIES.items():
        streams, err = _ppv_fetch_streams(cat_id)
        if err:
            errors.append(err)
            continue
        fetched_any = True
        for stream in streams:
            name = stream.get("name", "")
            if PPV_FALSE_POSITIVES.search(name):
                continue
            if not any(p.search(name) for p in patterns):
                continue
            # A finished event's slot is never the right booking target.
            status = _ppv_slot_status(name)
            if status == "end":
                logging.info("[PPV] Ignoring finished slot %r", name[:70])
                continue
            score = cat_info["priority"]
            if status == "live":
                score += 20
            for word in re.findall(r"\w+", game.get("name", "")):
                lw = word.lower()
                if len(word) > 3 and lw not in ("bayern", "munich", "fc"):
                    if re.search(rf"\b{re.escape(word)}\b", name, re.IGNORECASE):
                        score += 50
                        break
            if best is None or score > best[0]:
                best = (score, stream, cat_info)

    if not fetched_any:
        # Every category failed: this is a provider/network/credential
        # problem, NOT "the slot isn't labeled yet". Say so loudly, because
        # the quiet version of this silently costs the English recording.
        msg = f"PPV provider unreachable -- all {len(PPV_TARGET_CATEGORIES)} category fetches failed: {errors[:3]}"
        logging.error("[PPV] %s", msg)
        log_event("ppv_provider_unreachable", None, game.get("name", ""),
                  {"errors": errors}, dry_run=False)
        return None, msg
    if errors:
        logging.warning("[PPV] %d of %d category fetches failed (continuing with the rest): %s",
                        len(errors), len(PPV_TARGET_CATEGORIES), errors[:3])

    if best is None:
        return None, "No live PPV slot labeled for this match yet -- retrying every cycle until kickoff"
    score, stream, cat_info = best
    if score < PPV_MATCH_THRESHOLD:
        return None, f"Best PPV match scored {score} (below {PPV_MATCH_THRESHOLD} confidence threshold)"

    stream_id = str(stream.get("stream_id", ""))
    curated_name = _ppv_curated_channel_for_stream(stream_id)
    if not curated_name:
        # Measured 2026-08-24: the curated "DAZN PPV NN" block covers
        # category 573 (US DAZN) essentially completely -- 99 of 100 slots
        # map -- and covers categories 575/1441/1811 NOT AT ALL (0 of 235).
        # So a confident match on a UK slot dies right here. That is a
        # lineup-coverage gap, not a transient miss: it will not fix itself
        # on the next cycle, and it is the difference between getting the
        # English recording and silently falling back to German commentary.
        # Alert instead of logging it like an ordinary skip.
        msg = (f"PPV slot for this match was FOUND and scored {score} "
               f"({stream.get('name', '')!r}, provider stream {stream_id}) but that stream is not in "
               "the curated DAZN PPV channel block, so it cannot be recorded. The curated block "
               "currently covers the US DAZN category only; UK categories are not carried. "
               "Fix: add those slots to the live lineup (xtream-sync live_selections) and re-sync.")
        logging.error("[PPV] %s", msg)
        log_event("ppv_slot_unmapped", None, game.get("name", ""),
                  {"stream_id": stream_id, "stream_name": stream.get("name", ""),
                   "score": score, "category": cat_info.get("name")}, dry_run=False)
        notify(f"DVR: English PPV slot found but NOT recordable -- {game.get('name', '')}",
               [msg, "", "The German-feed fallback timer is still in place, so the match will "
                        "still be captured -- with German commentary."])
        return None, msg
    cid = jf_channels.get(curated_name) or jf_channels.get(curated_name.lower())
    if not cid:
        return None, f"Curated channel {curated_name!r} matched but isn't visible in Jellyfin yet"
    logging.info("[PPV] Resolved %s -> curated channel %r (provider stream %s, score %d)",
                 game.get("name", "?"), curated_name, stream_id, score)
    return cid, curated_name

logging.basicConfig(level=logging.INFO, format="%(asctime)s [%(levelname)s] %(message)s")


def load_sports_config() -> dict[str, bool]:
    """Read sports auto-record per-team config from shared state file."""
    if not SPORTS_CONFIG_FILE.exists():
        try:
            SPORTS_CONFIG_FILE.parent.mkdir(parents=True, exist_ok=True)
            SPORTS_CONFIG_FILE.write_text(json.dumps(DEFAULT_SPORTS_CONFIG, indent=2) + "\n")
            logging.info("Initialized default sports config at %s", SPORTS_CONFIG_FILE)
            return dict(DEFAULT_SPORTS_CONFIG)
        except Exception as exc:
            logging.error("Failed to write sports config file %s: %s", SPORTS_CONFIG_FILE, exc)
            return dict(DEFAULT_SPORTS_CONFIG)
    try:
        data = json.loads(SPORTS_CONFIG_FILE.read_text())
        if isinstance(data, dict):
            updated = False
            for k, v in DEFAULT_SPORTS_CONFIG.items():
                if k not in data:
                    data[k] = v
                    updated = True
            if updated:
                try:
                    SPORTS_CONFIG_FILE.write_text(json.dumps(data, indent=2) + "\n")
                except Exception:
                    pass
            return data
    except Exception as exc:
        logging.error("Failed reading sports config file %s: %s", SPORTS_CONFIG_FILE, exc)
    return dict(DEFAULT_SPORTS_CONFIG)


_jf_token_cache: str | None = None


def get_jf_token() -> str:
    """Read Jellyfin AccessToken from secret file, cached after the first read."""
    global _jf_token_cache
    if _jf_token_cache:
        return _jf_token_cache
    for key_file in JF_KEY_FILES:
        if key_file.exists():
            try:
                tok = key_file.read_text().strip()
                if tok:
                    _jf_token_cache = tok
                    return tok
            except Exception as exc:
                logging.error("Failed to read Jellyfin API key file %s: %s", key_file, exc)
    try:
        tok = subprocess.run(
            ["/usr/sbin/pct", "exec", "105", "--", "cat", "/srv/media-core/.jellyfin_api_key"],
            capture_output=True, text=True, timeout=15, check=True,
        ).stdout.strip()
        if tok:
            _jf_token_cache = tok
            return tok
    except Exception as exc:
        logging.error("Failed to read Jellyfin API key via pct exec into CT105: %s", exc)
    logging.error("No valid Jellyfin API key found in %s or via pct exec", JF_KEY_FILES)
    return ""


def jf_request(endpoint: str, data: dict[str, Any] | None = None, method: str = "GET") -> Any:
    """Execute HTTP request against Jellyfin API."""
    token = get_jf_token()
    if not token:
        return None

    headers = {
        "Authorization": f'MediaBrowser Token="{token}"',
        "Content-Type": "application/json",
        "User-Agent": "SportsDVRAuto/1.0",
    }
    payload = json.dumps(data).encode("utf-8") if data is not None else None

    for base_url in JF_URLS:
        url = f"{base_url}{endpoint}"
        req = urllib.request.Request(url, data=payload, headers=headers, method=method)
        try:
            with urllib.request.urlopen(req, timeout=20) as resp:
                res_body = resp.read()
                if not res_body:
                    return {}
                return json.loads(res_body)
        except Exception:
            continue

    logging.error("Jellyfin API %s %s failed on all URLs: %s", method, endpoint, JF_URLS)
    return None


def fetch_espn_schedule() -> list[dict[str, Any]]:
    """Fetch schedule for all 5 followed teams from ESPN API."""
    games: list[dict[str, Any]] = []
    seen_ids: set[str] = set()

    for team_label, sport_path, team_id in TEAMS:
        if team_label in DYNAMIC_PPV_TEAMS:
            continue  # soccer fixtures come from the /scoreboard block below
        kind = sport_path.split("/")[0]
        for stype in SEASON_TYPES:
            url = f"https://site.api.espn.com/apis/site/v2/sports/{sport_path}/teams/{team_id}/schedule?seasontype={stype}"
            req = urllib.request.Request(url)
            try:
                with urllib.request.urlopen(req, timeout=15) as resp:
                    data = json.load(resp)
            except Exception as exc:
                logging.warning("ESPN API fetch failed for %s (seasontype=%d): %s", team_label, stype, exc)
                continue

            for event in data.get("events", []):
                event_id = event.get("id")
                if not event_id or event_id in seen_ids:
                    continue
                seen_ids.add(event_id)

                try:
                    start_dt = datetime.fromisoformat(event["date"].replace("Z", "+00:00"))
                except (KeyError, ValueError):
                    continue

                competitions = event.get("competitions") or [{}]
                comp = competitions[0]
                status_obj = comp.get("status") or {}
                status_type = status_obj.get("type") or {}

                broadcast_names: list[str] = []
                for bc in comp.get("broadcasts") or []:
                    m_short = (bc.get("media") or {}).get("shortName")
                    if m_short:
                        broadcast_names.append(m_short)
                    for n in bc.get("names") or []:
                        if n and n not in broadcast_names:
                            broadcast_names.append(n)

                duration = DURATIONS.get(kind, timedelta(hours=3))
                end_dt = start_dt + duration

                games.append({
                    "id": event_id,
                    "team": team_label,
                    "kind": kind,
                    "name": event.get("name") or event.get("shortName") or "Game",
                    "shortName": event.get("shortName") or "",
                    "start": start_dt,
                    "end": end_dt,
                    "broadcasts": broadcast_names,
                    "state": status_type.get("state", "pre"),
                    "completed": bool(status_type.get("completed", False)),
                    "status_detail": status_type.get("detail") or status_type.get("shortDetail") or "",
                })

    # Scoreboard fallback for dynamic-PPV teams (ported 2026-08-24 from
    # dvr-dashboard's Phase 3 block, where this was found the hard way):
    # ESPN's /schedule endpoint doesn't reliably carry soccer fixtures --
    # ger.pokal?seasontype=1 returns HTTP 400 and ger.1?seasontype=2 returns
    # 0 events even while the real upcoming match sits on /scoreboard.
    # Without this, no Bayern fixture ever reaches the auto-scheduler.
    now_utc = datetime.now(timezone.utc)
    dynamic_leagues = {sport for label, sport, _ in TEAMS if label in DYNAMIC_PPV_TEAMS}
    for sport_path in dynamic_leagues:
        try:
            req = urllib.request.Request(
                f"https://site.api.espn.com/apis/site/v2/sports/{sport_path}/scoreboard")
            with urllib.request.urlopen(req, timeout=15) as resp:
                data = json.load(resp)
        except Exception as exc:                              # noqa: BLE001
            # ger.pokal's scoreboard 400s outside active cup rounds -- routine.
            logging.debug("ESPN scoreboard fetch failed for %s: %s", sport_path, exc)
            continue
        kind = sport_path.split("/")[0]
        for ev in data.get("events", []):
            # Match on the FULL name; shortName ("VFB @ MUN") doesn't
            # contain "Bayern" at all (confirmed against the live response
            # during Phase 3).
            full_name = ev.get("name") or ev.get("shortName") or ""
            matched_label = next(
                (lbl for lbl in DYNAMIC_PPV_TEAMS
                 if any(p.search(full_name) for p in PPV_TEAM_PATTERNS.get(lbl, []))),
                None)
            if not matched_label:
                continue
            event_id = ev.get("id")
            if not event_id or event_id in seen_ids:
                continue
            try:
                start_dt = datetime.fromisoformat(ev["date"].replace("Z", "+00:00"))
            except (KeyError, ValueError):
                continue
            # UEFA scoreboards return whole-slate fixture lists, not just
            # today's -- keep future/recently-started matches only.
            if start_dt < now_utc - timedelta(hours=3):
                continue
            seen_ids.add(event_id)
            comp = (ev.get("competitions") or [{}])[0]
            status_type = ((comp.get("status") or {}).get("type") or {})
            broadcast_names = []
            for bc in comp.get("broadcasts") or []:
                for n in bc.get("names") or []:
                    if n and n not in broadcast_names:
                        broadcast_names.append(n)
            games.append({
                "id": event_id,
                "team": matched_label,
                "kind": kind,
                "name": full_name,
                "shortName": ev.get("shortName") or "",
                "start": start_dt,
                "end": start_dt + DURATIONS.get(kind, timedelta(hours=3)),
                "broadcasts": broadcast_names,
                "state": status_type.get("state", "pre"),
                "completed": bool(status_type.get("completed", False)),
                "status_detail": status_type.get("detail") or status_type.get("shortDetail") or "",
            })

    games.sort(key=lambda g: g["start"])
    return games


def get_jellyfin_channels() -> dict[str, str]:
    """Fetch channel list from Jellyfin API or fallback to Threadfin M3U."""
    chans = jf_request("/emby/LiveTv/Channels")
    mapping: dict[str, str] = {}

    if chans and "Items" in chans:
        for c in chans["Items"]:
            cid = c.get("Id")
            cname = c.get("Name", "")
            if cid and cname:
                mapping[cname] = cid
                mapping[cname.lower()] = cid
        return mapping

    tf_urls = ["http://127.0.0.1:34400/m3u/threadfin.m3u", "http://192.168.9.50:34400/m3u/threadfin.m3u"]
    for url in tf_urls:
        try:
            req = urllib.request.Request(url)
            with urllib.request.urlopen(req, timeout=5) as resp:
                m3u_text = resp.read().decode("utf-8", errors="ignore")
                for line in m3u_text.splitlines():
                    if line.startswith("#EXTINF"):
                        parts = line.split(",")
                        cname = parts[-1].strip() if len(parts) > 1 else ""
                        header = parts[0]
                        chno = ""
                        if 'tvg-chno="' in header:
                            chno = header.split('tvg-chno="')[1].split('"')[0]
                        cid = f"hdhr_{chno}" if chno else cname
                        if cname:
                            mapping[cname] = cid
                            mapping[cname.lower()] = cid
                if mapping:
                    logging.info("Loaded %d channels from Threadfin M3U fallback (%s)", len(mapping) // 2, url)
                    return mapping
        except Exception:
            continue

    logging.warning("Could not load channel lineup from Jellyfin API or Threadfin M3U.")
    return mapping


def resolve_channel_id(game: dict[str, Any], jf_channels: dict[str, str]) -> tuple[str | None, str]:
    """Resolve ESPN broadcast network to Jellyfin channel ID and channel name."""
    team = game["team"]
    if team in DYNAMIC_PPV_TEAMS:
        return resolve_dynamic_ppv_channel(team, game, jf_channels)
    broadcasts = game["broadcasts"]

    # Local-carriage priority (added 2026-08-22): ESPN's broadcast list is
    # unordered from our point of view -- for the 8/21 Packers@Broncos game
    # it was ['NFL Net', 'Packers TV Network', 'KUSA-TV (9NEWS)'], and the
    # first-match loop below locked onto NFL Network before ever considering
    # the local broadcast. Reorder so the team's own network (and, for teams
    # with a LOCAL_MARKET_PREFERENCE, any broadcast that resolves to a
    # channel in that market) is tried FIRST; national cable is the fallback,
    # not the default.
    team_networks = TEAM_NETWORK_BROADCASTS.get(team, ())
    preferred_market_global = LOCAL_MARKET_PREFERENCE.get(team)

    def _broadcast_priority(bc: str) -> int:
        if bc in team_networks:
            return 0
        if preferred_market_global:
            mapped = NETWORK_CHANNEL_MAP.get(bc, "")
            if preferred_market_global.lower() in mapped.lower():
                return 1
            if any(bc.lower() in n.lower() and preferred_market_global.lower() in n.lower()
                   for n in jf_channels):
                return 1
        return 2

    broadcasts = sorted(broadcasts, key=_broadcast_priority)

    if team in RSN_DEFAULTS:
        rsn_name = RSN_DEFAULTS[team]
        if rsn_name in jf_channels or rsn_name.lower() in jf_channels:
            cid = jf_channels.get(rsn_name) or jf_channels.get(rsn_name.lower())
            if cid:
                return cid, rsn_name

    for bc in broadcasts:
        if bc in STREAMING_NETWORKS:
            return None, f"Streaming Exclusive ({bc})"

        if "Brewers" in bc and "Milwaukee Brewers HD" in jf_channels:
            return jf_channels["Milwaukee Brewers HD"], "Milwaukee Brewers HD"
        if "Bucks" in bc and "Milwaukee Bucks HD" in jf_channels:
            return jf_channels["Milwaukee Bucks HD"], "Milwaukee Bucks HD"

        # Bug found + fixed 2026-08-14, same investigation as the
        # LOCAL_MARKET_PREFERENCE fix below: NETWORK_CHANNEL_MAP hardcodes
        # CBS/FOX/ABC/NBC to a single Madison affiliate for every team --
        # checked below, before the market-aware match -- so it would have
        # kept silently overriding the Green Bay preference for any Packers
        # game on one of those networks (the majority of a real NFL season)
        # even after adding LOCAL_MARKET_PREFERENCE. Check for a genuine
        # local-market match FIRST; only fall through to the generic
        # national mapping if this team has no preference or no match
        # exists for it.
        preferred_market = LOCAL_MARKET_PREFERENCE.get(team)
        if preferred_market:
            local_matches = [(cid, ch_name) for ch_name, cid in jf_channels.items()
                             if bc.lower() in ch_name.lower() and preferred_market.lower() in ch_name.lower()]
            if local_matches:
                return local_matches[0]

        mapped_name = NETWORK_CHANNEL_MAP.get(bc)
        if mapped_name and (mapped_name in jf_channels or mapped_name.lower() in jf_channels):
            cid = jf_channels.get(mapped_name) or jf_channels.get(mapped_name.lower())
            if cid:
                return cid, mapped_name

        # Bug found + fixed 2026-08-14: this used to return on the FIRST
        # channel whose name contained the broadcast network name, with no
        # regard for which market it's from -- if both a Green Bay and a
        # Pittsburgh affiliate carry the same national network, which one
        # got picked was arbitrary (whatever order the channel dict happened
        # to iterate in). Now collects every match and, if this team has a
        # LOCAL_MARKET_PREFERENCE, prefers whichever match actually names
        # that market; otherwise falls back to the first match exactly as
        # before (unchanged behavior for teams without a defined preference).
        matches = [(cid, ch_name) for ch_name, cid in jf_channels.items() if bc.lower() in ch_name.lower()]
        if matches:
            preferred_market = LOCAL_MARKET_PREFERENCE.get(team)
            if preferred_market:
                local_matches = [m for m in matches if preferred_market.lower() in m[1].lower()]
                if local_matches:
                    return local_matches[0]
            return matches[0]

    if team in RSN_DEFAULTS:
        rsn_name = RSN_DEFAULTS[team]
        cid = jf_channels.get(rsn_name) or jf_channels.get(rsn_name.lower())
        if cid:
            return cid, rsn_name

    return None, f"Unmapped ({', '.join(broadcasts) if broadcasts else 'No Broadcast Info'})"


def get_existing_timers() -> list[dict[str, Any]]:
    """Fetch active Jellyfin LiveTv timers."""
    res = jf_request("/emby/LiveTv/Timers")
    return res.get("Items", []) if res else []


def is_overlapping_timer(channel_id: str, start: datetime, end: datetime, existing_timers: list[dict[str, Any]],
                         timer_name: str | None = None) -> bool:
    """Check if an existing timer overlaps the given time range on the same
    channel -- or, when timer_name is given, an identically-named timer in
    the same window on ANY channel (2026-08-24 audit: a broadcast remap
    between scheduler runs, like the 8/22 NFL-Network->WGBA fix, would
    otherwise create a second timer for the same game on the new channel
    while the old one kept recording the old channel)."""
    for t in existing_timers:
        if t.get("Status") in ("Completed", "Cancelled", "Error"):
            continue
        # ChannelId is the API GUID; ExternalChannelId (hdhr_*) is checked
        # too in case a DTO ever arrives with only the external id set.
        t_cid = t.get("ChannelId") or t.get("ExternalChannelId")
        same_name = bool(timer_name) and t.get("Name") == timer_name
        if t_cid != channel_id and not same_name:
            continue
        try:
            t_start = datetime.fromisoformat(t["StartDate"].replace("Z", "+00:00"))
            t_end = datetime.fromisoformat(t["EndDate"].replace("Z", "+00:00"))
        except (KeyError, ValueError):
            continue

        if t_start < end and t_end > start:
            return True
    return False


def find_matching_program_id(channel_id: str, game_start: datetime) -> str | None:
    """Look up the real EPG Program for a game on this channel, matching by
    start-time proximity (within 30 min). Returns the Program's Id, or None
    if nothing close enough is found.

    Root-caused 2026-08-16 (Agy independently traced Jellyfin's own server
    source -- TimerInfoDto.cs, TimerInfo.cs, DefaultLiveTvService.cs,
    RecordingsManager.cs -- see
    agy-reports/20260816T190057Z-timerdto-investigation.md): "IsSports" is
    NOT a writable field on the timer-creation DTO at all. It's a read-only
    computed property on the server (`Tags.Contains("Sports")`), and Tags
    only ever gets populated by copying it from a linked EPG Program --
    either via an explicit ProgramId on timer creation, or Jellyfin's own
    fallback (a +/-3 minute search around the timer's StartDate, which our
    own -5min pre-padding offset broke anyway). The "IsSports": True field
    this project sent for months (fixed here 2026-08-13, believed working,
    actually a silent no-op the whole time -- confirmed via direct
    inspection of a real one-off timer tonight, on-disk IsSports stayed
    false despite the field being sent) never did anything. The only real
    fix is linking to the actual Program via ProgramId."""
    # Two match modes, both needed (Agy's review caught the gap, 2026-08-16):
    # proximity to p_start handles normal pre-scheduling (the game's real
    # start may be a few minutes off from ESPN's own listed time), but a
    # restore triggered hours into a game needs containment matching
    # (p_start <= target < p_end) instead -- a restore's "start" is deep
    # into the game, nowhere near the program's own StartDate.
    programs = jf_request(f"/LiveTv/Programs?ChannelIds={channel_id}&HasAired=false")
    if not programs:
        return None
    # Verified live 2026-08-24 (Agy's audit F-02, reproduced directly): if
    # channel_id isn't a real Jellyfin channel GUID (e.g. an "hdhr_*"
    # ExternalChannelId, which is what the on-disk timers.json carries),
    # Jellyfin SILENTLY IGNORES the ChannelIds filter and returns every
    # program in the system (19,984 at test time) -- proximity matching then
    # binds to whatever airs closest on ANY channel (test hit: a Hallmark
    # movie for a Packers query). Post-filter on the returned programs' own
    # ChannelId so a bad id can only ever produce "no match", never a
    # cross-channel mis-link. Normal callers pass API GUIDs and are
    # unaffected; the disk-fallback restore path is the one this protects.
    # Real bug found + verified 2026-08-17 (mirrored from dvr-dashboard's
    # identical copy of this function, same review): returning on the
    # first containment hit made this order-dependent on whatever order
    # the API returns programs in -- reproduced directly with a loose
    # all-day placeholder block that CONTAINS game_start but happens to
    # appear before the real, tighter proximity match. Now falls back to
    # containment only when no proximity match exists at all (the real
    # reason it was added: a mid-game restore lookup, where game_start is
    # hours past every program's own start).
    best_id, best_diff = None, None
    containment_id = None
    for p in programs.get("Items", []):
        if p.get("ChannelId") != channel_id:
            continue
        try:
            p_start = datetime.fromisoformat(str(p["StartDate"]).replace("Z", "+00:00"))
            p_end = datetime.fromisoformat(str(p["EndDate"]).replace("Z", "+00:00"))
        except (KeyError, ValueError, TypeError, AttributeError):
            continue
        if p_start <= game_start < p_end:
            containment_id = p.get("Id")
        diff = abs((p_start - game_start).total_seconds())
        if diff <= 1800 and (best_diff is None or diff < best_diff):
            best_id, best_diff = p.get("Id"), diff
    return best_id or containment_id


def schedule_game_timer(game: dict[str, Any], channel_id: str, channel_name: str, dry_run: bool = True,
                        name_suffix: str = "") -> bool:
    """Create a Jellyfin LiveTv timer for a game.

    name_suffix marks a timer as something other than the primary recording
    (currently only PPV_FALLBACK_MARKER). The name is load-bearing in two
    places: _timer_matches_game_identity uses it to authorize trims, and
    check_ppv_fallback_cancellation uses the suffix to find disposable
    fallbacks -- so it must stay derived from the same
    "{team}: {game name}" base the primary timer uses."""
    start_iso = (game["start"] - timedelta(minutes=5)).strftime("%Y-%m-%dT%H:%M:%SZ")
    end_iso = (game["end"] + timedelta(minutes=15)).strftime("%Y-%m-%dT%H:%M:%SZ")
    name = f"{game['team']}: {game['name']}"
    if name_suffix:
        name = f"{name} {name_suffix}"

    program_id = find_matching_program_id(channel_id, game["start"])
    if program_id:
        logging.info("[SCHEDULE] Matched EPG program %s for %s -- recording will be correctly categorized", program_id, name)
    else:
        logging.warning("[SCHEDULE] No matching EPG program found within 30 min for %s -- timer will still be created, but won't auto-categorize as Sports", name)

    logging.info("[SCHEDULE] Proposed timer: %s on %s (%s to %s)", name, channel_name, start_iso, end_iso)

    if dry_run:
        logging.info("  [DRY-RUN] Would call POST /emby/LiveTv/Timers%s", f" with ProgramId={program_id}" if program_id else "")
        return True

    payload = {
        "Type": "Timer",
        "ChannelId": channel_id,
        "ChannelName": channel_name,
        "ServiceName": "Emby",
        "Name": name,
        "StartDate": start_iso,
        "EndDate": end_iso,
        "PrePaddingSeconds": 300,
        "PostPaddingSeconds": 1800,
    }
    if program_id:
        payload["ProgramId"] = program_id
    res = jf_request("/emby/LiveTv/Timers", data=payload, method="POST")
    if res is not None:
        logging.info("  [SUCCESS] Timer created for %s", name)
        return True
    logging.error("  [FAILED] Could not create timer for %s", name)
    return False


def extend_active_timer(timer: dict[str, Any], new_end: datetime, dry_run: bool = True,
                        post_padding_seconds: int | None = None) -> bool:
    """Update EndDate of an existing timer in Jellyfin.

    post_padding_seconds: pass 0 when TRIMMING a timer for a game that's
    already final (found in review, 2026-08-17) -- the timer's original
    PostPaddingSeconds (typically 1800s/30min, meant to catch a live
    game running long) survives a naive dict(timer) copy otherwise, so a
    'trim to now+5min' would actually still record until now+5min+30min,
    since Jellyfin adds padding on top of EndDate. Leave it None (keep
    the original padding) for the EXTEND case, where the game is still
    in progress and the padding is still exactly what you want."""
    tid = timer["Id"]
    new_end_iso = new_end.strftime("%Y-%m-%dT%H:%M:%SZ")
    timer_name = timer.get("Name", "Timer")

    logging.info("[EXTEND] Extending timer %s (%s) to %s%s", timer_name, tid, new_end_iso,
                 f" (PostPadding: {post_padding_seconds}s)" if post_padding_seconds is not None else "")

    if dry_run:
        logging.info("  [DRY-RUN] Would call POST /emby/LiveTv/Timers/%s", tid)
        return True

    updated_timer = dict(timer)
    updated_timer["EndDate"] = new_end_iso
    if post_padding_seconds is not None:
        updated_timer["PostPaddingSeconds"] = post_padding_seconds

    res = jf_request(f"/emby/LiveTv/Timers/{tid}", data=updated_timer, method="POST")
    if res is not None:
        logging.info("  [SUCCESS] Timer %s extended", tid)
        return True
    logging.error("  [FAILED] Could not extend timer %s", tid)
    return False


def check_uncategorized_timers(dry_run: bool = True) -> None:
    """Backfill ProgramId on 'New' timers created before a matching EPG
    program existed yet (a game scheduled further out than the provider's
    EPG lookahead window -- confirmed real 2026-08-16, the Packers/Broncos
    game 6 days out had zero EPG data for that date at scheduling time).
    Runs every cycle; each pass retries, since EPG data fills in day by day
    as the game approaches.

    Root-caused 2026-08-16: Jellyfin's timer-update endpoint
    (POST /LiveTv/Timers/{id}) returns 204 but does NOT actually persist a
    newly-added ProgramId -- confirmed via a real throwaway timer (create
    without ProgramId, POST an update with it added, re-GET showed
    ProgramId still None). Update-in-place does not work; the only way to
    backfill categorization is cancel + recreate.

    Safety ordering matters here and is deliberately the OPPOSITE of
    trigger_auto_restore's cancel-first pattern: that function is rescuing
    an already-broken stalled recording, so cancelling first costs nothing
    if the recreate then fails. Here the original timer is working fine --
    cancelling it first for a purely cosmetic categorization improvement,
    then failing to recreate it, would turn a working scheduled recording
    into a missed one. So: create the new ProgramId-linked timer FIRST, and
    only cancel the original if that succeeds. Worst case is a brief moment
    where two timer objects exist for the same slot -- harmless, since
    neither is "InProgress" yet (both New), so there's no real tuner
    contention, only Status=InProgress recordings actually hold a tuner. If
    creation fails for any reason (including Jellyfin rejecting the
    would-be overlap), the original timer is left completely untouched and
    this is retried next cycle."""
    logging.info("=== Checking for uncategorized timers (ProgramId backfill) ===")
    timers = get_existing_timers()
    if not timers:
        return

    for t in timers:
        if t.get("Status") != "New":
            continue  # never touch InProgress/Completed/Cancelled timers
        if t.get("ProgramId"):
            continue  # already linked, nothing to do
        tid = t.get("Id")
        cid = t.get("ChannelId")
        name = t.get("Name", "timer")
        if not tid or not cid:
            continue
        try:
            t_start = datetime.fromisoformat(str(t["StartDate"]).replace("Z", "+00:00"))
        except (KeyError, ValueError, TypeError, AttributeError):
            continue

        # Bug found by Agy's review, 2026-08-16: t_start includes this
        # timer's own pre-padding (typically -5 min). Feeding that straight
        # into containment matching (p_start <= target < p_end) can land
        # inside an EARLIER program's window -- e.g. a pregame show ending
        # right around the real game's start -- and match the wrong
        # program. Add the padding back so matching uses the real game
        # start, not the padded recording-window start.
        prepad = t.get("PrePaddingSeconds") or 0
        nominal_start = t_start + timedelta(seconds=prepad)

        program_id = find_matching_program_id(cid, nominal_start)
        if not program_id:
            continue  # still no EPG match yet -- try again next cycle

        # Second bug found by Agy's review: if CREATE succeeds below but the
        # DELETE of the original then fails, the original timer is left
        # behind still lacking ProgramId -- every subsequent 5-minute cycle
        # would find it again and create ANOTHER replacement, forever. This
        # dedup guard checks whether a timer already linked to this exact
        # ProgramId exists (i.e. a previous cycle's create already
        # succeeded, only the cleanup delete is outstanding) before
        # creating a new one -- in that case just retry the delete instead.
        already_recreated = next(
            (ot for ot in timers if ot.get("Id") != tid and ot.get("ProgramId") == program_id), None)

        logging.info("[RECATEGORIZE] EPG data now available for previously-uncategorized "
                     "timer '%s' -- ProgramId %s", name, program_id)
        if dry_run:
            action = "retry cancelling the original (a replacement already exists)" \
                if already_recreated else \
                "create a replacement timer with ProgramId, then cancel the original only if that succeeds"
            logging.info("  [DRY-RUN] Would %s", action)
            continue

        if not already_recreated:
            new_payload = dict(t)
            new_payload["ProgramId"] = program_id
            new_payload.pop("Id", None)          # let Jellyfin assign a fresh Id
            new_payload.pop("ExternalId", None)  # tuner-assigned, not ours to set

            create_res = jf_request("/emby/LiveTv/Timers", data=new_payload, method="POST")
            if create_res is None:
                logging.warning("  [SKIP] Could not create replacement timer for '%s' -- "
                                "original left untouched, will retry next cycle", name)
                continue

        # Retry the cleanup delete a few times before giving up -- a
        # transient failure here (vs. a hard, repeated one) shouldn't need
        # a full extra 5-minute cycle (and the dedup guard above) to clear.
        cancel_res = None
        for attempt in range(3):
            cancel_res = jf_request(f"/emby/LiveTv/Timers/{tid}", method="DELETE")
            if cancel_res is not None:
                break
            time.sleep(2)

        if cancel_res is not None:
            log_event("recategorized", tid, name, {"program_id": program_id}, dry_run=dry_run)
            logging.info("  [SUCCESS] Recreated '%s' with ProgramId %s, cancelled original", name, program_id)
        else:
            # Recreate succeeded (this cycle or a previous one) but
            # cancelling the old one still failed after retries -- TWO
            # timers now exist for the same game. Not a lost recording (the
            # worst-case outcome this function is designed to avoid), and
            # the dedup guard above prevents this from spiraling into more
            # than one duplicate -- but it does need a human or a future
            # cycle's retry to actually clean up. Log loudly rather than
            # silently leaving it.
            logging.error("  [PARTIAL] Replacement for '%s' exists but could not cancel "
                          "original timer %s after 3 attempts -- BOTH NOW EXIST, will retry "
                          "the cancel next cycle", name, tid)


def run_auto_scheduler(dry_run: bool = True, games: list[dict[str, Any]] | None = None) -> None:
    """Proactively schedule upcoming games, checking sports-config.json for per-team on/off state."""
    logging.info("=== Starting Sports DVR Auto-Scheduler ===")
    sports_config = load_sports_config()
    logging.info("Active sports recording state: %s", sports_config)

    if games is None:
        games = fetch_espn_schedule()
    jf_channels = get_jellyfin_channels()
    existing_timers = get_existing_timers()

    now = datetime.now(timezone.utc)
    lookahead = now + timedelta(days=7)

    upcoming = [g for g in games if now <= g["start"] <= lookahead]
    logging.info("Found %d upcoming games in the next 7 days.", len(upcoming))

    for game in upcoming:
        team = game["team"]

        if not sports_config.get(team, True):
            logging.info("Skip %s (%s): Auto-record toggled OFF in %s", game["name"], team, SPORTS_CONFIG_FILE)
            continue

        # Book the linear safety net first: the English PPV slot usually
        # can't resolve until hours before kickoff (and may never label at
        # all), so the fallback must not be gated behind that resolution
        # succeeding.
        if game["team"] in DYNAMIC_PPV_FALLBACK:
            if ensure_dynamic_ppv_fallback(game, jf_channels, existing_timers, dry_run=dry_run):
                existing_timers = get_existing_timers()

        cid, cname = resolve_channel_id(game, jf_channels)
        if not cid:
            logging.info("Skip %s (%s): %s", game["name"], game["team"], cname)
            continue

        if is_overlapping_timer(cid, game["start"], game["end"], existing_timers,
                                timer_name=f"{game['team']}: {game['name']}"):
            logging.info("Skip %s (%s): Overlapping timer already exists on %s", game["name"], game["team"], cname)
            continue

        schedule_game_timer(game, cid, cname, dry_run=dry_run)


def ensure_dynamic_ppv_fallback(game: dict[str, Any], jf_channels: dict[str, str],
                                 existing_timers: list[dict[str, Any]], dry_run: bool = True) -> bool:
    """Make sure a dynamic-PPV fixture has its linear-channel safety net
    booked. Idempotent: returns False (and creates nothing) if a live
    fallback timer for this match already exists."""
    team = game["team"]
    ch_name = DYNAMIC_PPV_FALLBACK.get(team)
    if not ch_name:
        return False
    cid = jf_channels.get(ch_name) or jf_channels.get(ch_name.lower())
    if not cid:
        logging.warning("[FALLBACK] %s not in the Jellyfin lineup -- cannot book a fallback for %s",
                        ch_name, game["name"])
        return False

    want = f"{team}: {game['name']} {PPV_FALLBACK_MARKER}"
    for t in existing_timers:
        if t.get("Name") == want and t.get("Status") not in ("Completed", "Cancelled", "Error"):
            return False

    logging.info("[FALLBACK] Booking linear safety net for %s on %s", game["name"], ch_name)
    ok = schedule_game_timer(game, cid, ch_name, dry_run=dry_run, name_suffix=PPV_FALLBACK_MARKER)
    log_event("ppv_fallback_scheduled", None, want, {
        "success": ok, "channel": ch_name, "game_start": game["start"].isoformat(),
    }, dry_run=dry_run)
    return ok


def _load_probe_state() -> dict[str, Any]:
    try:
        return json.loads(PPV_PROBE_STATE_FILE.read_text())
    except Exception:                                       # noqa: BLE001
        return {}


def _save_probe_state(state: dict[str, Any]) -> None:
    try:
        PPV_PROBE_STATE_FILE.parent.mkdir(parents=True, exist_ok=True)
        tmp = PPV_PROBE_STATE_FILE.with_suffix(".tmp")
        tmp.write_text(json.dumps(state, indent=2))
        tmp.replace(PPV_PROBE_STATE_FILE)
    except Exception as exc:                                # noqa: BLE001
        logging.error("Could not save PPV probe state: %s", exc)


# 2026-08-28: probe disabled for tonight's Bayern fixture. Set back to False to re-enable.
#
# Measured today: the provider allows ONE concurrent stream, and a second
# request PREEMPTS the first rather than being refused. Proven - stream 1 was
# flowing at 17.5MB, stream 2 started and took 8.7MB, stream 1 stalled dead at
# 20.1MB and never resumed.
#
# The probe starts an English PPV capture at kickoff-40min, while the German
# recording (running since 18:55) holds the only tuner - so it would kill the
# in-progress recording. The designed protection (cancel the fallback first)
# cannot fire: Jellyfin names the timer from the EPG programme ("Live: BL") and
# ignores a rename, so it matches neither base_name nor fb_name and
# PPV_FALLBACK_MARKER never appears in it.
#
# Trade: no English PPV option, guaranteed German recording.
PPV_PROBE_DISABLED = True


def run_ppv_probe_commit(dry_run: bool = True, games: list[dict[str, Any]] | None = None) -> None:
    if PPV_PROBE_DISABLED:
        logging.info("PPV probe disabled (PPV_PROBE_DISABLED=True) -- "
                     "single-tuner preemption would kill the in-progress recording")
        return

    """Prove the English PPV channel during pregame, then commit to it or
    put the German fallback back -- the owner's sequencing, 2026-08-25.

    Ordering is the whole safety story here, and it is deliberately the
    same create-before-cancel discipline check_uncategorized_timers uses:
    the English timer must EXIST before the German one is cancelled, so any
    failure leaves the guaranteed capture untouched. The reverse order
    would turn one bad API call into a missed match."""
    if games is None:
        games = fetch_espn_schedule()
    now = datetime.now(timezone.utc)
    candidates = [g for g in games
                  if g["team"] in DYNAMIC_PPV_TEAMS
                  and g["state"] not in ("post",)
                  and not g["completed"]
                  and timedelta(0) < (g["start"] - now) <= PPV_PROBE_LEAD]
    if not candidates:
        return

    logging.info("=== PPV probe/commit: %d fixture(s) inside the %d-min pregame window ===",
                 len(candidates), int(PPV_PROBE_LEAD.total_seconds() // 60))
    state = _load_probe_state()
    jf_channels = get_jellyfin_channels()
    changed = False

    for game in candidates:
        gid = str(game["id"])
        entry = state.get(gid, {})
        if entry.get("phase") in ("committed", "reverted"):
            continue
        timers = get_existing_timers()
        base_name = f"{game['team']}: {game['name']}"
        fb_name = f"{base_name} {PPV_FALLBACK_MARKER}"
        english = next((t for t in timers
                        if t.get("Name") == base_name
                        and t.get("Status") in ("New", "InProgress")), None)
        fallback = next((t for t in timers
                         if t.get("Name") == fb_name
                         and t.get("Status") in ("New", "InProgress")), None)
        mins_to_kick = (game["start"] - now).total_seconds() / 60

        # --- Phase 1: start the probe (which is simply the real English
        # recording, started early) ---
        if not entry.get("phase"):
            cid, why = resolve_dynamic_ppv_channel(game["team"], game, jf_channels)
            if not cid:
                logging.info("[PROBE] %s: no confident English slot yet (%s)", game["name"], why)
                continue
            if english:
                entry = {"phase": "probing", "started_at": now.isoformat(),
                         "english_timer": english.get("Id"), "channel": cid}
                state[gid] = entry; changed = True
            else:
                logging.info("[PROBE] %s: starting English recording NOW on %s to prove the "
                             "channel (%.0f min before kickoff).", game["name"], why, mins_to_kick)
                probe_game = dict(game)
                probe_game["start"] = now + timedelta(seconds=30)
                ok = schedule_game_timer(probe_game, cid, why, dry_run=dry_run)
                if not ok:
                    logging.error("[PROBE] %s: could not create the English timer -- leaving the "
                                  "German fallback exactly as it is.", game["name"])
                    continue
                created = next((t for t in get_existing_timers()
                                if t.get("Name") == base_name
                                and t.get("Status") in ("New", "InProgress")), None)
                if not created and not dry_run:
                    logging.error("[PROBE] %s: English timer not confirmed after create -- "
                                  "keeping the German fallback, will retry next cycle.", game["name"])
                    continue
                entry = {"phase": "probing", "started_at": now.isoformat(),
                         "english_timer": (created or {}).get("Id"), "channel": cid}
                state[gid] = entry; changed = True
                log_event("ppv_probe_started", (created or {}).get("Id"), base_name,
                          {"channel": why, "minutes_to_kickoff": round(mins_to_kick, 1)},
                          dry_run=dry_run)
            # Only now, with the English timer real, release the tuner.
            if fallback:
                logging.info("[PROBE] Releasing the single tuner: cancelling %r for the probe.", fb_name)
                cancel_live_timer(fallback["Id"], dry_run=dry_run)
                log_event("ppv_fallback_cancelled_for_probe", fallback.get("Id"), fb_name,
                          {"reason": "probe_started"}, dry_run=dry_run)
            continue

        # --- Phase 2: judge the probe ---
        if entry.get("phase") == "probing":
            try:
                started = datetime.fromisoformat(entry["started_at"])
            except (KeyError, ValueError):
                started = now
            elapsed = now - started
            path = (english or {}).get("RecordingPath") or resolve_active_recording_path(base_name)
            size = recording_file_size(path) if path else None

            if size is not None and size >= PPV_PROBE_MIN_BYTES:
                logging.info("[PROBE] %s: PROVEN -- English channel wrote %s bytes. Committing; "
                             "the German fallback stays cancelled.", game["name"], f"{size:,}")
                entry["phase"] = "committed"; entry["proved_bytes"] = size
                state[gid] = entry; changed = True
                log_event("ppv_probe_committed", entry.get("english_timer"), base_name,
                          {"bytes": size, "minutes_to_kickoff": round(mins_to_kick, 1)},
                          dry_run=dry_run)
                if not dry_run:
                    notify(f"DVR: English feed confirmed -- {game['name']}",
                           [f"The English PPV channel is confirmed recording ({size:,} bytes) "
                            f"{mins_to_kick:.0f} minutes before kickoff.",
                            "", "The German fallback has been released (only one stream is "
                                "available), and the English recording continues through the match."])
                continue

            if elapsed < PPV_PROBE_VERDICT_AFTER and mins_to_kick > PPV_PROBE_ABANDON_BY.total_seconds() / 60:
                logging.info("[PROBE] %s: %s bytes after %.0fs -- still giving it time.",
                             game["name"], "no" if size is None else f"{size:,}",
                             elapsed.total_seconds())
                continue

            # Verdict: the English slot did not deliver. Put the fallback back.
            logging.warning("[PROBE] %s: English channel did NOT deliver (%s bytes after %.0fs). "
                            "Reverting to the German feed.", game["name"],
                            "no" if size is None else f"{size:,}", elapsed.total_seconds())
            # Re-book the fallback BEFORE dropping the English timer. Found
            # by the scenario test: cancelling first and then failing to
            # re-book (e.g. the linear channel has dropped out of the
            # lineup) leaves the match with NO recording at all -- strictly
            # worse than the wrong-language recording this is meant to
            # restore. A useless English timer is still better than nothing,
            # so if the fallback cannot be created we keep it and retry.
            if not fallback:
                if not ensure_dynamic_ppv_fallback(game, jf_channels,
                                                    get_existing_timers(), dry_run=dry_run):
                    logging.error("[PROBE] %s: could not re-book the German fallback -- KEEPING "
                                  "the English timer rather than leaving the match unrecorded. "
                                  "Will retry next cycle.", game["name"])
                    log_event("ppv_probe_revert_blocked", entry.get("english_timer"), base_name,
                              {"reason": "fallback_unavailable"}, dry_run=dry_run)
                    if not dry_run:
                        notify(f"DVR: ACTION NEEDED -- cannot fall back for {game['name']}",
                               ["The English PPV slot produced no video, but the German fallback "
                                "channel could not be booked either (not in the Jellyfin lineup).",
                                "", "The English timer has been LEFT IN PLACE so something is "
                                "recording, but it may capture nothing. Worth checking the lineup "
                                "before kickoff."])
                    continue
            if english:
                cancel_live_timer(english["Id"], dry_run=dry_run)
            entry["phase"] = "reverted"; entry["reverted_at"] = now.isoformat()
            state[gid] = entry; changed = True
            log_event("ppv_probe_reverted", entry.get("english_timer"), base_name,
                      {"bytes": size, "elapsed_seconds": round(elapsed.total_seconds()),
                       "minutes_to_kickoff": round(mins_to_kick, 1)}, dry_run=dry_run)
            if not dry_run:
                notify(f"DVR: fell back to the German feed -- {game['name']}",
                       [f"The English PPV slot was labeled for this match but produced no video "
                        f"during a {elapsed.total_seconds():.0f}s pregame test, so it was dropped "
                        f"and the German-feed recording was restored with "
                        f"{mins_to_kick:.0f} minutes to spare.",
                        "", "The match will be captured with German commentary."])

    if changed:
        _save_probe_state(state)


def check_ppv_fallback_cancellation(dry_run: bool = True) -> None:
    """Drop a linear fallback timer once the English PPV recording for the
    same match is PROVEN to be capturing.

    Deliberately conservative, because a wrong cancel loses the match
    entirely while a late cancel only costs a duplicate recording. All four
    must hold before anything is cancelled: the sibling timer is
    Status=InProgress, it is on a curated PPV channel (not just any
    channel), its window actually overlaps the fallback's, and its file on
    disk has passed PPV_FALLBACK_MIN_BYTES. A timer that merely flipped to
    InProgress proves Jellyfin started, not that the provider is
    delivering -- which is exactly the failure mode the fallback exists
    for."""
    logging.info("=== Checking PPV fallback timers for cancellation ===")
    timers = get_existing_timers()
    if not timers:
        return
    fallbacks = [t for t in timers
                 if PPV_FALLBACK_MARKER in (t.get("Name") or "")
                 and t.get("Status") in ("New", "InProgress")]
    if not fallbacks:
        logging.info("No live PPV fallback timers to evaluate.")
        return

    jf_channels = get_jellyfin_channels()
    ppv_ids = {cid for name, cid in jf_channels.items() if is_ppv_channel_name(name)}
    logging.info("Evaluating %d fallback timer(s) against %d curated PPV channel(s): %s",
                 len(fallbacks), len(ppv_ids), [f.get("Name") for f in fallbacks])

    for fb in fallbacks:
        try:
            fb_start = datetime.fromisoformat(str(fb["StartDate"]).replace("Z", "+00:00"))
            fb_end = datetime.fromisoformat(str(fb["EndDate"]).replace("Z", "+00:00"))
        except (KeyError, ValueError):
            continue
        base = (fb.get("Name") or "").replace(PPV_FALLBACK_MARKER, "").strip()

        for t in timers:
            if t.get("Id") == fb.get("Id") or t.get("Status") != "InProgress":
                continue
            if PPV_FALLBACK_MARKER in (t.get("Name") or ""):
                continue
            t_cid = t.get("ChannelId") or t.get("ExternalChannelId")
            if t_cid not in ppv_ids:
                continue
            try:
                t_start = datetime.fromisoformat(str(t["StartDate"]).replace("Z", "+00:00"))
                t_end = datetime.fromisoformat(str(t["EndDate"]).replace("Z", "+00:00"))
            except (KeyError, ValueError):
                continue
            if not (t_start <= fb_end and t_end >= fb_start):
                continue

            path = t.get("RecordingPath") or resolve_active_recording_path(t.get("Name", ""))
            size = recording_file_size(path) if path else None
            if size is None or size < PPV_FALLBACK_MIN_BYTES:
                logging.info("[FALLBACK] English recording %r for %r not proven yet "
                             "(%s bytes so far) -- keeping the fallback.",
                             t.get("Name"), base,
                             "unknown" if size is None else f"{size:,}")
                continue

            logging.info("[FALLBACK] English PPV recording %r confirmed capturing (%s bytes). "
                         "Cancelling fallback %r.", t.get("Name"), f"{size:,}", fb.get("Name"))
            ok, msg = cancel_live_timer(fb["Id"], dry_run=dry_run)
            log_event("ppv_fallback_cancelled", fb.get("Id"), fb.get("Name", ""), {
                "success": ok, "detail": msg, "english_timer": t.get("Id"),
                "english_name": t.get("Name"), "english_bytes": size,
            }, dry_run=dry_run)
            if ok and not dry_run:
                notify(f"DVR: dropped German fallback -- {base}",
                       [f"The English PPV recording '{t.get('Name')}' is confirmed capturing "
                        f"({size:,} bytes), so the German-feed safety-net timer was cancelled.",
                        "", "Nothing else to do -- the English recording continues normally."])
            break


def candidate_channel_ids(game: dict[str, Any], jf_channels: dict[str, str]) -> set[str]:
    """Every Jellyfin channel ID this game could plausibly be recorded on.

    Added 2026-08-22 after the Packers@Broncos incident: run_live_extender
    used to match games to timers by TIME OVERLAP ALONE. On 8/21 the
    Braves@Brewers game went Final while its ESPN window still overlapped
    the Packers timer's window on the clock -- so every 5-minute cycle
    "trimmed" the live NFL recording to now+5min. Each trim killed the
    recording, the stall watchdog restored it, the fresh timer got trimmed
    again... 8 forced restarts in one night, and when a trim finally won the
    race against the extender (early 2nd quarter), the timer completed,
    fell out of the watchdog's InProgress filter, and the second half was
    never recorded. All 8 "stalls" that night were self-inflicted; Threadfin
    logged zero upstream errors. A timer must now be on a channel this game
    could actually air on before extend/trim will touch it."""
    ids: set[str] = set()
    team = game["team"]
    if team in DYNAMIC_PPV_TEAMS:
        # A dynamic-PPV game can be recording on any curated DAZN PPV slot
        # or (German-feed fallback) any Sky Bundesliga channel -- the
        # extender/watchdog must recognize its timers on all of them.
        for ch_name, cid in jf_channels.items():
            lname = ch_name.lower()
            if is_ppv_channel_name(ch_name) or "bundesliga" in lname:
                ids.add(cid)
        return ids
    if team in RSN_DEFAULTS:
        cid = jf_channels.get(RSN_DEFAULTS[team]) or jf_channels.get(RSN_DEFAULTS[team].lower())
        if cid:
            ids.add(cid)
    for bc in game["broadcasts"]:
        mapped = NETWORK_CHANNEL_MAP.get(bc)
        if mapped:
            cid = jf_channels.get(mapped) or jf_channels.get(mapped.lower())
            if cid:
                ids.add(cid)
        for ch_name, cid in jf_channels.items():
            if bc.lower() in ch_name.lower():
                ids.add(cid)
    return ids


def _timer_matches_game_identity(timer: dict[str, Any], game: dict[str, Any]) -> bool:
    """True only when the timer's own name positively identifies this game.

    Added 2026-08-24 (joint audit, finding F-01): candidate_channel_ids()
    alone still allows a cross-game trim war between two games that can air
    on the SAME channel -- e.g. back-to-back games on FOX, or an RSN
    doubleheader. The 2026-08-22 gate proved a timer is on a *plausible*
    channel for the game; it never proved the timer is *this game's* timer.
    Trims are destructive (they end a recording), so a trim now requires
    the timer's name to actually name this game: the team key (timer names
    from schedule_game_timer are '{team}: {espn short name}'), or at least
    two distinct word tokens from ESPN's own game name (covers EPG-titled
    timers like 'Milwaukee Brewers at Los Angeles Dodgers'). A generic
    EPG-titled timer ('Live: NFL Football') matches neither -- it simply
    never gets trimmed, and the worst case is recording the timer's normal
    post-padding. Losing a trim is minutes of extra footage; a wrong trim
    is the rest of the game, which is exactly what happened on 8/21."""
    tn = timer.get("Name", "").lower()
    if not tn:
        return False
    team = game.get("team", "").lower()
    if team and team.split()[0] in tn:
        return True
    tokens = {w.lower() for w in re.findall(r"[A-Za-z]{3,}", game.get("name", ""))}
    tokens -= {"live", "the", "and"}
    return sum(1 for w in tokens if w in tn) >= 2


def run_live_extender(dry_run: bool = True, games: list[dict[str, Any]] | None = None) -> None:
    """Check live games and auto-extend active Jellyfin timers."""
    logging.info("=== Starting Live Game Auto-Extender ===")
    if games is None:
        games = fetch_espn_schedule()
    timers = get_existing_timers()
    jf_channels = get_jellyfin_channels()
    now = datetime.now(timezone.utc)

    for game in games:
        if game["state"] not in ("in", "post") and not (game["start"] <= now <= game["end"] + timedelta(hours=2)):
            continue

        allowed_cids = candidate_channel_ids(game, jf_channels)

        for timer in timers:
            try:
                t_start = datetime.fromisoformat(timer["StartDate"].replace("Z", "+00:00"))
                t_end = datetime.fromisoformat(timer["EndDate"].replace("Z", "+00:00"))
            except (KeyError, ValueError):
                continue

            if not (t_start <= game["end"] and t_end >= game["start"]):
                continue

            # See candidate_channel_ids docstring (2026-08-22): time overlap
            # alone is NOT ownership. Only touch timers on a channel this
            # game could actually be airing on.
            t_cid = timer.get("ChannelId") or timer.get("ExternalChannelId")
            if t_cid not in allowed_cids:
                continue

            if game["state"] == "in" and not game["completed"]:
                time_left = (t_end - now).total_seconds() / 60
                if time_left < 15:
                    new_end = t_end + timedelta(minutes=20)
                    logging.info("Game '%s' is IN PROGRESS (%s). Timer has %.1f min left.",
                                 game["name"], game["status_detail"], time_left)
                    ok = extend_active_timer(timer, new_end, dry_run=dry_run)
                    log_event("extend", timer.get("Id"), game["name"], {
                        "success": ok, "game_status": game["status_detail"],
                        "old_end": timer["EndDate"], "new_end": new_end.isoformat(),
                        "minutes_left_before": round(time_left, 1),
                    }, dry_run=dry_run)

            elif game["state"] == "post" or game["completed"]:
                # Destructive action: see _timer_matches_game_identity.
                if not _timer_matches_game_identity(timer, game):
                    logging.info("Skip trim of timer '%s' for final game '%s': timer name does "
                                 "not positively identify this game (channel-plausible only).",
                                 timer.get("Name", "?"), game["name"])
                    continue
                # Doubleheader guard (same team, same channel, consecutive
                # games -- identity match alone can't tell them apart): only
                # trim a timer whose nominal start belongs to THIS game's
                # slot, or that started mid-window (a restore timer).
                prepad = timer.get("PrePaddingSeconds") or 0
                nominal_start = t_start + timedelta(seconds=prepad)
                in_window = game["start"] <= t_start <= game["end"]
                near_start = abs((nominal_start - game["start"]).total_seconds()) <= 5400
                if not (in_window or near_start):
                    logging.info("Skip trim of timer '%s' for final game '%s': timer start %s "
                                 "outside this game's slot (likely the next game on this channel).",
                                 timer.get("Name", "?"), game["name"], timer.get("StartDate"))
                    continue
                time_left = (t_end - now).total_seconds() / 60
                if time_left > 10:
                    new_end = now + timedelta(minutes=5)
                    logging.info("Game '%s' is FINAL (%s). Trimming remaining %.1f min timer.",
                                 game["name"], game["status_detail"], time_left)
                    ok = extend_active_timer(timer, new_end, dry_run=dry_run, post_padding_seconds=0)
                    log_event("trim", timer.get("Id"), game["name"], {
                        "success": ok, "game_status": game["status_detail"],
                        "old_end": timer["EndDate"], "new_end": new_end.isoformat(),
                        "minutes_trimmed": round(time_left, 1),
                    }, dry_run=dry_run)


def read_live_timers() -> list[dict[str, Any]] | None:
    """Jellyfin's own on-disk timers.json, straight off CT105."""
    try:
        raw = subprocess.run(
            ["/usr/sbin/pct", "exec", "105", "--", "cat", JELLYFIN_TIMERS_PATH],
            capture_output=True, text=True, timeout=20, check=True,
        ).stdout
        return json.loads(raw)
    except Exception as exc:                                 # noqa: BLE001
        logging.error("Could not read live timers.json for stall check: %s", exc)
        return None


def recording_file_size(recording_path: str) -> int | None:
    """Stat the actual .ts file on CT105's own filesystem."""
    if not recording_path.startswith("/media/recordings"):
        return None
    real_path = "/srv/media-core/media" + recording_path[len("/media"):]
    try:
        out = subprocess.run(
            ["/usr/sbin/pct", "exec", "105", "--", "stat", "-c", "%s", real_path],
            capture_output=True, text=True, timeout=15, check=True,
        ).stdout.strip()
        return int(out)
    except Exception:                                         # noqa: BLE001
        return None


def load_stall_state() -> dict[str, Any]:
    try:
        return json.loads(STALL_STATE_FILE.read_text())
    except Exception:                                         # noqa: BLE001
        return {}


def save_stall_state(state: dict[str, Any]) -> None:
    try:
        STALL_STATE_FILE.parent.mkdir(parents=True, exist_ok=True)
        tmp = STALL_STATE_FILE.with_suffix(".tmp")
        tmp.write_text(json.dumps(state, indent=2))
        tmp.replace(STALL_STATE_FILE)
    except Exception as exc:                                  # noqa: BLE001
        logging.error("Could not save stall-check state: %s", exc)


