#!/usr/bin/env python3
"""Automatic Sports-Game DVR Scheduler, Live-Aware Auto-Extender & Auto-Restore Stitcher (v3).

Key features:
1. Auto-schedules upcoming games for the 5 followed teams (Packers, Badgers FB/BB, Bucks, Brewers).
2. Respects shared per-team on/off state file at /var/lib/dvr-dashboard/sports-config.json.
3. Uses ESPN API to identify real broadcast networks and map them to local/RSN Jellyfin channels.
4. Sets realistic per-sport baseline durations (Baseball: 3h15m, Football: 3h45m, Basketball: 2h45m).
5. Safety net: checks existing timers to avoid duplicate recording schedules.
6. Live-aware auto-extension: polls ESPN live status near estimated end time and extends Jellyfin
   timer EndDate while game is 'in progress'. Trims timer when game becomes 'completed'.
7. Stalled-recording watchdog: detects stream drops mid-recording when file stops growing.
8. Auto-restore: on confirmed stall, automatically creates a continuation Jellyfin timer for the
   remainder of the scheduled event to recover from transient stream drops.
9. Auto-stitch: when restore timer completes, concatenates original and restored files into a
   single stitched file using jellyfin-ffmpeg concat demuxer without modifying or deleting originals.

Stdlib only -- no third party packages required.
"""
from __future__ import annotations

import argparse
import json
import logging
import re
import shlex
import socket
import subprocess
import sys
import time
import urllib.parse
import urllib.request
from datetime import datetime, timedelta, timezone
from pathlib import Path
from typing import Any
from zoneinfo import ZoneInfo

# Configuration & Constants
LOCAL_TZ = ZoneInfo("Europe/Berlin")
# Runs on the pve-01 HOST (see get_jf_token()/SPORTS_CONFIG_FILE below), so the
# LAN address is what actually resolves; 127.0.0.1 is kept as a harmless first
# try in case this is ever run from inside CT105 directly.
JF_URLS = ["http://192.168.9.50:8096", "http://127.0.0.1:8096"]
JF_KEY_FILES = [
    Path("/srv/media-core/.jellyfin_api_key"),
    Path("/config/.jellyfin_api_key"),
    Path("/var/lib/lxc/105/rootfs/srv/media-core/.jellyfin_api_key"),
]

# This is the pve-01 HOST path, and deliberately so: it is the exact same file
# dvr-dashboard's sports-config toggles read and write.
SPORTS_CONFIG_FILE = Path("/var/lib/dvr-dashboard/sports-config.json")

# Stalled-recording watchdog & auto-restore state files.
JELLYFIN_TIMERS_PATH = "/srv/media-core/jellyfin/config/data/livetv/timers.json"
STALL_STATE_FILE = Path("/var/lib/dvr-dashboard/recording-stall-state.json")
RESTORE_STATE_FILE = Path("/var/lib/dvr-dashboard/recording-restore-state.json")

# Added 2026-08-11 per owner request: an append-only, permanent record of every
# extend/trim/stall/restore/stitch decision these scripts make. STALL_STATE_FILE
# and RESTORE_STATE_FILE are *working* state -- both get pruned/deleted once a
# timer is no longer active (see check_stalled_recordings' `del state[tid]` for
# anything not in seen_ids), so neither one answers "did this fire, historically,
# for a game that's long since finished" -- the only prior way to answer that was
# grepping the systemd journal by hand, which is slow and rotates out eventually.
# This file is never pruned or rewritten, only appended to.
EVENT_LOG_FILE = Path("/var/lib/dvr-dashboard/dvr-automation-events.jsonl")

STALL_MIN_GROWTH_BYTES = 2_000_000
# Paired with sports-dvr-auto.timer's 5-min OnUnitActiveSec (2026-08-09, was 10min/8min).
# At a 10-min cadence this 8-min gap was inert -- elapsed-since-last-check was always
# ~10min anyway, well over any 8-min floor, so it never actually skipped an evaluation.
# Halving both together (rather than just the systemd cadence alone) is what actually
# cuts worst-case detection latency roughly in half, down to ~10min worst case / ~5min
# best case. Not free: a genuinely low-bitrate channel has less time to accumulate past
# STALL_MIN_GROWTH_BYTES in a shorter window, so false-positive risk creeps up slightly
# for any channel far slower than the ~30MB/min this was calibrated against -- untested
# at this specific interval for that case.
# Tightened 2026-08-24 from 4min to 80s, paired with the dedicated
# sports-dvr-stallwatch.timer (90s) added the same day. Detection latency
# drops from 4-9 min to roughly 90s-3min, which on a live game is the
# difference between losing a play and losing a drive.
#
# Why this is safe at a much shorter interval, with the real numbers this
# time (the old comment above admitted it was calibrated but untested):
# measured against this system's own recordings, a healthy stream writes
# ~600-750 KB/s (Packers@Steelers: 12.5 GB / 4h40m = 745 KB/s; the stitched
# NFL file: 617 KB/s). Independently, Agy measured 17-35 Mbps on other
# samples -- higher still. Even taking the LOWEST figure, 80 seconds of
# healthy recording is ~48 MB, so the unchanged 2 MB threshold is under 5%
# of expected throughput. A channel would have to collapse to a twentieth of
# normal bitrate to trip it.
#
# The remaining risk at a short interval is not a slow channel, it is a
# brief provider hiccup that would have self-healed -- and a false restore
# is expensive (it splits the recording and forces a stitch). That is what
# STALL_STRIKES_REQUIRED below is for: confirm, then act.
STALL_MIN_CHECK_GAP = timedelta(seconds=80)
# Consecutive stalled samples required before a restore is triggered. Two
# samples at an 80s floor means a stall must persist ~160s to be believed,
# while a one-off hiccup between samples costs nothing at all.
STALL_STRIKES_REQUIRED = 2
STALL_ALERT_COOLDOWN = timedelta(hours=3)  # don't re-mail every cycle for the same stall
MAILTO = "nathan.karras@gmail.com"

